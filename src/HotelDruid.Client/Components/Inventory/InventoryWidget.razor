@namespace HotelDruid.Client.Components.Inventory
@using HotelDruid.Client.Services
@inject IInventoryApiService InventoryApi
@inject IAssetApiService AssetApi
@inject IStringLocalizer<SharedResource> L

<div class="rpanels">
    <div class="rbox">
        <div class="rheader">@L["inventory.title", "Top Inventory"]</div>
        <div class="rcontent">
            @if (Loading)
            {
                <p>@L["common.loading", "Loading..."]</p>
            }
            else if (!Items.Any())
            {
                <p>@L["inventory.empty", "No inventory items"]</p>
            }
            else
            {
                <table class="t1"><thead><tr><th>@L["inventory.asset", "Asset"]</th><th>@L["inventory.quantityShort", "Qty"]</th></tr></thead><tbody>
                    @foreach (var i in Items.Take(5))
                    {
                        <tr><td>@AssetName(i.AssetId)</td><td>@i.Quantity</td></tr>
                    }
                </tbody></table>
            }
        </div>
    </div>
</div>

@code {
    private List<InventoryDto> Items = new();
    private List<AssetDto> knownAssets = new();
    private bool Loading = false;

    private string AssetName(string? assetId)
    {
        if (string.IsNullOrWhiteSpace(assetId))
            return L["inventory.none", "None"];
        var asset = knownAssets.FirstOrDefault(current => string.Equals(current.Id, assetId, StringComparison.OrdinalIgnoreCase));
        return string.IsNullOrWhiteSpace(asset?.Name) ? L["inventory.unknownAsset", "Unknown asset"] : asset.Name;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            Loading = true;
            knownAssets = await AssetApi.GetAssetsAsync() ?? new();
            Items = await InventoryApi.GetInventoryAsync();
        }
        catch { }
        finally { Loading = false; }
    }

}


