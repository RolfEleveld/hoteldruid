@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private bool identityIsFront;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<IdentityFrontStatus>("/api/system/identity-front");
            identityIsFront = status?.IsFront == true;
        }
        catch
        {
            identityIsFront = false;
        }
    }

    private Task HandleNavigate()
    {
        return OnNavigate.HasDelegate ? OnNavigate.InvokeAsync() : Task.CompletedTask;
    }

    private sealed class IdentityFrontStatus
    {
        public bool IsFront { get; set; }
    }
}

