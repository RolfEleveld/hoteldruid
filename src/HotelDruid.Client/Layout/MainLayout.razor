@inherits LayoutComponentBase
@implements IDisposable
@using System.Net.Http.Json
@using Microsoft.Extensions.Localization
@using HotelDruid.Client.Localization
@using HotelDruid.Client.Services
@inject IStringLocalizer<SharedResource> L
@inject HttpClient Http
@inject IDeskUserService DeskUser
@inject HotelClock Clock

<div class="page">
    <header class="app-header">
        <div class="app-header-bar px-4">
            <button type="button" class="app-nav-toggle" @onclick="ToggleNav" title="@L["Nav.Toggle", "Navigation menu"]" aria-label="@L["Nav.Toggle", "Navigation menu"]">
                <span class="hamburger-icon" aria-hidden="true"></span>
            </button>
            <a class="hotel-brand" href="/">@hotelName</a>
            <a class="desk-name" href="@NameHref" title="@NameTitle">@HeaderName()</a>
        </div>
    </header>

    <div class="app-drawer-backdrop @(isNavOpen ? "app-drawer-backdrop-visible" : string.Empty)" @onclick="CloseNav"></div>

    <aside class="app-drawer @(isNavOpen ? "app-drawer-open" : string.Empty)" @onclick:stopPropagation="true">
        <NavMenu OnNavigate="CloseNav" />
    </aside>

    <div class="page-body">
        <main>
            <article class="content px-4">
                @if (clockReady)
                {
                    @Body
                }
            </article>
            <footer class="global-footer px-4 d-flex flex-wrap gap-3 align-items-center">
                <span>@L["Dashboard.Version.Label"]: @GetBuildLabel()</span>
            </footer>
        </main>
    </div>
</div>

@code {
    private StatusDto? status;
    private string hotelName = "Welcome to HotelDruid";
    private bool isNavOpen;
    private bool identityIsFront;
    private bool clockReady;
    private string? accountUrl;

    protected override void OnInitialized()
    {
        DeskUser.Changed += OnDeskUserChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await Clock.EnsureAsync();
        clockReady = true;

        try
        {
            status = await Http.GetFromJsonAsync<StatusDto>("/api/status");
            await DeskUser.ApplyIdentityAsync(status?.Authenticated == true, status?.User);
        }
        catch
        {
            // Ignore footer status fetch failures.
        }

        try
        {
            var configuration = await Http.GetFromJsonAsync<SystemConfigurationDto>("/api/system/configuration");
            if (configuration?.Settings is not null
                && configuration.Settings.TryGetValue("HotelName", out var configuredHotelName)
                && !string.IsNullOrWhiteSpace(configuredHotelName))
            {
                hotelName = configuredHotelName;
            }
        }
        catch
        {
            // Keep default hotel name when configuration is unavailable.
        }

        try
        {
            var front = await Http.GetFromJsonAsync<IdentityFrontDto>("/api/system/identity-front");
            identityIsFront = front?.IsFront == true;
            accountUrl = string.IsNullOrWhiteSpace(front?.AccountUrl) ? null : front!.AccountUrl;
        }
        catch
        {
            identityIsFront = false;
            accountUrl = null;
        }
    }

    private void ToggleNav()
    {
        isNavOpen = !isNavOpen;
    }

    private Task CloseNav()
    {
        isNavOpen = false;
        return Task.CompletedTask;
    }

    private void OnDeskUserChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DeskUser.Changed -= OnDeskUserChanged;
    }

    private string HeaderName()
        => string.IsNullOrWhiteSpace(DeskUser.Name) ? L["profile.setName"] : DeskUser.Name!;

    private string NameHref
        => identityIsFront && accountUrl is not null ? accountUrl : "/profile";

    private string NameTitle
        => identityIsFront && accountUrl is not null
            ? L["profile.signInOut", "Sign out or sign in"]
            : string.IsNullOrWhiteSpace(DeskUser.Name)
                ? L["profile.setName"]
                : L["profile.workingAs", DeskUser.Name];

    private string GetBuildLabel()
    {
        var versionLabel = string.IsNullOrWhiteSpace(status?.VersionLabel)
            ? "HotelDruid 4.10.1. Blazor"
            : status!.VersionLabel!;

        var buildNumber = string.IsNullOrWhiteSpace(status?.BuildNumber)
            ? "4.10.1.local"
            : status!.BuildNumber!;

        return $"{versionLabel} (build {buildNumber})";
    }

    private sealed class StatusDto
    {
        public string? VersionLabel { get; set; }
        public string? BuildNumber { get; set; }
        public string? User { get; set; }
        public bool Authenticated { get; set; }
    }

    private sealed class SystemConfigurationDto
    {
        public Dictionary<string, string>? Settings { get; set; }
    }

    private sealed class IdentityFrontDto
    {
        public bool IsFront { get; set; }
        public string? AccountUrl { get; set; }
    }
}
