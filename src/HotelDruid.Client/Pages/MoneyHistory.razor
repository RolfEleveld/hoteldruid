@page "/money-history"
@using HotelDruid.Client.Services
@inject IMoneyHistoryApiService MoneyHistoryApi

@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["moneyHistory.title", "Money History"]</PageTitle>
<div class="container-fluid">
    <div class="row align-items-center mb-2 mt-2">
        <div class="col-auto"><h5 class="mb-0">Money History</h5></div>
        <div class="col-auto d-flex gap-1 align-items-center">
            <input class="form-control form-control-sm" type="date" @bind="rangeFrom" aria-label="@L["bookings.stayFrom"]" />
            <input class="form-control form-control-sm" type="date" @bind="rangeTo" aria-label="@L["bookings.stayTo"]" />
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAll">@L["common.load", "Load"]</button>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 border-end">
            <button class="btn btn-sm btn-primary mb-2" @onclick="NewRecord">+ New Entry</button>
            @if (records is null) { <p><em>@L["common.loading", "Loading..."]</em></p> }
            else if (records.Count == 0) { <p class="text-muted">No money history</p> }
            else
            {
                <ul class="list-group">
                    @foreach (var r in records)
                    {
                        <li class="list-group-item list-group-item-action @(selected?.Id == r.Id ? "active" : "")"
                            style="cursor:pointer" @onclick="() => SelectRecord(r)">
                            <div class="fw-bold">@r.Date · @L["accounting.countsToward"] @r.Year</div>
                            <small>@r.Type: @r.Amount (@r.Description)@(string.IsNullOrWhiteSpace(r.Person) ? "" : $" · {r.Person}")</small>
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="col-md-6 border-end">
            @if (editing)
            {
                <h5 class="mt-1">New Money History Entry</h5>
                <div class="row g-2">
                    <div class="col-6"><label>Cash Register ID</label><input class="form-control" @bind="form.CashRegisterId" /></div>
                    <div class="col-6"><label>Amount</label><input class="form-control" type="number" @bind="form.Amount" /></div>
                    <div class="col-6"><label>Type</label><input class="form-control" @bind="form.Type" /></div>
                    <div class="col-6"><label>@L["accounting.cashDate"]</label><input class="form-control" type="date" @bind="form.CashDate" @bind:after="OnCashDateChanged" /></div>
                    <div class="col-6">
                        <label>@L["accounting.countsToward"]</label>
                        <input class="form-control" type="number" @bind="form.Year" @bind:after="OnCountsTowardChanged" />
                    </div>
                    <div class="col-12"><div class="form-text">@L["accounting.countsTowardHelp"]</div></div>
                    <div class="col-12"><label>Description</label><input class="form-control" @bind="form.Description" /></div>
                </div>
                @if (!string.IsNullOrEmpty(errorMsg)) { <div class="alert alert-danger mt-2">@errorMsg</div> }
                <div class="mt-3">
                    <button class="btn btn-primary me-2" @onclick="Save">@L["common.save", "Save"]</button>
                    <button class="btn btn-secondary" @onclick="Cancel">@L["common.cancel", "Cancel"]</button>
                </div>
            }
        </div>
        <div class="col-md-3">
            @if (selected is not null && !editing)
            {
                <h5 class="mt-1">@L["common.details", "Details"]</h5>
                <dl>
                    <dt>@L["accounting.cashDate"]</dt><dd>@selected.Date</dd>
                    <dt>@L["accounting.countsToward"]</dt><dd>@selected.Year</dd>
                    <dt>Cash Register</dt><dd>@selected.CashRegisterId</dd>
                    <dt>Amount</dt><dd>@selected.Amount</dd>
                    <dt>Type</dt><dd>@selected.Type</dd>
                    <dt>Description</dt><dd>@selected.Description</dd>
                    <dt>Person</dt><dd>@(selected.Person ?? "—")</dd>
                    <dt>Payment method</dt><dd>@(selected.PaymentMethod ?? "—")</dd>
                    <dt>Currency</dt><dd>@(selected.Currency ?? "—")</dd>
                    <dt>Running cash total</dt><dd>@(selected.RunningCashTotal?.ToString("0.00") ?? "—")</dd>
                </dl>
                @if (!string.IsNullOrEmpty(errorMsg)) { <div class="alert alert-danger">@errorMsg</div> }
                @if (string.Equals(selected.Type, "register", StringComparison.OrdinalIgnoreCase))
                {
                    <p class="text-muted">Cash-register copy of a booking payment.</p>
                }
                else if (!string.IsNullOrWhiteSpace(selected.ReversedById))
                {
                    <p class="text-muted">Reversed</p>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick="ReverseSelected">Reverse</button>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<MoneyHistoryClientDto>? records;
    private MoneyHistoryClientDto? selected;
    private bool editing;
    private string errorMsg = "";
    private bool countsTowardFollowsDate = true;
    private DateOnly rangeFrom = new(HotelClock.BusinessToday.Year, 1, 1);
    private DateOnly rangeTo = new(HotelClock.BusinessToday.Year, 12, 31);
    private FormModel form = new();

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll()
    {
        if (rangeTo < rangeFrom)
        {
            rangeTo = rangeFrom;
        }

        var combined = new List<MoneyHistoryClientDto>();
        for (var year = rangeFrom.Year; year <= rangeTo.Year; year++)
        {
            combined.AddRange(await MoneyHistoryApi.ListAsync(year));
        }

        records = combined
            .GroupBy(item => item.Id ?? string.Empty, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .ToList();
    }

    private void NewRecord()
    {
        countsTowardFollowsDate = true;
        form = new()
        {
            CashDate = HotelClock.BusinessToday,
            Year = HotelClock.BusinessToday.Year
        };
        editing = true;
        selected = null;
        errorMsg = "";
    }

    private void SelectRecord(MoneyHistoryClientDto r) { selected = r; editing = false; }

    private void OnCashDateChanged()
    {
        if (countsTowardFollowsDate && form.CashDate is DateOnly date)
        {
            form.Year = date.Year;
        }
    }

    private void OnCountsTowardChanged() => countsTowardFollowsDate = false;

    private async Task Save()
    {
        if (form.Year == 0) { errorMsg = "Counts toward is required."; return; }
        var dto = new MoneyHistoryClientDto(null, form.Year, form.CashRegisterId, form.Amount, form.Type, form.Description, form.CashDate?.ToString("yyyy-MM-dd"));
        try
        {
            await MoneyHistoryApi.CreateAsync(dto);
            editing = false;
            await LoadAll();
        }
        catch { errorMsg = "Save failed."; }
    }

    private void Cancel() { editing = false; errorMsg = ""; }

    private async Task ReverseSelected()
    {
        if (selected?.Id is null) return;
        try
        {
            await MoneyHistoryApi.ReverseAsync(selected.Year, selected.Id);
            selected = null;
            await LoadAll();
        }
        catch { errorMsg = "Reverse failed."; }
    }

    private class FormModel
    {
        public int Year { get; set; }
        public string? CashRegisterId { get; set; }
        public double? Amount { get; set; }
        public string? Type { get; set; }
        public DateOnly? CashDate { get; set; }
        public string? Description { get; set; }
    }
}


