@page "/setup"
@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@using HotelDruid.Client.Services
@using HotelDruid.Shared
@using HotelDruid.Shared.Configuration
@inject HttpClient Http

@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Setup.PageTitle"]</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h1 class="h3 mb-3">@L["Setup.Header"]</h1>
                    <p class="text-muted">
                        @L["Setup.DescriptionPrefix"] <strong>/setup?configure=true</strong>@L["Setup.DescriptionSuffix"]
                    </p>

                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <div class="alert alert-success">@message</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(error))
                    {
                        <div class="alert alert-danger">@error</div>
                    }

                    <div class="mb-3">
                        <label class="form-label">@L["Setup.HotelName.Label"]</label>
                        <input class="form-control" @bind="hotelName" placeholder="@L["Setup.HotelName.Placeholder"]" />
                        <div class="form-text">@L["Setup.HotelName.Help"]</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L["Setup.SystemCurrency.Label"]</label>
                        <input class="form-control" @bind="model.DefaultCurrency" placeholder="@L["Setup.SystemCurrency.Placeholder"]" />
                        <div class="form-text">@L["Setup.SystemCurrency.Help"]</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L["Setup.Accounting.Label"]</label>
                        <select class="form-select" @bind="accountingStandard">
                            @foreach (var standard in AccountChart.Standards)
                            {
                                <option value="@standard.Id">@StandardLabel(standard)</option>
                            }
                        </select>
                        <div class="form-text">@L["Setup.Accounting.Help"]</div>
                    </div>

                    <div class="mb-3">
                        <div class="form-label">@L["Setup.Accounting.Numbers"]</div>
                        @if (CustomChart)
                        {
                            @foreach (var row in accountRows)
                            {
                                <div class="row g-2 align-items-center mb-2">
                                    <label class="col-sm-5 col-form-label">@RoleLabel(row.Role)</label>
                                    <div class="col-sm-7">
                                        <input class="form-control" @bind="row.Code" />
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <ul class="mb-0">
                                @foreach (var account in FixedAccounts)
                                {
                                    <li>@RoleLabel(account.Role): @account.Code</li>
                                }
                            </ul>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L["setup.registration", "Guest registration"]</label>
                        <select class="form-select" @bind="model.RegistrationStandard">
                            @foreach (var standard in GuestRegistration.Standards)
                            {
                                <option value="@standard.Id">@standard.Name</option>
                            }
                        </select>
                        <div class="form-text">@L["setup.registrationHelp", "This chooses how many named guests a room must have, and which fields the night audit checks."]</div>
                    </div>

                    <div class="mb-3 form-check">
                        <input class="form-check-input" type="checkbox" id="messageAutomation" @bind="model.MessageAutomation" />
                        <label class="form-check-label" for="messageAutomation">@L["setup.messageAutomation", "Process structured inbox messages automatically"]</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L["Setup.Storage.Label"]</label>
                        <input class="form-control" value="@storageInfo?.DataRoot" readonly />
                        <div class="form-text">
                            @L["Setup.Storage.SourcePrefix"] <strong>@(storageInfo?.Source ?? L["Setup.Storage.Source.Unknown"])</strong>.
                            @L["Setup.Storage.HelpPrefix"]
                            <code>HOTELDRUID_DATAROOT</code> @L["Setup.Storage.HelpMiddle"] <code>DataRoot</code> @L["Setup.Storage.HelpSuffix"]
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" @onclick="SaveAsync">@L["Setup.Button.Save"]</button>
                        <a class="btn btn-outline-secondary" href="/">@L["Setup.Button.BackHome"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private sealed class StorageInfoResponse
    {
        public string DataRoot { get; set; } = string.Empty;
        public string Source { get; set; } = string.Empty;
        public string EnvironmentVariable { get; set; } = string.Empty;
        public string ConfigurationKey { get; set; } = string.Empty;
    }

    private sealed class CodeRow
    {
        public CodeRow(string role, string code)
        {
            Role = role;
            Code = code;
        }

        public string Role { get; }
        public string Code { get; set; }
    }

    private SystemConfiguration model = new() { Id = "system", DefaultCurrency = "EUR", DefaultYear = DateTime.UtcNow.Year };
    private string hotelName = "Welcome to HotelDruid";
    private string accountingStandard = AccountChart.UsaliId;
    private readonly List<CodeRow> accountRows = AccountRoles.All
        .Select(role => new CodeRow(role, AccountChart.Usali.Codes[role]))
        .ToList();
    private bool CustomChart => string.Equals(accountingStandard, AccountChart.CustomId, StringComparison.OrdinalIgnoreCase);
    private IReadOnlyList<ChartAccountDto> FixedAccounts =>
        AccountChart.TryResolve(accountingStandard, null, out var chart, out _)
            ? chart.Accounts
            : AccountChart.Usali.Accounts;
    private StorageInfoResponse? storageInfo;
    private string? message;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            storageInfo = await Http.GetFromJsonAsync<StorageInfoResponse>("/api/system/storage");

            var existing = await Http.GetFromJsonAsync<SystemConfiguration>("/api/system/configuration");
            if (existing is not null)
            {
                model = existing;
                if (existing.Settings is not null
                    && existing.Settings.TryGetValue("HotelName", out var configuredHotelName)
                    && !string.IsNullOrWhiteSpace(configuredHotelName))
                {
                    hotelName = configuredHotelName;
                }

                if (!string.IsNullOrWhiteSpace(existing.AccountingStandard)
                    && AccountChart.Standards.Any(item => string.Equals(item.Id, existing.AccountingStandard, StringComparison.OrdinalIgnoreCase)))
                {
                    accountingStandard = existing.AccountingStandard;
                }

                if (existing.AccountCodes is not null)
                {
                    foreach (var row in accountRows)
                    {
                        if (existing.AccountCodes.TryGetValue(row.Role, out var code) && !string.IsNullOrWhiteSpace(code))
                            row.Code = code;
                    }
                }
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            // First-time setup without existing configuration.
        }

        model.RegistrationStandard ??= GuestRegistration.NoneId;
    }

    private async Task SaveAsync()
    {
        error = null;
        message = null;

        model.Id = "system";
        model.UpdatedUtc = DateTime.UtcNow;
        model.Settings ??= new Dictionary<string, string>();
        model.Settings["HotelName"] = string.IsNullOrWhiteSpace(hotelName) ? "Welcome to HotelDruid" : hotelName.Trim();
        model.Settings["PriceFallback"] = "NoSuggestion";

        var codes = accountRows.ToDictionary(row => row.Role, row => row.Code);
        if (!AccountChart.TryResolve(accountingStandard, codes, out var chart, out var chartError))
        {
            error = ChartError(chartError);
            return;
        }

        model.AccountingStandard = chart.StandardId;
        model.AccountCodes = new Dictionary<string, string>(chart.Codes);

        var response = await Http.PutAsJsonAsync("/api/system/configuration", model);
        if (!response.IsSuccessStatusCode)
        {
            error = L["Setup.Error.SaveFailed"];
            return;
        }

        message = L["Setup.Message.SaveSuccess"];
    }

    private string StandardLabel(AccountStandard standard)
    {
        var localized = L[$"chart.standard.{standard.Id}"];
        return localized.ResourceNotFound ? standard.Name : localized.Value;
    }

    private string RoleLabel(string role)
    {
        var localized = L[$"chart.role.{role}"];
        return localized.ResourceNotFound ? role : localized.Value;
    }

    private string ChartError(string? code) => code switch
    {
        "duplicate-code" => L["Setup.Accounting.DuplicateCode"],
        "invalid-code" => L["Setup.Accounting.InvalidCode"],
        "unknown-standard" => L["Setup.Accounting.UnknownStandard"],
        _ => L["Setup.Accounting.MissingCode"]
    };

}

