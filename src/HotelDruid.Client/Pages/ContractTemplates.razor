@page "/contract-templates"
@using HotelDruid.Client.Services
@inject IContractTemplateApiService ContractTemplateApi
@inject HttpClient Http
@inject IJSRuntime JS

@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["contractTemplates.title", "Contract Templates"]</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@L["contractTemplates.title", "Contract Templates"]</h5>
                    <button class="btn btn-success btn-sm w-100 mb-2" @onclick="AddNew"><span class="bi bi-plus"></span> Add Template</button>
                    @if (items == null)
                    {
                        <div>@L["common.loading", "Loading..."]</div>
                    }
                    else if (items.Count == 0)
                    {
                        <div class="alert alert-info">@L["contractTemplates.emptyList", "No contract templates yet."]</div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var item in items)
                            {
                                <a class="list-group-item list-group-item-action @(selected?.Id == item.Id ? "active" : "")" @onclick="() => Select(item)">
                                    @item.Type / #@item.Number
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@L["contractTemplates.title", "Contract Templates"]</h5>
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <input class="form-control" @bind="editType" placeholder="check-in" />
                        <div class="form-text">@L["contractTemplates.checkIn", "Type check-in is queued when the guest is marked arrived. The wording stays editable."]</div>
                    </div>
                    <div class="mb-3 form-check">
                        <input class="form-check-input" type="checkbox" id="deliverOnCheckIn" @bind="editDeliverOnCheckIn" />
                        <label class="form-check-label" for="deliverOnCheckIn">@L["contractTemplates.deliverOnCheckIn", "Queue this letter when the guest is marked arrived"]</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["contractTemplates.fields", "Value fields"]</label>
                        <p class="text-muted small">@L["contractTemplates.fieldsHelp", "The wording of the letter is yours. Place a field where a value from the hotel should appear."]</p>
                        <div>
                            @foreach (var field in ValueFields)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm me-1 mb-1" @onclick="() => InsertField(field)">@field</button>
                            }
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Content</label>
                        <textarea @ref="contentBox" class="form-control font-monospace" rows="18" @bind="editContent" @bind:event="oninput"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" @onclick="Save">@L["common.save", "Save"]</button>
                        @if (selected != null)
                        {
                            <button class="btn btn-danger" @onclick="Delete">@L["common.delete", "Delete"]</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@L["contractTemplates.title", "Contract Templates"]</h5>
                    @if (selected != null)
                    {
                        <dl class="row">
                            <dt class="col-4">ID</dt><dd class="col-8">@selected.Id</dd>
                            <dt class="col-4">Type</dt><dd class="col-8">@selected.Type</dd>
                            <dt class="col-4">Number</dt><dd class="col-8">@selected.Number</dd>
                        </dl>
                    }
                    else
                    {
                        <div class="text-muted">Select a template to view details</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ContractTemplateApiDto>? items;
    private ContractTemplateApiDto? selected;
    private string editType = string.Empty;
    private string editContent = string.Empty;
    private bool editDeliverOnCheckIn;
    private ElementReference contentBox;

    private static readonly string[] ValueFields =
    [
        "Hotel.Name", "Hotel.Address", "Hotel.City", "Hotel.Phone", "Hotel.Email", "Hotel.VatNumber",
        "Client.FullName", "Client.Street", "Client.StreetNumber", "Client.PostalCode", "Client.City", "Client.Nation", "Client.TaxCode", "Client.VatNumber",
        "Booking.Reference", "Booking.ArrivalDate", "Booking.DepartureDate", "Booking.Nights", "Room.Name", "Document.Today",
        "Invoice.TotalAmount", "Invoice.Currency", "Invoice.PaymentsTotal", "Invoice.RefundsTotal", "Invoice.DepositsHeld", "Invoice.TotalDue",
        "Tax.Notice", "Tax.NoticeDe"
    ];

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        items = await ContractTemplateApi.GetContractTemplatesAsync();
        StateHasChanged();
    }

    private void Select(ContractTemplateApiDto item)
    {
        selected = item;
        editType = item.Type ?? string.Empty;
        editContent = item.Content ?? string.Empty;
        editDeliverOnCheckIn = item.DeliverOnCheckIn;
    }

    private void AddNew()
    {
        selected = null;
        editType = string.Empty;
        editContent = string.Empty;
        editDeliverOnCheckIn = false;
    }

    private async Task InsertField(string field)
    {
        editContent = await JS.InvokeAsync<string>("hotelDruidTemplate.insertAtCursor", contentBox, "{{" + field + "}}");
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(editType) || string.IsNullOrWhiteSpace(editContent)) return;
        if (selected == null)
        {
            await ContractTemplateApi.CreateContractTemplateAsync(new ContractTemplateApiDto(null, editType, 0, editContent, editDeliverOnCheckIn));
        }
        else
        {
            await ContractTemplateApi.UpdateContractTemplateAsync(selected.Type!, selected.Number, new ContractTemplateApiDto(selected.Id, editType, selected.Number, editContent, editDeliverOnCheckIn));
        }
        await Load();
    }

    private async Task Delete()
    {
        if (selected == null) return;
        await ContractTemplateApi.DeleteContractTemplateAsync(selected.Type!, selected.Number);
        selected = null;
        await Load();
    }
}


