    private IEnumerable<(string Label, string Value)> GetPreviewDetails(ClientDto client)
    {
        var details = new List<(string Label, string Value)>();
        AddPreviewDetail(details, L["clients.languageLabel", "Language"], GetLanguageLabel(client.Language));
        AddPreviewDetail(details, L["clients.genderLabel", "Gender"], GetGenderLabel(client.Gender));
        AddPreviewDetail(details, L["clients.nationalityLabel", "Nationality"], client.Nationality);
        AddPreviewDetail(details, L["clients.dateOfBirthLabel", "Date of Birth"], DisplayDate(client.DateOfBirth));
        AddPreviewDetail(details, L["clients.phoneLabel", "Phone"], client.Phone);
        AddPreviewDetail(details, L["clients.phone2Label", "Phone 2"], client.Phone2);
        AddPreviewDetail(details, L["clients.phone3Label", "Phone 3"], client.Phone3);
        AddPreviewDetail(details, L["clients.emailLabel", "Email"], client.Email);
        AddPreviewDetail(details, L["clients.email3Label", "Certified Email / Destination Code"], client.Email3);
        AddPreviewDetail(details, L["clients.cityLabel", "City"], client.City);
        AddPreviewDetail(details, L["clients.nationLabel", "Nation"], client.Nation);
        AddPreviewDetail(details, L["clients.documentTypeLabel", "Document Type"], client.DocumentType);
        AddPreviewDetail(details, L["clients.documentNumberLabel", "Document Number"], client.DocumentNumber);
        AddPreviewDetail(details, L["clients.documentExpiryLabel", "Document Expiry"], DisplayDate(client.DocumentExpiry));
        AddPreviewDetail(details, L["clients.taxCodeLabel", "Tax Code"], client.TaxCode);
        AddPreviewDetail(details, L["clients.vatNumberLabel", "VAT Number"], client.VatNumber);
        return details;
    }

    private static void AddPreviewDetail(List<(string Label, string Value)> details, string label, string? value)
    {
        if (!string.IsNullOrWhiteSpace(value) && value.Trim() != "-")
        {
            details.Add((label, value.Trim()));
        }
    }

    private string? GetGenderLabel(string? gender)
    {
        if (string.IsNullOrWhiteSpace(gender))
        {
            return null;
        }

        var canonical = HotelDruid.Shared.ClientFieldMappings.GetCanonicalGender(gender);
        if (!string.IsNullOrWhiteSpace(canonical))
        {
            var option = GenderOptions.First(option => string.Equals(option.Value, canonical, StringComparison.OrdinalIgnoreCase));
            return L[option.ResourceKey].Value;
        }

        return gender.Trim();
    }

    private string? GetLanguageLabel(string? language)
    {
        if (string.IsNullOrWhiteSpace(language))
        {
            return null;
        }

        var canonical = HotelDruid.Shared.ClientFieldMappings.GetCanonicalLanguage(language);
        if (!string.IsNullOrWhiteSpace(canonical))
        {
            var option = SupportedLanguages.First(option => string.Equals(option.Value, canonical, StringComparison.OrdinalIgnoreCase));
            return L[option.ResourceKey].Value;
        }

        return language.Trim();
    }

    private static bool IsValidLanguage(string? language)
        => !string.IsNullOrWhiteSpace(language) && SupportedLanguages.Any(x => string.Equals(x.Value, language, StringComparison.OrdinalIgnoreCase));

    private static string? NormalizeName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return name?.Trim();
        var trimmed = name.Trim().ToLowerInvariant();
        return System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(trimmed);
    }

    private static string? NormalizeEmail(string? value)
    {
        var trimmed = value?.Trim();
        return string.IsNullOrWhiteSpace(trimmed) ? null : trimmed;
    }

    private static bool IsValidEmail(string? email)
    {
        if (string.IsNullOrWhiteSpace(email)) return false;
        try
        {
            _ = new MailAddress(email.Trim());
            return true;
        }
        catch
        {
            return false;
        }
    }

    private static string? NormalizePhoneNumber(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return null;
        var trimmed = phone.Trim();
        if (string.Equals(trimmed, PhoneExampleNumber, StringComparison.Ordinal))
        {
            return null;
        }

        var cleaned = new string(trimmed.Where(c => char.IsDigit(c) || c == '+').ToArray());
        if (cleaned.StartsWith("+") && Regex.IsMatch(cleaned, @"^\+[1-9][0-9]{1,14}$"))
        {
            return cleaned;
        }

        return trimmed;
    }

    private static bool IsValidPhoneNumber(string? phone)
        => !string.IsNullOrWhiteSpace(phone) && Regex.IsMatch(phone.Trim(), "^\\+[1-9][0-9]{1,14}$");

    private static string? NormalizeVatNumber(string? vatNumber)
        => string.IsNullOrWhiteSpace(vatNumber) ? null : new string(vatNumber.Where(char.IsLetterOrDigit).ToArray()).ToUpperInvariant();

    private static bool IsValidEuropeanVatNumber(string? vatNumber)
        => !string.IsNullOrWhiteSpace(vatNumber) && Regex.IsMatch(vatNumber.Trim(), "^[A-Z]{2}[A-Z0-9]{8,12}$");

    public ValueTask DisposeAsync()
    {
        autoSaveTimer?.Dispose();
        return ValueTask.CompletedTask;
    }

