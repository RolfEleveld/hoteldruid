    private void AddPhone()
    {
        if (editModel is null || editModel.Phones.Count >= 3)
        {
            return;
        }

        editModel.Phones.Add(string.Empty);
        hasUnsavedChanges = true;
    }

    private void RemovePhone(int index)
    {
        if (editModel is null || index < 0 || index >= editModel.Phones.Count)
        {
            return;
        }

        editModel.Phones.RemoveAt(index);
        for (var i = 0; i < 3; i++)
        {
            fieldWarnings.Remove(GetPhoneFieldName(i));
        }
        hasUnsavedChanges = true;
    }

