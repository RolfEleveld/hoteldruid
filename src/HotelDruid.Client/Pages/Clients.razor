@page "/clients"
@page "/clients/new"
@using HotelDruid.Client.Services
@using BookingDto = HotelDruid.Shared.BookingDto
@using Microsoft.AspNetCore.Components
@using System.Net.Mail
@using System.Text.RegularExpressions
@inject IClientApiService ClientApi
@inject IBookingApiService BookingApi
@inject IRoomApiService RoomApi
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

<PageTitle>@L["clients.title", "Clients"]</PageTitle>

<div class="container-fluid clients-manager">
    <div class="row g-3 h-100">
        <div class="col-md-3">
            <div class="panel panel-default h-100 d-flex flex-column">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["clients.title", "Clients"]</h3>
                </div>
                <div class="panel-body flex-grow-1 overflow-auto">
                    <button class="btn btn-success btn-sm w-100 mb-3" @onclick="AddNewClient">@L["clients.add", "Add Client"]</button>

                    <div class="mb-3">
                        <label class="form-label">@L["clients.searchLabel", "Find client"]</label>
                        <input type="text" class="form-control" @bind="filterText" @bind:event="oninput" placeholder="@L["clients.searchPlaceholder", "Search by name, email, phone, or city"]" />
                    </div>

                    @if (clients is null)
                    {
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">@L["common.loading", "Loading..."]</span>
                        </div>
                    }
                    else if (FilteredClients.Count == 0)
                    {
                        <div class="alert alert-info">@L["clients.emptyList", "No clients registered"]</div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var client in FilteredClients)
                            {
                                <button type="button" class="list-group-item list-group-item-action @(selectedClient?.Id == client.Id ? "active" : string.Empty)" @onclick="() => SelectClientAsync(client)">
                                    <div class="fw-semibold">@GetDisplayName(client)</div>
                                    <small class="text-muted">@GetListMeta(client)</small>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-5">
            @if (editModel is not null)
            {
                <div class="panel panel-default h-100 d-flex flex-column">
                    <div class="panel-heading">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h3 class="panel-title mb-0">@(string.IsNullOrWhiteSpace(editModel.Id) ? L["clients.newClient", "New Client"] : GetDisplayName(editModel))</h3>
                                <small class="text-muted">@L["clients.manageClient", "Manage guest profile details"]</small>
                            </div>
                            <div class="status-badge">
                                @if (isSaving)
                                {
                                    <span class="badge bg-warning">@L["common.saving", "Saving..."]</span>
                                }
                                else if (!string.IsNullOrEmpty(lastError))
                                {
                                    <span class="badge bg-danger">@L["common.error", "Error"]</span>
                                }
                                else if (isSaved)
                                {
                                    <span class="badge bg-success">@L["common.saved", "Saved"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">@L["common.unsaved", "Unsaved changes"]</span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(lastError))
                        {
                            <div class="alert alert-danger alert-sm mt-2 mb-0">@lastError</div>
                        }
                    </div>

                    <div class="panel-body flex-grow-1 overflow-auto">
                        <form @oninput="OnEditorChanged" @onchange="OnEditorChanged">
                            <section class="client-section client-section-personal">
                                <h4 class="client-section-title">@L["clients.section.personal", "Personal Data"]</h4>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label class="form-label">@L["clients.titleLabel", "Title"]</label>
                                        <select class="form-select" @bind="editModel.Title">
                                            <option value="">@L["clients.titleSelectPlaceholder", "Select title"]</option>
                                            @foreach (var option in TitleOptions)
                                            {
                                                <option value="@option">@option</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4"><label class="form-label">@L["clients.lastNameLabel", "Last Name"] <span class="text-danger">*</span></label><input type="text" class="form-control" @bind="editModel.LastName" @bind:event="oninput" /></div>
                                    <div class="col-md-4"><label class="form-label">@L["clients.firstNameLabel", "First Name"]</label><input type="text" class="form-control" @bind="editModel.FirstName" @bind:event="oninput" /></div>
                                    <div class="col-md-4"><label class="form-label">@L["clients.nicknameLabel", "Nickname"]</label><input type="text" class="form-control" @bind="editModel.Nickname" @bind:event="oninput" /></div>
                                    <div class="col-md-4">
                                        <label class="form-label">@L["clients.genderLabel", "Gender"]</label>
                                        <select class="form-select" @bind="editModel.Gender">
                                            <option value="">@L["clients.genderSelectPlaceholder", "Select gender"]</option>
                                            @foreach (var gender in GenderOptions)
                                            {
                                                <option value="@gender.Value">@L[gender.ResourceKey]</option>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(editModel.Gender) && !GenderOptions.Any(g => string.Equals(g.Value, editModel.Gender, StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <option value="@editModel.Gender">@string.Format(L["clients.genderOption.Unknown", "Unknown: {0}"], editModel.Gender)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">@L["clients.languageLabel", "Language"]</label>
                                        <select class="form-select" @bind="editModel.Language">
                                            <option value="">@L["clients.languageSelectPlaceholder", "Select language"]</option>
                                            @foreach (var language in SupportedLanguages)
                                            {
                                                <option value="@language.Value">@L[language.ResourceKey]</option>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(editModel.Language) && !SupportedLanguages.Any(l => string.Equals(l.Value, editModel.Language, StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <option value="@editModel.Language">@string.Format(L["clients.languageOption.Unknown", "Unknown: {0}"], editModel.Language)</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-4"><label class="form-label">@L["clients.nationalityLabel", "Nationality"]</label><input type="text" class="form-control" @bind="editModel.Nationality" @bind:event="oninput" /></div>
                                    <div class="col-md-4"><label class="form-label">@L["clients.dateOfBirthLabel", "Date of Birth"]</label><input type="date" class="form-control" @bind="editModel.DateOfBirth" /></div>
                                    <div class="col-md-4"><label class="form-label">@L["clients.birthNationLabel", "Birth Nation"]</label><input type="text" class="form-control" @bind="editModel.BirthNation" @bind:event="oninput" /></div>
                                    <div class="col-md-6"><label class="form-label">@L["clients.birthRegionLabel", "Birth Region"]</label><input type="text" class="form-control" @bind="editModel.BirthRegion" @bind:event="oninput" /></div>
                                    <div class="col-md-6"><label class="form-label">@L["clients.birthCityLabel", "Birth City"]</label><input type="text" class="form-control" @bind="editModel.BirthCity" @bind:event="oninput" /></div>
                                </div>
                            </section>

                            @if (editModel is not null && (showContactSection || HasContacts(editModel)))
                            {
                                <section class="client-section client-section-contact">
                                    <h4 class="client-section-title">@L["clients.section.contact", "Contacts"]</h4>
                                    <div class="row g-2">
                                        <div class="col-12">
                                            <label class="form-label">@L["clients.phoneLabel", "Phone Numbers"]</label>
                                            @if (editModel.Phones.Any())
                                            {
                                                @foreach (var phoneIndex in Enumerable.Range(0, editModel.Phones.Count))
                                                {
                                                    <div class="input-group mb-2" @key="phoneIndex">
                                                        <input type="tel" inputmode="tel" class="form-control @(GetFieldCssClass(GetPhoneFieldName(phoneIndex)))" value="@editModel.Phones[phoneIndex]" @oninput="e => UpdatePhone(phoneIndex, e.Value?.ToString())" @onfocus="() => SetFocusedField(GetPhoneFieldName(phoneIndex))" @onblur="ClearFocusedField" />
                                                        <button type="button" class="btn btn-outline-danger" @onclick="() => RemovePhone(phoneIndex)">×</button>
                                                    </div>
                                                    @if (TryGetFieldWarning(GetPhoneFieldName(phoneIndex)) is string phoneWarning)
                                                    {
                                                        <div class="invalid-feedback d-block">@phoneWarning</div>
                                                    }
                                                }
                                            }
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddPhone">@L["clients.addPhone", "Add phone"]</button>
                                            @if (!editModel.Phones.Any())
                                            {
                                                <div class="form-text">@L["clients.addPhoneGuide", "Add phone numbers as needed; empty lines are hidden."]</div>
                                            }
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label">@L["clients.emailLabel", "Email Addresses"]</label>
                                            @if (editModel.Emails.Any())
                                            {
                                                @foreach (var emailIndex in Enumerable.Range(0, editModel.Emails.Count))
                                                {
                                                    <div class="input-group mb-2" @key="emailIndex">
                                                        <input type="email" class="form-control @(GetFieldCssClass(GetEmailFieldName(emailIndex)))" value="@editModel.Emails[emailIndex]" @oninput="e => UpdateEmail(emailIndex, e.Value?.ToString())" @onfocus="() => SetFocusedField(GetEmailFieldName(emailIndex))" @onblur="ClearFocusedField" />
                                                        <button type="button" class="btn btn-outline-danger" @onclick="() => RemoveEmail(emailIndex)">×</button>
                                                    </div>
                                                    @if (TryGetFieldWarning(GetEmailFieldName(emailIndex)) is string emailWarning)
                                                    {
                                                        <div class="invalid-feedback d-block">@emailWarning</div>
                                                    }
                                                }
                                            }
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddEmail">@L["clients.addEmail", "Add email"]</button>
                                            @if (!editModel.Emails.Any())
                                            {
                                                <div class="form-text">@L["clients.addEmailGuide", "Add email addresses as needed; empty lines are hidden."]</div>
                                            }
                                        </div>
                                    </div>
                                </section>
                            }
                            else if (editModel is not null)
                            {
                                <div class="client-section client-section-contact">
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ShowContactSection">@L["clients.addContactSection", "Add contacts"]</button>
                                    <div class="form-text">@L["clients.contactSectionGuide", "Add phone or email details for this client."]</div>
                                </div>
                            }

                            @if (editModel is not null && (showResidenceSection || HasResidence(editModel)))
                            {
                                <section class="client-section client-section-address">
                                    <h4 class="client-section-title">@L["clients.section.address", "Address"]</h4>
                                    <div class="row g-2">
                                        <div class="col-md-8"><label class="form-label">@L["clients.streetLabel", "Street"]</label><input type="text" class="form-control" @bind="editModel.Street" @bind:event="oninput" /></div>
                                        <div class="col-md-4"><label class="form-label">@L["clients.streetNumberLabel", "Street No"]</label><input type="text" class="form-control" @bind="editModel.StreetNumber" @bind:event="oninput" /></div>
                                        <div class="col-md-4"><label class="form-label">@L["clients.postalCodeLabel", "Postal Code"]</label><input type="text" class="form-control" @bind="editModel.PostalCode" @bind:event="oninput" /></div>
                                        <div class="col-md-8"><label class="form-label">@L["clients.cityLabel", "City"]</label><input type="text" class="form-control" @bind="editModel.City" @bind:event="oninput" /></div>
                                        <div class="col-md-6"><label class="form-label">@L["clients.regionLabel", "Region"]</label><input type="text" class="form-control" @bind="editModel.Region" @bind:event="oninput" /></div>
                                        <div class="col-md-6"><label class="form-label">@L["clients.nationLabel", "Nation"]</label><input type="text" class="form-control" @bind="editModel.Nation" @bind:event="oninput" /></div>
                                    </div>
                                </section>
                            }
                            else if (editModel is not null)
                            {
                                <div class="client-section client-section-address">
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ShowResidenceSection">@L["clients.addAddressSection", "Add address"]</button>
                                    <div class="form-text">@L["clients.addressSectionGuide", "Add address information when available."]</div>
                                </div>
                            }

                            @if (editModel is not null && (showDocumentSection || HasDocument(editModel)))
                            {
                                <section class="client-section client-section-document">
                                    <h4 class="client-section-title">@L["clients.section.document", "Document"]</h4>
                                    <div class="row g-2">
                                        <div class="col-md-4"><label class="form-label">@L["clients.documentTypeLabel", "Document Type"]</label><input type="text" class="form-control" @bind="editModel.DocumentType" @bind:event="oninput" /></div>
                                        <div class="col-md-4"><label class="form-label">@L["clients.documentNumberLabel", "Document Number"]</label><input type="text" class="form-control" @bind="editModel.DocumentNumber" @bind:event="oninput" /></div>
                                        <div class="col-md-4"><label class="form-label">@L["clients.documentExpiryLabel", "Document Expiry"]</label><input type="date" class="form-control" @bind="editModel.DocumentExpiry" /></div>
                                        <div class="col-md-4"><label class="form-label">@L["clients.documentNationLabel", "Document Nation"]</label><input type="text" class="form-control" @bind="editModel.DocumentNation" @bind:event="oninput" /></div>
                                        <div class="col-md-4"><label class="form-label">@L["clients.documentRegionLabel", "Document Region"]</label><input type="text" class="form-control" @bind="editModel.DocumentRegion" @bind:event="oninput" /></div>
                                        <div class="col-md-4"><label class="form-label">@L["clients.documentCityLabel", "Document City"]</label><input type="text" class="form-control" @bind="editModel.DocumentCity" @bind:event="oninput" /></div>
                                    </div>
                                </section>
                            }
                            else if (editModel is not null)
                            {
                                <div class="client-section client-section-document">
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ShowDocumentSection">@L["clients.addDocumentSection", "Add document details"]</button>
                                    <div class="form-text">@L["clients.documentSectionGuide", "Add identification data when needed."]</div>
                                </div>
                            }

                            @if (editModel is not null && (showTaxSection || HasTaxData(editModel)))
                            {
                                <section class="client-section client-section-tax">
                                    <h4 class="client-section-title">@L["clients.section.tax", "Tax Data"]</h4>
                                    <div class="row g-2">
                                        <div class="col-md-4"><label class="form-label">@L["clients.taxCodeLabel", "Tax Code"]</label><input type="text" class="form-control" @bind="editModel.TaxCode" @bind:event="oninput" /></div>
                                        <div class="col-md-4"><label class="form-label">@L["clients.vatNumberLabel", "VAT Number"]</label><input type="text" class="form-control" @bind="editModel.VatNumber" @bind:event="oninput" /></div>
                                        <div class="col-md-4"><label class="form-label">@L["clients.maxOrderLabel", "Max Order Number"]</label><input type="number" min="0" class="form-control" @bind="editModel.MaxOrderNumber" /></div>
                                        <div class="col-md-6"><label class="form-label">@L["clients.companionIdsLabel", "Companion IDs"]</label><input type="text" class="form-control" @bind="editModel.CompanionIds" @bind:event="oninput" /></div>
                                        <div class="col-md-6"><label class="form-label">@L["clients.documentsSentLabel", "Documents Sent"]</label><input type="text" class="form-control" @bind="editModel.DocumentsSent" @bind:event="oninput" /></div>
                                    </div>
                                </section>
                            }
                            else if (editModel is not null)
                            {
                                <div class="client-section client-section-tax">
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ShowTaxSection">@L["clients.addTaxSection", "Add tax data"]</button>
                                    <div class="form-text">@L["clients.taxSectionGuide", "Add tax-related fields only when required."]</div>
                                </div>
                            }

                            <section class="client-section client-section-notes">
                                <h4 class="client-section-title">@L["clients.section.notes", "Notes"]</h4>
                                <textarea class="form-control" rows="3" @bind="editModel!.Notes" @bind:event="oninput"></textarea>
                                <small class="form-text text-muted">@L["clients.notesHelp", "Capture anything the front desk needs to remember for this guest."]</small>
                            </section>
                        </form>
                    </div>

                    <div class="panel-footer">
                        <div class="btn-group w-100" role="group">
                            <button type="button" class="btn btn-primary flex-grow-1" @onclick="SaveClient" disabled="@isSaving">@L["common.save", "Save"]</button>
                            <button type="button" class="btn btn-outline-secondary flex-grow-1" @onclick="ResetEditor" disabled="@isSaving">@L["common.cancel", "Cancel"]</button>
                            @if (!string.IsNullOrWhiteSpace(editModel.Id))
                            {
                                <button type="button" class="btn btn-info flex-grow-1" @onclick="DuplicateClient" disabled="@isSaving">@L["clients.duplicate", "Duplicate"]</button>
                                <button type="button" class="btn btn-danger flex-grow-1" @onclick="DeleteClient" disabled="@isSaving">@L["common.delete", "Delete"]</button>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="panel panel-default h-100 d-flex align-items-center justify-content-center">
                    <div class="panel-body text-center text-muted">
                        <p>@L["clients.selectPrompt", "Select a client from the list or add a new one"]</p>
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="panel panel-default h-100 d-flex flex-column">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["common.details", "Details"]</h3>
                </div>
                <div class="panel-body flex-grow-1 overflow-auto">
                    @if (CurrentPreview is null)
                    {
                        <div class="alert alert-info mb-0">@L["clients.previewEmpty", "Client details will appear here once you select or create a record."]</div>
                    }
                    else
                    {
                        <div class="client-summary-card">
                            <div class="client-summary-name">@GetDisplayName(CurrentPreview)</div>
                            <div class="client-summary-meta">@GetListMeta(CurrentPreview)</div>
                        </div>

                        var previewFields = GetPreviewDetails(CurrentPreview).ToList();
                        @if (previewFields.Any())
                        {
                            <dl class="client-detail-grid mt-3">
                                @foreach (var field in previewFields)
                                {
                                    <dt>@field.Label</dt><dd>@field.Value</dd>
                                }
                            </dl>
                        }
                        else
                        {
                            <div class="alert alert-info mb-0">@L["clients.previewEmpty", "Client details will appear here once you select or create a record."]</div>
                        }

                        <section class="client-section client-section-bookings mt-3">
                            <h4 class="client-section-title">@L["clients.reservationsTitle", "Reservations"]</h4>
                            @if (isBookingLoading)
                            {
                                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                                <span class="ms-2">@L["common.loading", "Loading..."]</span>
                            }
                            else if (clientBookings is null || !clientBookings.Any())
                            {
                                <div class="alert alert-info mb-0">@L["clients.noReservations", "No reservations found for this guest."]</div>
                            }
                            else
                            {
                                <div class="list-group">
                                    @foreach (var booking in clientBookings.Take(ReservationDetailsVisibleCount))
                                    {
                                        <a class="list-group-item list-group-item-action" href="@GetBookingUrl(booking)">
                                            <div class="fw-semibold"><strong>@DisplayDate(booking.ArrivalDate)</strong></div>
                                            <div class="small text-muted">@GetBookingDuration(booking)</div>
                                            <div class="small text-muted">@GetBookingRoomLabel(booking)</div>
                                        </a>
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.clients-manager { height: calc(100vh - 100px); }
.clients-manager .panel { border: 1px solid #ddd; border-radius: 4px; box-shadow: 0 1px 1px rgba(0,0,0,.05); }
.clients-manager .panel-heading { background-color: #f5f5f5; border-bottom: 1px solid #ddd; padding: 10px 15px; }
.clients-manager .panel-body { padding: 15px; }
.clients-manager .panel-footer { background-color: #f5f5f5; border-top: 1px solid #ddd; padding: 10px 15px; }
.status-badge { display: flex; gap: 5px; }
.alert-sm { padding: 8px 12px; margin-bottom: 0; font-size: 0.875rem; }
.client-section { border-left: 4px solid #d8dee7; border-radius: 4px; background: #fff; padding: 14px; margin-bottom: 14px; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.04); }
.client-section-personal { border-left-color: #4caf50; }
.client-section-contact { border-left-color: #9c27b0; }
.client-section-address { border-left-color: #2196f3; }
.client-section-document { border-left-color: #ff9800; }
.client-section-tax { border-left-color: #00bcd4; }
.client-section-notes { border-left-color: #607d8b; }
.client-section-title { font-size: 1rem; font-weight: 700; margin-bottom: 0.75rem; }
.client-summary-card { border-radius: 6px; background: linear-gradient(135deg, #17324d 0%, #274f78 100%); color: #fff; padding: 1rem; }
.client-summary-name { font-size: 1.1rem; font-weight: 700; }
.client-summary-meta { font-size: 0.875rem; opacity: 0.9; }
.client-detail-grid { display: grid; grid-template-columns: minmax(0, 140px) minmax(0, 1fr); gap: 0.4rem 0.75rem; }
.client-detail-grid dt { margin: 0; font-weight: 700; }
.client-detail-grid dd { margin: 0; }
.btn-group > .btn { border-radius: 0; }
.btn-group > .btn:first-child { border-radius: 4px 0 0 4px; }
.btn-group > .btn:last-child { border-radius: 0 4px 4px 0; }
</style>

@code {
    [SupplyParameterFromQuery(Name = "selectedId")]
    public string? SelectedId { get; set; }

    [SupplyParameterFromQuery(Name = "edit")]
    public bool? EditRequested { get; set; }

    private List<ClientDto>? clients;
    private ClientDto? selectedClient;
    private ClientEditModel? editModel;
    private bool showContactSection;
    private bool showResidenceSection;
    private bool showDocumentSection;
    private bool showTaxSection;
    private bool isSaving;
    private bool isSaved = true;
    private bool hasUnsavedChanges;
    private string? lastError;
    private string? statusMessage = string.Empty;
    private string filterText = string.Empty;
    private List<RoomDto>? rooms;
    private List<BookingDto>? clientBookings;
    private bool isBookingLoading;
    private System.Timers.Timer? autoSaveTimer;

    private static readonly (string Value, string ResourceKey)[] GenderOptions = new[]
    {
        ("male", "clients.genderOption.Male"),
        ("female", "clients.genderOption.Female"),
        ("diverse", "clients.genderOption.Diverse")
    };

    private const string PhoneExampleNumber = "+391234567890";

    private static readonly (string Value, string ResourceKey)[] SupportedLanguages = new[]
    {
        ("it", "clients.languageOption.Italian"),
        ("es", "clients.languageOption.Spanish"),
        ("en", "clients.languageOption.English")
    };

    private static readonly string[] TitleOptions = new[] { "Mr", "Mrs", "Ms", "Dr", "Prof", "Mx" };

    private List<ClientDto> FilteredClients => (clients ?? new())
        .Where(client => MatchesFilter(client, filterText))
        .ToList();

    private const int ReservationDetailsVisibleCount = 3;
    private const string FieldPhone = "Phone";
    private const string FieldPhone2 = "Phone2";
    private const string FieldPhone3 = "Phone3";
    private const string FieldEmail = "Email";
    private const string FieldEmail2 = "Email2";
    private const string FieldEmail3 = "Email3";

    private Dictionary<string, string> fieldWarnings = new(StringComparer.OrdinalIgnoreCase);
    private string? focusedField;

    private ClientDto? CurrentPreview => selectedClient;

    protected override async Task OnInitializedAsync()
    {
        statusMessage = L["common.noChanges", "No changes"];
        await LoadClients();
        rooms = await RoomApi.GetRoomsAsync();
        await ApplySelectedClientFromQueryAsync();
        InitializeAutoSaveTimer();
    }

    protected override async Task OnParametersSetAsync()
    {
        await ApplySelectedClientFromQueryAsync();
        EnsureNewClientRoute();
    }

    private void EnsureNewClientRoute()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        if (string.Equals(path, "clients/new", StringComparison.OrdinalIgnoreCase)
            && editModel is null
            && selectedClient is null)
        {
            AddNewClient();
        }
    }

    private void InitializeAutoSaveTimer()
    {
        autoSaveTimer = new System.Timers.Timer(1500);
        autoSaveTimer.Elapsed += async (_, _) =>
        {
            if (hasUnsavedChanges && editModel is not null && !isSaving)
            {
                await InvokeAsync(SaveClient);
            }
        };
        autoSaveTimer.AutoReset = false;
    }

    private async Task LoadClients()
    {
        clients = (await ClientApi.GetAllAsync())
            .OrderBy(client => client.LastName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(client => client.FirstName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(client => client.Id, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task ApplySelectedClientFromQueryAsync()
    {
        if (clients is null || string.IsNullOrWhiteSpace(SelectedId))
        {
            return;
        }

        var requestedClient = clients.FirstOrDefault(client => string.Equals(client.Id, SelectedId, StringComparison.OrdinalIgnoreCase));
        if (requestedClient is not null && !string.Equals(selectedClient?.Id, requestedClient.Id, StringComparison.OrdinalIgnoreCase))
        {
            await SelectClientAsync(requestedClient);
        }
    }

    private async Task SelectClientAsync(ClientDto client)
    {
        selectedClient = client;
        editModel = ClientEditModel.FromDto(client);
        InitializeSectionVisibility();
        isSaved = true;
        hasUnsavedChanges = false;
        lastError = null;
        statusMessage = L["common.noChanges", "No changes"];
        fieldWarnings.Clear();
        focusedField = null;
        ClearAutoSaveTimer();
        await LoadClientBookingsAsync();
    }

    private async Task LoadClientBookingsAsync()
    {
        clientBookings = null;
        if (selectedClient is null)
        {
            return;
        }

        try
        {
            isBookingLoading = true;
            var bookings = await BookingApi.ListAsync();
            clientBookings = bookings
                .Where(booking => string.Equals(booking.ClientId, selectedClient.Id, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(booking => booking.ArrivalDate ?? DateOnly.MinValue)
                .ThenByDescending(booking => booking.Year)
                .ThenByDescending(booking => booking.Id)
                .ToList();
        }
        finally
        {
            isBookingLoading = false;
        }
    }

    private string GetBookingUrl(BookingDto booking)
    {
        if (booking is null || string.IsNullOrWhiteSpace(booking.Id))
        {
            return "/bookings";
        }

        return $"/bookings?selectedId={Uri.EscapeDataString(booking.Id)}";
    }

    private string GetBookingRoomLabel(BookingDto booking)
    {
        if (string.IsNullOrWhiteSpace(booking.RoomId))
        {
            return string.Empty;
        }

        return string.Format(L["clients.reservationRoomLabel", "Room"] + ": {0}", GetRoomDisplayName(booking.RoomId));
    }

    private string GetRoomDisplayName(string roomId)
    {
        if (rooms is null || string.IsNullOrWhiteSpace(roomId))
        {
            return roomId;
        }

        var room = rooms.FirstOrDefault(current => string.Equals(current.Id, roomId, StringComparison.OrdinalIgnoreCase));
        if (room is null)
        {
            return roomId;
        }

        return string.IsNullOrWhiteSpace(room.Name) ? roomId : room.Name;
    }

    private void OpenBooking(BookingDto booking)
    {
        if (booking is null || string.IsNullOrWhiteSpace(booking.Id))
        {
            return;
        }

        Navigation.NavigateTo($"/bookings?selectedId={Uri.EscapeDataString(booking.Id)}");
    }

    private string GetBookingReference(BookingDto booking)
    {
        if (booking.Year > 0 && !string.IsNullOrWhiteSpace(booking.Id))
        {
            return $"#{booking.Year}/{booking.Id}";
        }

        return L["clients.reservationEntry", "Reservation entry"];
    }

    private string GetBookingDateAndDuration(BookingDto booking)
    {
        var date = DisplayDate(booking.ArrivalDate);
        var duration = GetBookingDuration(booking);
        if (!string.IsNullOrWhiteSpace(duration))
        {
            return $"{L["clients.reservationStartLabel", "Start Date"]}: {date} · {duration}";
        }

        return $"{L["clients.reservationStartLabel", "Start Date"]}: {date}";
    }

    private string GetBookingDuration(BookingDto booking)
    {
        if (!booking.ArrivalDate.HasValue || !booking.DepartureDate.HasValue)
        {
            return string.Empty;
        }

        var days = (booking.DepartureDate.Value.ToDateTime(TimeOnly.MinValue) - booking.ArrivalDate.Value.ToDateTime(TimeOnly.MinValue)).Days;
        if (days <= 0)
        {
            return string.Empty;
        }

        if (days == 1)
        {
            return string.Format(L["clients.reservationDay", "{0} day"], days);
        }

        return string.Format(L["clients.reservationNights", "{0} nights"], days);
    }

    private string GetBookingMeta(BookingDto booking)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(booking.RoomId))
        {
            parts.Add($"{L["clients.reservationRoomLabel", "Room"]}: {booking.RoomId}");
        }

        if (!string.IsNullOrWhiteSpace(booking.Status))
        {
            parts.Add($"{L["clients.reservationStatusLabel", "Status"]}: {booking.Status}");
        }

        if (parts.Count == 0)
        {
            return booking.Year > 0 && !string.IsNullOrWhiteSpace(booking.Id)
                ? $"#{booking.Year}/{booking.Id}"
                : L["clients.reservationEntry", "Reservation entry"];
        }

        return string.Join(" · ", parts);
    }

    private void AddNewClient()
    {
        selectedClient = null;
        editModel = new ClientEditModel
        {
            Phones = new List<string>(),
            Emails = new List<string>()
        };
        InitializeSectionVisibility();
        isSaved = false;
        hasUnsavedChanges = false;
        lastError = null;
        statusMessage = L["common.unsaved", "Unsaved changes"];
        fieldWarnings.Clear();
        focusedField = null;
    }

    private void OnEditorChanged(ChangeEventArgs _)
    {
        if (editModel is null)
        {
            return;
        }

        isSaved = false;
        hasUnsavedChanges = true;
        lastError = null;
        statusMessage = L["common.unsaved", "Unsaved changes"];
        ValidateInlineFields();
        autoSaveTimer?.Stop();
        autoSaveTimer?.Start();
    }

    private void ResetEditor()
    {
        lastError = null;
        ClearAutoSaveTimer();

        if (selectedClient is not null)
        {
            editModel = ClientEditModel.FromDto(selectedClient);
            isSaved = true;
            hasUnsavedChanges = false;
            statusMessage = L["common.noChanges", "No changes"];
        }
        else
        {
            editModel = null;
            isSaved = true;
            hasUnsavedChanges = false;
            statusMessage = L["common.noChanges", "No changes"];
        }
    }

    private void ClearAutoSaveTimer() => autoSaveTimer?.Stop();

    private void SetFocusedField(string fieldName) => focusedField = fieldName;
    private void ClearFocusedField() => focusedField = null;
    private string GetFieldCssClass(string fieldName) => fieldWarnings.ContainsKey(fieldName) ? "is-invalid" : string.Empty;
    private string? TryGetFieldWarning(string fieldName) => fieldWarnings.TryGetValue(fieldName, out var warning) ? warning : null;

    private void ValidateInlineFields()
    {
        fieldWarnings.Clear();
        if (editModel is null)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(editModel.Language) && !HotelDruid.Shared.ClientFieldMappings.IsSupportedLanguage(editModel.Language))
        {
            fieldWarnings["Language"] = L["clients.languageInvalid", "Language must be one of the supported values: it, es, en."];
        }
        else if (string.IsNullOrWhiteSpace(editModel.Language))
        {
            fieldWarnings["Language"] = L["clients.languageRequired", "Language is required."];
        }

        if (!string.IsNullOrWhiteSpace(editModel.Gender) && !HotelDruid.Shared.ClientFieldMappings.IsSupportedGender(editModel.Gender))
        {
            fieldWarnings["Gender"] = L["clients.genderInvalid", "Gender must be one of the supported values."];
        }

        for (var i = 0; i < editModel.Emails.Count; i++)
        {
            if (!string.IsNullOrWhiteSpace(editModel.Emails[i]) && !IsValidEmail(editModel.Emails[i]))
            {
                fieldWarnings[GetEmailFieldName(i)] = L["clients.emailInvalid", "Email must be a valid address."];
            }
        }

        for (var i = 0; i < editModel.Phones.Count; i++)
        {
            var normalizedPhone = NormalizePhoneNumber(editModel.Phones[i]);
            if (!string.IsNullOrWhiteSpace(editModel.Phones[i]) && !IsValidPhoneNumber(normalizedPhone))
            {
                fieldWarnings[GetPhoneFieldName(i)] = L["clients.phoneInvalid", "Phone numbers must be E.164 formatted, for example +391234567890."];
            }
        }
    }

    private async Task SaveClient()
    {
        if (editModel is null || isSaving)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(editModel.LastName))
        {
            lastError = L["clients.lastNameRequired", "Last Name is required."];
            return;
        }

        fieldWarnings.Clear();
        if (string.IsNullOrWhiteSpace(editModel.Language))
        {
            fieldWarnings["Language"] = L["clients.languageRequired", "Language is required."];
        }
        else if (!HotelDruid.Shared.ClientFieldMappings.IsSupportedLanguage(editModel.Language))
        {
            fieldWarnings["Language"] = L["clients.languageInvalid", "Language must be one of the supported values: it, es, en."];
        }

        editModel.LastName = NormalizeName(editModel.LastName);
        editModel.FirstName = NormalizeName(editModel.FirstName);
        editModel.Language = HotelDruid.Shared.ClientFieldMappings.GetCanonicalLanguage(editModel.Language) ?? editModel.Language?.Trim();
        editModel.Gender = HotelDruid.Shared.ClientFieldMappings.GetCanonicalGender(editModel.Gender) ?? editModel.Gender?.Trim();

        editModel.Emails = editModel.Emails
            .Select(NormalizeEmail)
            .Where(email => !string.IsNullOrWhiteSpace(email))
            .Select(email => email!)
            .ToList();

        editModel.Email = editModel.Emails.ElementAtOrDefault(0);
        editModel.Email2 = editModel.Emails.ElementAtOrDefault(1);
        editModel.Email3 = editModel.Emails.ElementAtOrDefault(2);

        for (var i = 0; i < editModel.Emails.Count; i++)
        {
            if (!IsValidEmail(editModel.Emails[i]))
            {
                fieldWarnings[GetEmailFieldName(i)] = L["clients.emailInvalid", "Email must be a valid address."];
            }
        }

        editModel.Phones = editModel.Phones
            .Select(NormalizePhoneNumber)
            .Where(phone => !string.IsNullOrWhiteSpace(phone))
            .Select(phone => phone!)
            .ToList();

        for (var i = 0; i < editModel.Phones.Count; i++)
        {
            if (!IsValidPhoneNumber(editModel.Phones[i]))
            {
                fieldWarnings[GetPhoneFieldName(i)] = L["clients.phoneInvalid", "Phone numbers must be E.164 formatted, for example +391234567890."];
            }
        }

        if (!string.IsNullOrWhiteSpace(editModel.VatNumber))
        {
            editModel.VatNumber = NormalizeVatNumber(editModel.VatNumber);
            if (!IsValidEuropeanVatNumber(editModel.VatNumber))
            {
                lastError = L["clients.vatNumberInvalid", "VAT Number must be in European format with country prefix."];
                return;
            }
        }

        isSaving = true;
        lastError = null;
        hasUnsavedChanges = false;

        try
        {
            var dto = editModel.ToDto();
            string? savedId;
            if (string.IsNullOrWhiteSpace(editModel.Id))
            {
                savedId = await ClientApi.CreateAsync(dto);
            }
            else
            {
                await ClientApi.UpdateAsync(editModel.Id, dto);
                savedId = editModel.Id;
            }

            await LoadClients();
            if (!string.IsNullOrWhiteSpace(savedId))
            {
                selectedClient = clients?.FirstOrDefault(client => string.Equals(client.Id, savedId, StringComparison.OrdinalIgnoreCase))
                    ?? await ClientApi.GetByIdAsync(savedId);
            }

            if (selectedClient is not null)
            {
                editModel = ClientEditModel.FromDto(selectedClient);
                InitializeSectionVisibility();
                ValidateInlineFields();
            }

            isSaved = true;
            statusMessage = L["common.saved", "Saved"];
        }
        catch (Exception ex)
        {
            hasUnsavedChanges = true;
            lastError = string.Format(L["clients.saveFailed", "Failed to save client: {0}"], ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void DuplicateClient()
    {
        if (editModel is null)
        {
            return;
        }

        editModel = editModel.CloneForDuplicate();
        InitializeSectionVisibility();
        selectedClient = null;
        isSaved = false;
        hasUnsavedChanges = true;
        statusMessage = L["common.unsaved", "Unsaved changes"];
    }

    private async Task DeleteClient()
    {
        if (editModel?.Id is null)
        {
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", string.Format(L["clients.deleteConfirm", "Are you sure you want to delete client {0}?"], GetDisplayName(editModel)));
        if (!confirmed)
        {
            return;
        }

        isSaving = true;
        try
        {
            await ClientApi.DeleteAsync(editModel.Id);
            await LoadClients();
            selectedClient = null;
            editModel = null;
            isSaved = true;
            lastError = null;
            statusMessage = L["common.saved", "Saved"];
        }
        catch (Exception ex)
        {
            lastError = string.Format(L["clients.deleteFailed", "Failed to delete client: {0}"], ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private static bool MatchesFilter(ClientDto client, string filter)
    {
        if (string.IsNullOrWhiteSpace(filter))
        {
            return true;
        }

        var term = filter.Trim();
        return GetDisplayName(client).Contains(term, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(client.Email) && client.Email.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(client.Phone) && client.Phone.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(client.City) && client.City.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private static string GetDisplayName(ClientDto client)
        => !string.IsNullOrWhiteSpace(client.LastName) && !string.IsNullOrWhiteSpace(client.FirstName)
            ? $"{client.LastName}, {client.FirstName}"
            : client.LastName ?? client.FirstName ?? client.Nickname ?? "Unknown client";

    private static string GetDisplayName(ClientEditModel client)
        => !string.IsNullOrWhiteSpace(client.LastName) && !string.IsNullOrWhiteSpace(client.FirstName)
            ? $"{client.LastName}, {client.FirstName}"
            : client.LastName ?? client.FirstName ?? client.Nickname ?? "Unknown client";

    private static string GetListMeta(ClientDto client)
    {
        var parts = new[] { client.Email, client.Phone, client.City }.Where(part => !string.IsNullOrWhiteSpace(part)).ToList();
        return parts.Count == 0 ? "No additional details" : string.Join(" · ", parts);
    }

    private static string GetListMeta(ClientEditModel client)
    {
        var parts = new[] { client.City }
            .Concat(client.Phones ?? Enumerable.Empty<string>())
            .Concat(client.Emails ?? Enumerable.Empty<string>())
            .Where(part => !string.IsNullOrWhiteSpace(part))
            .ToList();
        return parts.Count == 0 ? "No additional details" : string.Join(" · ", parts);
    }

