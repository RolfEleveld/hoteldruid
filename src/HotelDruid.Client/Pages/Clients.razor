    private void InitializeSectionVisibility()
    {
        if (editModel is null)
        {
            return;
        }

        showContactSection = HasContacts(editModel);
        showResidenceSection = HasResidence(editModel);
        showDocumentSection = HasDocument(editModel);
        showTaxSection = HasTaxData(editModel);
    }

    private static bool HasContacts(ClientEditModel model)
        => model.Phones.Any(p => !string.IsNullOrWhiteSpace(p)) || model.Emails.Any(e => !string.IsNullOrWhiteSpace(e));

    private static bool HasResidence(ClientEditModel model)
        => !string.IsNullOrWhiteSpace(model.Street)
            || !string.IsNullOrWhiteSpace(model.StreetNumber)
            || !string.IsNullOrWhiteSpace(model.PostalCode)
            || !string.IsNullOrWhiteSpace(model.City)
            || !string.IsNullOrWhiteSpace(model.Region)
            || !string.IsNullOrWhiteSpace(model.Nation);

    private static bool HasDocument(ClientEditModel model)
        => !string.IsNullOrWhiteSpace(model.DocumentType)
            || !string.IsNullOrWhiteSpace(model.DocumentNumber)
            || model.DocumentExpiry.HasValue
            || !string.IsNullOrWhiteSpace(model.DocumentNation)
            || !string.IsNullOrWhiteSpace(model.DocumentRegion)
            || !string.IsNullOrWhiteSpace(model.DocumentCity);

    private static bool HasTaxData(ClientEditModel model)
        => !string.IsNullOrWhiteSpace(model.TaxCode)
            || !string.IsNullOrWhiteSpace(model.VatNumber)
            || model.MaxOrderNumber.HasValue
            || !string.IsNullOrWhiteSpace(model.CompanionIds)
            || !string.IsNullOrWhiteSpace(model.DocumentsSent);

