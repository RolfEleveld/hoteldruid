        }
    }

    private async Task LoadSelectedGuestHistoryAsync()
    {
        selectedGuestBookings = null;

        if (selected is null || string.IsNullOrWhiteSpace(selected.ClientId))
        {
            return;
        }

        try
        {
            isGuestHistoryLoading = true;
            var bookings = await BookingApi.ListAsync();
            selectedGuestBookings = bookings
                .Where(booking => string.Equals(booking.ClientId, selected.ClientId, StringComparison.OrdinalIgnoreCase)
                    && (!string.Equals(booking.Id, selected.Id, StringComparison.OrdinalIgnoreCase) || booking.Year != selected.Year))
                .OrderByDescending(booking => booking.ArrivalDate ?? DateOnly.MinValue)
                .ThenByDescending(booking => booking.Year)
                .ThenByDescending(booking => booking.Id)
                .ToList();
        }
        finally
        {
            isGuestHistoryLoading = false;
        }
    }

    private static bool IsPreArrivalBooking(BookingDto booking)
    {
        if (IsNonBlockingBookingStatus(booking.Status)
            || booking.ActualArrivalDate.HasValue
            || booking.ActualDepartureDate.HasValue
            || !booking.ArrivalDate.HasValue
            || !booking.DepartureDate.HasValue)
        {
            return false;
        }

        return booking.DepartureDate.Value > booking.ArrivalDate.Value;
    }

    private static bool IsCheckedInBooking(BookingDto booking)
    {
        if (IsNonBlockingBookingStatus(booking.Status)
            || !booking.ActualArrivalDate.HasValue
            || booking.ActualDepartureDate.HasValue
            || !booking.DepartureDate.HasValue)
        {
            return false;
        }

        return booking.DepartureDate.Value > booking.ActualArrivalDate.Value;
    }

    private static bool IsNonBlockingBookingStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return false;
        }

        return status.Contains("cancel", StringComparison.OrdinalIgnoreCase)
               || status.Contains("void", StringComparison.OrdinalIgnoreCase)
               || status.Contains("deleted", StringComparison.OrdinalIgnoreCase)
               || status.Contains("no-show", StringComparison.OrdinalIgnoreCase)
               || status.Contains("noshow", StringComparison.OrdinalIgnoreCase);
    }

    private async Task OnClientSearchChanged(ChangeEventArgs args)
    {
        clientSearch = args.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(clientSearch))
        {
            clientMatches.Clear();
            if (selectedClient is null)
            {
                form.ClientId = null;
            }
            return;
        }

        var term = clientSearch.Trim();
        clientMatches = knownClients
            .Where(c => ContainsClientSearch(c, term))
            .OrderBy(c => c.LastName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(c => c.FirstName, StringComparer.OrdinalIgnoreCase)
            .Take(8)
            .ToList();
    }

