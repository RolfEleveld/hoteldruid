            isPaymentsLoading = false;
        }
    }

    private static bool IsMoneyMovement(BookingTransactionDto row)
    {
        var type = row.Type ?? "";
        return type.Contains("payment", StringComparison.OrdinalIgnoreCase)
            || type.Contains("prepaid", StringComparison.OrdinalIgnoreCase)
            || type.Contains("deposit", StringComparison.OrdinalIgnoreCase)
            || type.Contains("refund", StringComparison.OrdinalIgnoreCase);
    }

    private string DescribePayment(BookingTransactionDto row)
    {
        var type = row.Type ?? "";
        var label = type.Contains("refund", StringComparison.OrdinalIgnoreCase) ? L["bookings.moneyRefund"]
            : type.Contains("deposit", StringComparison.OrdinalIgnoreCase) ? L["bookings.moneyDeposit"]
            : type.Contains("prepaid", StringComparison.OrdinalIgnoreCase) ? L["bookings.moneyPrepaid"]
            : L["bookings.moneyPaid"];
        return $"{label} {FormatMoney(row.Amount)}";
    }

