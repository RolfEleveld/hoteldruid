    private void GoToClient(string? clientId, bool edit = false)
    {
      if (string.IsNullOrWhiteSpace(clientId))
      {
        Navigation.NavigateTo("/clients");
        return;
      }

      var route = $"/clients?selectedId={Uri.EscapeDataString(clientId)}";
      if (edit)
      {
        route += "&edit=true";
      }

      Navigation.NavigateTo(route);
    }

    private void GoToRoom(string? roomId)
    {
        if (string.IsNullOrWhiteSpace(roomId))
        {
            Navigation.NavigateTo("/rooms");
            return;
        }

        var route = $"/rooms?selectedId={Uri.EscapeDataString(roomId)}";
        Navigation.NavigateTo(route);
    }
    
    private static bool ContainsClientSearch(ClientRecord client, string term)
    {
        return (!string.IsNullOrWhiteSpace(client.LastName) && client.LastName.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(client.FirstName) && client.FirstName.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(client.Email) && client.Email.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(client.Phone) && client.Phone.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(client.Id) && client.Id.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private static bool ContainsRoomSearch(RoomRecord room, string term)
    {
        return (!string.IsNullOrWhiteSpace(room.Name) && room.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(room.Id) && room.Id.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private string GetClientDisplayName(string? clientId)
    {
        if (string.IsNullOrWhiteSpace(clientId))
        {
            return L["bookings.unknownClient", "Unknown client"];
        }

        var client = knownClients.FirstOrDefault(current => string.Equals(current.Id, clientId, StringComparison.OrdinalIgnoreCase));
        return client is null ? L["bookings.unknownClient", "Unknown client"] : ClientDisplayName(client);
    }

    private string GetRoomDisplayName(string? roomId)
    {
        if (string.IsNullOrWhiteSpace(roomId))
        {
            return L["bookings.unassignedRoom", "Unassigned room"];
        }

        var room = knownRooms.FirstOrDefault(current => string.Equals(current.Id, roomId, StringComparison.OrdinalIgnoreCase));
        if (room is null)
        {
            return L["bookings.unknownRoom", "Unknown room"];
        }

        return string.IsNullOrWhiteSpace(room.Name) ? L["bookings.unknownRoom", "Unknown room"] : room.Name;
    }

    private ClientRecord? GetSelectedGuestClient()
    {
        if (selected is null || string.IsNullOrWhiteSpace(selected.ClientId))
        {
            return null;
        }

        return knownClients.FirstOrDefault(client => string.Equals(client.Id, selected.ClientId, StringComparison.OrdinalIgnoreCase));
    }

    private string GetBookingSummaryTitle(BookingDto booking)
    {
        var clientName = GetClientDisplayName(booking.ClientId);
        var roomName = GetRoomDisplayName(booking.RoomId);
        return $"{booking.Year} — {clientName} · {roomName}";
    }

    private string GetBookingSummaryMeta(BookingDto booking)
    {
        var parts = new List<string>();
        parts.Add($"{FormatDate(booking.ArrivalDate)} → {FormatDate(booking.DepartureDate)}");

        if (!string.IsNullOrWhiteSpace(booking.Status))
        {
            parts.Add(booking.Status);
        }

        if (booking.ActualArrivalDate.HasValue || booking.ActualDepartureDate.HasValue)
        {
            parts.Add($"{FormatDate(booking.ActualArrivalDate)} / {FormatDate(booking.ActualDepartureDate)}");
        }

        return string.Join(" · ", parts);
    }

