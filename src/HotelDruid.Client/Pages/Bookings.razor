    private void CancelTariffPreview()
    {
        tariffPreviewGeneration++;
        previewTariff = null;
        previewTariffLoading = false;
    }

    private async Task RefreshTariffPreviewAsync()
    {
        // Do not re-resolve on existing confirmed bookings unless the user changed room/dates
        if (!isNew && !string.IsNullOrWhiteSpace(form.TariffId) && (form.TariffTotalPrice ?? 0) > 0)
        {
            CancelTariffPreview();
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(form.RoomId) || !form.ArrivalDate.HasValue || !form.DepartureDate.HasValue
            || form.DepartureDate.Value <= form.ArrivalDate.Value)
        {
            CancelTariffPreview();
            StateHasChanged();
            return;
        }

        var requestId = ++tariffPreviewGeneration;
        var roomId = form.RoomId;
        var arrival = form.ArrivalDate.Value;
        var departure = form.DepartureDate.Value;
        var guestCount = form.ActualGuestCount ?? form.ExpectedGuestCount ?? 1;
        previewTariffLoading = true;
        StateHasChanged();
        try
        {
            var resolved = await TariffApi.ResolveTariffAsync(roomId, arrival, departure, guestCount);
            if (requestId != tariffPreviewGeneration)
            {
                return;
            }

            previewTariff = resolved;
            if (previewTariff is not null)
            {
                form.TariffId = previewTariff.TariffId;
                form.TariffTotalPrice = previewTariff.TotalPrice;
            }
        }
        finally
        {
            if (requestId == tariffPreviewGeneration)
            {
                previewTariffLoading = false;
                // Room selection and new-booking start this without awaiting it.
                // The tariff request can also finish while finance is still loading.
                // Either way the spinner has to clear on this render, not the next handler.
                StateHasChanged();
            }
        }
    }

    private int StoredStayNights()
    {
        if (!form.ArrivalDate.HasValue || !form.DepartureDate.HasValue || form.DepartureDate.Value <= form.ArrivalDate.Value)
            return 0;
        return form.DepartureDate.Value.DayNumber - form.ArrivalDate.Value.DayNumber;
    }

