    private void OpenMove()
    {
        moveError = null;
        moveNote = null;
        moveReason = "Relocate";
        moveRoomId = null;
        moveOpen = true;
        if (selected?.ArrivalDate is null || selected.DepartureDate is null)
            return;
        var earliest = selected.ArrivalDate.Value.AddDays(1);
        var latest = selected.DepartureDate.Value.AddDays(-1);
        var tomorrow = DateOnly.FromDateTime(DateTime.Today).AddDays(1);
        moveFrom = tomorrow < earliest ? earliest : tomorrow > latest ? latest : tomorrow;
    }

    private async Task ConfirmMoveAsync(BookingMoveRequest request)
    {
        if (moveBusy)
            return;
        if (selected?.Id is null || request.FromDate == default || string.IsNullOrWhiteSpace(request.RoomId))
        {
            moveError = L["bookings.moveMissing", "Choose the night and the room."];
            return;
        }

        moveBusy = true;
        moveError = null;
        try
        {
            var moved = await BookingApi.MoveAsync(selected.Year, selected.Id, request);
            moveOpen = false;
            if (!string.IsNullOrWhiteSpace(moved?.Id))
                Navigation.NavigateTo(BookingReference.Href(moved.Id));
            else
                await LoadAll();
        }
        catch (Exception ex)
        {
            var continued = await ContinuedStayAfterMoveAsync();
            if (!string.IsNullOrWhiteSpace(continued))
            {
                moveOpen = false;
                Navigation.NavigateTo(BookingReference.Href(continued));
                return;
            }

            moveError = ex.Message;
        }
        finally
        {
            moveBusy = false;
        }
    }

