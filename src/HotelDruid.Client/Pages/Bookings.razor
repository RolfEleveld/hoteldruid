@page "/bookings"
@page "/bookings/new"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components
@using HotelDruid.Client.Services
@using HotelDruid.Shared
@using ClientRecord = HotelDruid.Client.Services.ClientDto
@using RoomRecord = HotelDruid.Client.Services.RoomDto
@inject IBookingApiService BookingApi
@inject IClientApiService ClientApi
@inject IRoomApiService RoomApiService
@inject IActiveYearService ActiveYearService
@inject NavigationManager Navigation

@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["bookings.title", "Bookings"]</PageTitle>
<div class="container-fluid bookings-manager">
    <div class="row g-3 h-100">
        <!-- LEFT: Bookings List -->
        <div class="col-md-3">
            <div class="panel panel-default h-100 d-flex flex-column">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["bookings.title", "Bookings"]</h3>
                </div>
                <div class="panel-body flex-grow-1 overflow-auto">
                    <button class="btn btn-success btn-sm w-100 mb-3" @onclick="NewRecord">
                        <span class="bi bi-plus"></span> @L["bookings.new", "New"]
                    </button>
                    <div class="d-flex gap-1 mb-3">
                        <input class="form-control form-control-sm" type="number" @bind="filterYear" placeholder="@L["bookings.filterYear", "Year"]" style="width:80px" />
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ApplyFilter">@L["bookings.load", "Load"]</button>
                    </div>
                    <div class="mb-3">
                        <input type="text" class="form-control form-control-sm" @bind="listFilter" @bind:event="oninput"
                               placeholder="@L["bookings.searchPlaceholder", "Search by client, room, status, or year"]" />
                    </div>
                    @if (records is null)
                    {
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">@L["common.loading", "Loading..."]</span>
                        </div>
                    }
                    else if (FilteredRecords.Count == 0)
                    {
                        <div class="alert alert-info">@L["bookings.emptyList", "No bookings"]</div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var r in FilteredRecords)
                            {
                                <button type="button" class="list-group-item list-group-item-action @(selected?.Id == r.Id ? "active" : "")"
                                        @onclick="() => SelectRecordAndEdit(r)">
                                    <div class="fw-semibold">@r.Year — @GetClientDisplayName(r.ClientId)</div>
                                    <small class="text-muted">@FormatDate(r.ArrivalDate) → @FormatDate(r.DepartureDate) (@r.Status)</small>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- MIDDLE: Edit Form -->
        <div class="col-md-6">
            @if (editing)
            {
                <div class="panel panel-default h-100 d-flex flex-column">
                    <div class="panel-heading">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h3 class="panel-title mb-0">@(isNew ? L["bookings.newBooking", "New Booking"] : $"{selected?.Year} — {GetClientDisplayName(selected?.ClientId)}")</h3>
                                <small class="text-muted">@L["bookings.editBooking", "Edit Booking"]</small>
                            </div>
                            @if (!string.IsNullOrEmpty(errorMsg))
                            {
                                <span class="badge bg-danger">@L["common.error", "Error"]</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(errorMsg))
                        {
                            <div class="alert alert-danger alert-sm mt-2 mb-0">@errorMsg</div>
                        }
                    </div>
                    <div class="panel-body flex-grow-1 overflow-auto">
                        <div class="row g-2">
                            <div class="col-6"><label class="form-label">@L["bookings.year", "Year"] *</label><input class="form-control" type="number" @bind="form.Year" /></div>
                            <div class="col-6"><label class="form-label">@L["bookings.status", "Status"]</label><input class="form-control" @bind="form.Status" /></div>
                            <div class="col-6"><label class="form-label">@L["bookings.arrivalDate", "Arrival Date"]</label><input class="form-control" type="date" @bind="form.ArrivalDate" /></div>
                            <div class="col-6"><label class="form-label">@L["bookings.departureDate", "Departure Date"]</label><input class="form-control" type="date" @bind="form.DepartureDate" /></div>
                            <div class="col-6"><label class="form-label">@L["bookings.actualArrivalDateOptional", "Actual Arrival Date (optional)"]</label><input class="form-control" type="date" @bind="form.ActualArrivalDate" /></div>
                            <div class="col-6"><label class="form-label">@L["bookings.actualDepartureDateOptional", "Actual Checkout Date (optional)"]</label><input class="form-control" type="date" @bind="form.ActualDepartureDate" /></div>
                            <div class="col-6"><label class="form-label">@L["bookings.actualGuestCount", "Guests On Arrival"]</label><input class="form-control" type="number" min="1" @bind="form.ActualGuestCount" /></div>
                            <div class="col-6"><label class="form-label">@L["bookings.prepaidAmount", "Prepaid Amount"]</label><input class="form-control" type="number" min="0" step="0.01" @bind="form.PrepaidAmount" /></div>
                            <div class="col-12"><label class="form-label">@L["bookings.notes", "Notes"]</label><input class="form-control" @bind="form.Notes" /></div>

                            <div class="col-12 mt-2"><h6 class="text-muted mb-1">@L["bookings.roomSearchLabel", "Find room"] *</h6></div>
                            <div class="col-12"><input class="form-control" value="@roomSearch" placeholder="@L["bookings.roomSearchPlaceholder", "Type room name or ID"]" @oninput="OnRoomSearchChanged" /></div>
                            @if (roomMatches.Count > 0)
                            {
                                <div class="col-12">
                                    <div class="list-group">
                                        @foreach (var room in roomMatches)
                                        {
                                            <button type="button" class="list-group-item list-group-item-action" @onclick="() => SelectRoom(room)">
                                                <div class="fw-semibold">@GetRoomDisplayName(room.Id)</div>
                                                <small class="text-muted">@L["rooms.capacityLabel", "Capacity"]: @room.Capacity</small>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                            @if (selectedRoom is not null)
                            {
                                <div class="col-12">
                                    <div class="border rounded p-2 bg-light-subtle">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <button type="button" class="btn btn-link p-0 text-start" @onclick="() => GoToRoom(selectedRoom.Id)">
                                                <div class="fw-semibold">@GetRoomDisplayName(selectedRoom.Id)</div>
                                                <small class="text-muted">@L["rooms.capacityLabel", "Capacity"]: @selectedRoom.Capacity</small>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearRoomSelection">@L["bookings.clearSelection", "Clear"]</button>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (selectedRoom is null && !string.IsNullOrWhiteSpace(roomSearch))
                            {
                                <div class="col-12 text-muted small">@L["bookings.noRoomMatch", "No room matches this search."]</div>
                            }

                            <div class="col-12 mt-2"><h6 class="text-muted mb-1">@L["bookings.clientSearchLabel", "Find existing client"]</h6></div>
                            <div class="col-12">
                                <input class="form-control" value="@clientSearch"
                                       placeholder="@L["bookings.clientSearchPlaceholder", "Type last name, first name, email, or phone"]"
                                       @oninput="OnClientSearchChanged" />
                            </div>
                            @if (clientMatches.Count > 0)
                            {
                                <div class="col-12">
                                    <div class="list-group">
                                        @foreach (var client in clientMatches)
                                        {
                                            <button type="button" class="list-group-item list-group-item-action" @onclick="() => SelectClient(client)">
                                                <div class="fw-semibold">@ClientDisplayName(client)</div>
                                                <small class="text-muted">@client.Email @client.Phone @client.City</small>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                            @if (selectedClient is not null)
                            {
                                <div class="col-12">
                                    <div class="border rounded p-2 bg-light-subtle">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <button type="button" class="btn btn-link p-0 text-start" @onclick="() => GoToClient(selectedClient.Id)">
                                                <div class="fw-semibold">@ClientDisplayName(selectedClient)</div>
                                                <small class="text-muted">@selectedClient.Email · @selectedClient.Phone</small>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearClientSelection">@L["bookings.clearSelection", "Clear"]</button>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (selectedClient is null && !creatingNewClient && !string.IsNullOrWhiteSpace(clientSearch))
                            {
                                <div class="col-12">
                                    <div class="text-muted small">@L["bookings.noClientMatch", "No existing client matches this search."]</div>
                                    <button type="button" class="btn btn-sm btn-outline-primary mt-1" @onclick="EnableInlineClientCreate">@L["bookings.createClientInline", "Enter new client details"]</button>
                                </div>
                            }
                            @if (creatingNewClient)
                            {
                                <div class="col-12 mt-2">
                                    <div class="border rounded p-3">
                                        <div class="row g-2">
                                            <div class="col-6"><label class="form-label">@L["bookings.clientLastName", "Last Name"] *</label><input class="form-control" @bind="clientForm.LastName" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientFirstName", "First Name"]</label><input class="form-control" @bind="clientForm.FirstName" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientNickname", "Nickname"]</label><input class="form-control" @bind="clientForm.Nickname" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientLanguage", "Language"]</label><input class="form-control" @bind="clientForm.Language" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientPhone", "Phone"]</label><input class="form-control" @bind="clientForm.Phone" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientEmail", "Email"]</label><input class="form-control" @bind="clientForm.Email" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientNation", "Nation"]</label><input class="form-control" @bind="clientForm.Nation" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientCity", "City"]</label><input class="form-control" @bind="clientForm.City" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientDocumentType", "Document Type"]</label><input class="form-control" @bind="clientForm.DocumentType" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientDocumentNumber", "Document Number"]</label><input class="form-control" @bind="clientForm.DocumentNumber" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientTaxCode", "Tax Code"]</label><input class="form-control" @bind="clientForm.TaxCode" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientVatNumber", "VAT Number"]</label><input class="form-control" @bind="clientForm.VatNumber" /></div>
                                            <div class="col-12"><label class="form-label">@L["bookings.notes", "Notes"]</label><input class="form-control" @bind="clientForm.Notes" /></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="panel-footer">
                        <div class="btn-group w-100" role="group">
                            <button class="btn btn-primary flex-grow-1" @onclick="Save">@L["common.save", "Save"]</button>
                            <button class="btn btn-secondary flex-grow-1" @onclick="Cancel">@L["common.cancel", "Cancel"]</button>
                            @if (CanMarkArrivedSelected)
                            {
                                <button class="btn btn-info flex-grow-1" @onclick="CheckInSelected">@L["Dashboard.Reservations.Menu.Arrived", "Arrived"]</button>
                                <button class="btn btn-warning flex-grow-1" @onclick="MarkNoShowSelected">@L["bookings.markNoShow", "Mark No-Show"]</button>
                                <button class="btn btn-outline-danger flex-grow-1" @onclick="CancelBooking">@L["bookings.cancelBooking", "Cancel Booking"]</button>
                            }
                            else if (CanCheckOutSelected)
                            {
                                <button class="btn btn-dark flex-grow-1" @onclick="CheckOutSelected">@L["bookings.checkOut", "Check Out"]</button>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="panel panel-default h-100 d-flex align-items-center justify-content-center">
                    <div class="panel-body text-center text-muted">
                        <p class="mb-2"><span class="bi bi-arrow-left" style="font-size: 2rem;"></span></p>
                        <p>@L["bookings.selectPrompt", "Select a booking from the list or create a new one"]</p>
                    </div>
                </div>
            }
        </div>

        <!-- RIGHT: Details -->
        <div class="col-md-3">
            <div class="panel panel-default h-100 d-flex flex-column">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["common.details", "Details"]</h3>
                </div>
                <div class="panel-body flex-grow-1 overflow-auto">
                    @if (selected is not null)
                    {
                        <div class="booking-summary-card">
                            <div class="booking-summary-name">@GetBookingSummaryTitle(selected)</div>
                            <div class="booking-summary-meta">@GetBookingSummaryMeta(selected)</div>
                        </div>

                        <dl class="booking-detail-grid mt-3">
                            <dt>@L["bookings.year", "Year"]</dt><dd>@selected.Year</dd>
                            <dt>@L["bookings.client", "Client"]</dt>
                            <dd>
                                @if (!string.IsNullOrWhiteSpace(selected.ClientId))
                                {
                                    <a href="/clients?selectedId=@selected.ClientId">@GetClientDisplayName(selected.ClientId)</a>
                                }
                                else { <text>-</text> }
                            </dd>
                            <dt>@L["bookings.room", "Room"]</dt>
                            <dd>
                                @if (!string.IsNullOrWhiteSpace(selected.RoomId))
                                {
                                    <a href="/rooms?selectedId=@selected.RoomId">@GetRoomDisplayName(selected.RoomId)</a>
                                }
                                else { <text>-</text> }
                            </dd>
                            <dt>@L["bookings.status", "Status"]</dt><dd>@selected.Status</dd>
                            <dt>@L["bookings.arrivalDate", "Arrival Date"]</dt><dd>@FormatDate(selected.ArrivalDate)</dd>
                            <dt>@L["bookings.departureDate", "Departure Date"]</dt><dd>@FormatDate(selected.DepartureDate)</dd>
                            <dt>@L["bookings.actualArrivalDate", "Actual Arrival Date"]</dt><dd>@FormatDate(selected.ActualArrivalDate)</dd>
                            <dt>@L["bookings.actualDepartureDate", "Actual Checkout Date"]</dt><dd>@FormatDate(selected.ActualDepartureDate)</dd>
                            <dt>@L["bookings.actualGuestCount", "Guests On Arrival"]</dt><dd>@(selected.ActualGuestCount?.ToString() ?? "-")</dd>
                            <dt>@L["bookings.prepaidAmount", "Prepaid Amount"]</dt><dd>@(selected.PrepaidAmount?.ToString("0.00") ?? "-")</dd>
                            <dt>@L["bookings.notes", "Notes"]</dt><dd>@selected.Notes</dd>
                        </dl>

                        <section class="booking-section booking-section-guest mt-3">
                            <h4 class="booking-section-title">@L["bookings.guestDetailsTitle", "Guest Details"]</h4>
                            @if (GetSelectedGuestClient() is { } guestClient)
                            {
                                <div class="booking-summary-card booking-summary-card-guest">
                                    <div class="booking-summary-name"><a class="booking-summary-link" href="@GetClientUrl(guestClient.Id)">@GetClientDisplayName(guestClient.Id)</a></div>
                                    <div class="booking-summary-meta">@GetGuestProfileSummary(guestClient)</div>
                                </div>

                                var guestFields = GetGuestDetailFields(guestClient).ToList();
                                @if (guestFields.Any())
                                {
                                    <dl class="booking-detail-grid mt-3">
                                        @foreach (var field in guestFields)
                                        {
                                            <dt>@field.Label</dt><dd>@field.Value</dd>
                                        }
                                    </dl>
                                }
                            }
                            else
                            {
                                <div class="alert alert-info mb-0">@L["bookings.unknownClient", "Unknown client"]</div>
                            }
                        </section>

                        <section class="booking-section booking-section-history mt-3">
                            <h4 class="booking-section-title">@L["bookings.guestHistoryTitle", "Other Bookings"]</h4>
                            @if (isGuestHistoryLoading)
                            {
                                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                                <span class="ms-2">@L["common.loading", "Loading..."]</span>
                            }
                            else if (selectedGuestBookings is null || !selectedGuestBookings.Any())
                            {
                                <div class="alert alert-info mb-0">@L["bookings.noGuestHistory", "No other bookings found for this guest."]</div>
                            }
                            else
                            {
                                <div class="list-group">
                                    @foreach (var booking in selectedGuestBookings.Take(5))
                                    {
                                        <a class="list-group-item list-group-item-action" href="@GetBookingUrl(booking)">
                                            <div class="fw-semibold">@GetBookingSummaryTitle(booking)</div>
                                            <div class="small text-muted">@GetBookingSummaryMeta(booking)</div>
                                        </a>
                                    }
                                </div>
                            }
                        </section>

                        <div class="d-flex flex-column gap-2 mt-3">
                            @if (!string.IsNullOrWhiteSpace(selected.ClientId))
                            {
                                <a class="btn btn-sm btn-outline-primary" href="/clients?selectedId=@selected.ClientId">@L["bookings.openClient", "Open client"]</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(selected.RoomId))
                            {
                                <a class="btn btn-sm btn-outline-primary" href="/rooms?selectedId=@selected.RoomId">@L["bookings.openRoom", "Open room"]</a>
                            }
                        </div>
                    }
                    else if (selected is null)
                    {
                        <div class="text-muted">@L["bookings.selectPrompt", "Select a booking from the list or create a new one"]</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@code {
    [SupplyParameterFromQuery(Name = "selectedId")]
    public string? SelectedId { get; set; }

    [SupplyParameterFromQuery(Name = "edit")]
    public bool? EditRequested { get; set; }

    [SupplyParameterFromQuery(Name = "roomId")]
    public string? RoomIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewQuery { get; set; }

    [SupplyParameterFromQuery(Name = "lookAheadDays")]
    public int? LookAheadDaysQuery { get; set; }

    private List<BookingDto>? records;
    private BookingDto? selected;
    private List<ClientRecord> knownClients = new();
    private List<RoomRecord> knownRooms = new();
    private List<ClientRecord> clientMatches = new();
    private List<RoomRecord> roomMatches = new();
    private List<BookingDto>? selectedGuestBookings;
    private ClientRecord? selectedClient;
    private RoomRecord? selectedRoom;
    private bool creatingNewClient;
    private string clientSearch = string.Empty;
    private string roomSearch = string.Empty;
    private bool editing, isNew;
    private bool isGuestHistoryLoading;
    private string errorMsg = "";
    private int? filterYear;
    private string listFilter = string.Empty;
    private FormModel form = new();
    private ClientFormModel clientForm = new();

    private bool CanMarkArrivedSelected
        => selected is not null
           && !isNew
           && IsPreArrivalBooking(selected);

    private bool CanCheckOutSelected
        => selected is not null
           && !isNew
           && IsCheckedInBooking(selected);

    private List<BookingDto> FilteredRecords
    {
        get
        {
            if (records is null) return new();
            if (string.IsNullOrWhiteSpace(listFilter)) return records;
            var term = listFilter.Trim();
            return records.Where(r =>
                GetClientDisplayName(r.ClientId).Contains(term, StringComparison.OrdinalIgnoreCase)
                || GetRoomDisplayName(r.RoomId).Contains(term, StringComparison.OrdinalIgnoreCase)
                || (r.Status?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || r.Year.ToString().Contains(term))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        filterYear = ActiveYearService.CurrentYear;
        knownClients = await ClientApi.GetAllAsync();
        knownRooms = await RoomApiService.GetRoomsAsync();
        await LoadAll();

        if (IsNewBookingRoute())
        {
            NewRecord();
            return;
        }

        await ApplySelectedRecordFromQueryAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await ApplySelectedRecordFromQueryAsync();
    }

    private bool IsNewBookingRoute()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        return string.Equals(relative, "bookings/new", StringComparison.OrdinalIgnoreCase);
    }

    private Task<List<BookingDto>> LoadRecordsAsync(int? year)
    {
        if (string.Equals(ViewQuery, "stays", StringComparison.OrdinalIgnoreCase))
        {
            return BookingApi.ListStaysAsync(year);
        }

        if (string.Equals(ViewQuery, "arrivals", StringComparison.OrdinalIgnoreCase))
        {
            return BookingApi.ListArrivalsAsync(year, LookAheadDaysQuery ?? 0);
        }

        if (string.Equals(ViewQuery, "departures", StringComparison.OrdinalIgnoreCase))
        {
            return BookingApi.ListDeparturesAsync(year);
        }

        if (string.Equals(ViewQuery, "reservations", StringComparison.OrdinalIgnoreCase))
        {
            return BookingApi.ListReservationsAsync(year);
        }

        return BookingApi.ListAsync(year);
    }

    private async Task LoadAll()
    {
        records = (await LoadRecordsAsync(filterYear))
            .OrderBy(booking => booking.ArrivalDate ?? DateOnly.MinValue)
            .ThenBy(booking => booking.Id, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task ApplySelectedRecordFromQueryAsync()
    {
        if (records is null || string.IsNullOrWhiteSpace(SelectedId) || IsNewBookingRoute())
        {
            return;
        }

        var record = records.FirstOrDefault(current => string.Equals(current.Id, SelectedId, StringComparison.OrdinalIgnoreCase));
        if (record is null)
        {
            records = (await LoadRecordsAsync(null)).OrderBy(booking => booking.ArrivalDate ?? DateOnly.MinValue)
                .ThenBy(booking => booking.Id, StringComparer.OrdinalIgnoreCase)
                .ToList();
            record = records.FirstOrDefault(current => string.Equals(current.Id, SelectedId, StringComparison.OrdinalIgnoreCase));
            if (record is null)
            {
                return;
            }
        }

        SelectRecord(record);
        await EditSelected();
    }
    private async Task ApplyFilter() => await LoadAll();

    private void NewRecord()
    {
        form = new()
        {
            Year = filterYear ?? ActiveYearService.CurrentYear,
            RoomId = RoomIdQuery
        };
        isNew = true;
        editing = true;
        selected = null;
        errorMsg = "";
        ResetClientSelection();
        InitializeRoomSelectionForCurrentForm();
    }

    private async Task SelectRecordAndEdit(BookingDto r)
    {
        selected = r;
        await LoadSelectedGuestHistoryAsync();
        await EditSelected();
    }

    private void SelectRecord(BookingDto r)
    {
        selected = r;
        editing = false;
    }

    private async Task EditSelected()
    {
        await LoadSelectedGuestHistoryAsync();
        if (selected is null) return;
        form = new()
        {
            Year = selected.Year,
            ClientId = selected.ClientId,
            RoomId = selected.RoomId,
            Status = selected.Status,
            ArrivalDate = selected.ArrivalDate,
            DepartureDate = selected.DepartureDate,
            Notes = selected.Notes,
            ActualArrivalDate = selected.ActualArrivalDate,
            ActualDepartureDate = selected.ActualDepartureDate,
            ActualGuestCount = selected.ActualGuestCount,
            PrepaidAmount = selected.PrepaidAmount
        };
        isNew = false;
        editing = true;
        errorMsg = "";
        await InitializeClientSelectionForEdit();
        InitializeRoomSelectionForCurrentForm();
    }

    private async Task Save()
    {
        if (form.ArrivalDate.HasValue)
        {
            form.Year = form.ArrivalDate.Value.Year;
        }
        if (form.Year == 0) { errorMsg = L["bookings.yearRequired", "Year is required."]; return; }
        if (!form.ActualGuestCount.HasValue || form.ActualGuestCount.Value <= 0)
        {
            form.ActualGuestCount = null;
        }
        if (selectedRoom is not null)
        {
            form.RoomId = selectedRoom.Id;
        }
        if (string.IsNullOrWhiteSpace(form.RoomId)) { errorMsg = L["bookings.roomRequired", "Room is required."]; return; }
        if (!form.ArrivalDate.HasValue) { errorMsg = L["bookings.arrivalRequired", "Arrival Date is required."]; return; }
        if (!form.DepartureDate.HasValue) { errorMsg = L["bookings.departureRequired", "Departure Date is required."]; return; }
        if (form.DepartureDate.Value <= form.ArrivalDate.Value) { errorMsg = L["bookings.departureAfterArrival", "Departure Date must be after Arrival Date."]; return; }
        if (form.ActualArrivalDate.HasValue && !form.ActualGuestCount.HasValue) { errorMsg = L["bookings.actualGuestCountRequiredWithArrival", "Guests On Arrival is required when Actual Arrival Date is set."]; return; }
        if (form.ActualGuestCount.HasValue && !form.ActualArrivalDate.HasValue) { errorMsg = L["bookings.actualArrivalRequiredWithGuestCount", "Actual Arrival Date is required when Guests On Arrival is set."]; return; }
        if (form.ActualGuestCount.HasValue && form.ActualGuestCount.Value <= 0) { errorMsg = L["bookings.actualGuestCountPositive", "Guests On Arrival must be greater than zero."]; return; }
        if (form.ActualArrivalDate.HasValue && form.DepartureDate.HasValue && form.ActualArrivalDate.Value >= form.DepartureDate.Value) { errorMsg = L["bookings.actualArrivalBeforeDeparture", "Actual Arrival Date must be before Departure Date."]; return; }
        if (form.ActualDepartureDate.HasValue && !form.ActualArrivalDate.HasValue) { errorMsg = L["bookings.actualArrivalRequiredWithDeparture", "Actual Arrival Date is required when Actual Checkout Date is set."]; return; }
        if (form.ActualDepartureDate.HasValue && form.DepartureDate.HasValue && form.ActualDepartureDate.Value > form.DepartureDate.Value) { errorMsg = L["bookings.actualDepartureAfterPlanned", "Actual Checkout Date cannot be after Departure Date."]; return; }
        if (form.ActualDepartureDate.HasValue && form.ActualArrivalDate.HasValue && form.ActualDepartureDate.Value < form.ActualArrivalDate.Value) { errorMsg = L["bookings.actualDepartureBeforeArrival", "Actual Checkout Date must be on or after Actual Arrival Date."]; return; }
        if (form.PrepaidAmount.HasValue && form.PrepaidAmount.Value < 0) { errorMsg = L["bookings.prepaidAmountNonNegative", "Prepaid Amount must be greater than or equal to zero."]; return; }

        var bookingClientId = await ResolveClientIdForSave();
        if (string.IsNullOrWhiteSpace(bookingClientId))
        {
            return;
        }

        var dto = new BookingDto(
            selected?.Id,
            form.Year,
            bookingClientId,
            form.RoomId,
            form.ArrivalDate,
            form.DepartureDate,
            form.Status,
            form.Notes,
            form.ActualArrivalDate,
            form.ActualGuestCount,
            form.PrepaidAmount,
            form.ActualDepartureDate);
        try
        {
            if (isNew) await BookingApi.CreateAsync(dto);
            else await BookingApi.UpdateAsync(selected!.Year, selected.Id!, dto);
            editing = false;
            await LoadAll();
            await RefreshKnownClients();
        }
        catch (Exception ex) { errorMsg = TranslateBookingSaveError(ex); }
    }

    private void Cancel()
    {
        editing = false;
        errorMsg = "";
        ResetClientSelection();
        ResetRoomSelection();
    }

    private async Task CancelBooking()
    {
        if (selected?.Id is null) return;
        try { await BookingApi.CancelAsync(selected.Year, selected.Id); selected = null; await LoadAll(); }
        catch { errorMsg = L["bookings.cancelFailed", "Cancel failed."]; }
    }

    private async Task CheckInSelected()
    {
        if (selected?.Id is null)
        {
            return;
        }

        var actualArrival = form.ActualArrivalDate ?? DateOnly.FromDateTime(DateTime.UtcNow);
        var actualGuestCount = form.ActualGuestCount ?? 1;
        if (actualGuestCount <= 0)
        {
            errorMsg = L["bookings.actualGuestCountPositive", "Guests On Arrival must be greater than zero."];
            return;
        }

        try
        {
            await BookingApi.CheckInAsync(selected.Year, selected.Id, new BookingCheckInRequest(actualArrival, actualGuestCount, "CheckedIn"));
            editing = false;
            await LoadAll();
        }
        catch (Exception ex)
        {
            errorMsg = TranslateBookingSaveError(ex);
        }
    }

    private async Task CheckOutSelected()
    {
        if (selected?.Id is null)
        {
            return;
        }

        var checkoutDate = form.ActualDepartureDate ?? DateOnly.FromDateTime(DateTime.UtcNow);
        try
        {
            await BookingApi.CheckOutAsync(selected.Year, selected.Id, new BookingCheckOutRequest(checkoutDate, "CheckedOut"));
            editing = false;
            await LoadAll();
        }
        catch (Exception ex)
        {
            errorMsg = TranslateBookingSaveError(ex);
        }
    }

    private async Task MarkNoShowSelected()
    {
        if (selected?.Id is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(form.Notes))
        {
            errorMsg = L["bookings.noShowNotesRequired", "Notes are required for no-show."];
            return;
        }

        try
        {
            await BookingApi.MarkNoShowAsync(selected.Year, selected.Id, new BookingNoShowRequest(form.Notes, "NoShow"));
            editing = false;
