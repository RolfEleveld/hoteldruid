    private string TranslateBookingSaveError(Exception ex)
    {
        return ex.Message switch
        {
            "Year is required" => L["bookings.yearRequired", "Year is required."],
            "ClientId is required" => L["bookings.clientRequired", "Select an existing client or enter new client details."],
            "ArrivalDate is required" => L["bookings.arrivalRequired", "Arrival Date is required."],
            "DepartureDate is required" => L["bookings.departureRequired", "Departure Date is required."],
            "DepartureDate must be after ArrivalDate" => L["bookings.departureAfterArrival", "Departure Date must be after Arrival Date."],
            "PrepaidAmount must be greater than or equal to zero" => L["bookings.prepaidAmountNonNegative", "Prepaid Amount must be greater than or equal to zero."],
            "ActualGuestCount is required when ActualArrivalDate is provided" => L["bookings.actualGuestCountRequiredWithArrival", "Guests On Arrival is required when Actual Arrival Date is set."],
            "ActualArrivalDate is required when ActualGuestCount is provided" => L["bookings.actualArrivalRequiredWithGuestCount", "Actual Arrival Date is required when Guests On Arrival is set."],
            "ActualGuestCount must be greater than zero" => L["bookings.actualGuestCountPositive", "Guests On Arrival must be greater than zero."],
            "ActualArrivalDate must be before DepartureDate" => L["bookings.actualArrivalBeforeDeparture", "Actual Arrival Date must be before Departure Date."],
            "ActualArrivalDate is required when ActualDepartureDate is provided" => L["bookings.actualArrivalRequiredWithDeparture", "Actual Arrival Date is required when Actual Checkout Date is set."],
            "ActualDepartureDate cannot be after DepartureDate" => L["bookings.actualDepartureAfterPlanned", "Actual Checkout Date cannot be after Departure Date."],
            "ActualDepartureDate must be on or after ActualArrivalDate" => L["bookings.actualDepartureBeforeArrival", "Actual Checkout Date must be on or after Actual Arrival Date."],
            "ActualArrivalDate is required" => L["bookings.actualArrivalRequiredWithGuestCount", "Actual Arrival Date is required when Guests On Arrival is set."],
            "ActualArrivalDate is required when checking out" => L["bookings.actualArrivalRequiredWithDeparture", "Actual Arrival Date is required when Actual Checkout Date is set."],
            "Cannot check in a booking that is already checked out" => L["bookings.alreadyCheckedOut", "Booking is already checked out."],
            "Cannot mark no-show after check-in" => L["bookings.noShowAfterCheckIn", "Cannot mark no-show after check-in."],
            "Notes are required for no-show" => L["bookings.noShowNotesRequired", "Notes are required for no-show."],
            _ when !string.IsNullOrWhiteSpace(ex.Message) => L["bookings.saveFailedStatus", ex.Message],
            _ => L["bookings.saveFailed", "Save failed."]
        };
    }

    private static string ClientDisplayName(ClientRecord client)
    {
        var fullName = string.Join(" ", new[] { client.LastName, client.FirstName }.Where(x => !string.IsNullOrWhiteSpace(x)));
        return string.IsNullOrWhiteSpace(fullName) ? "Unknown client" : fullName;
    }

