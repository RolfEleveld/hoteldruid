@page "/bookings"
@page "/bookings/new"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components
@using HotelDruid.Client.Services
@using HotelDruid.Shared
@using ClientRecord = HotelDruid.Client.Services.ClientDto
@using RoomRecord = HotelDruid.Client.Services.RoomDto
@inject IBookingApiService BookingApi
@inject IClientApiService ClientApi
@inject IRoomApiService RoomApiService
@inject IActiveYearService ActiveYearService
@inject NavigationManager Navigation

@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["bookings.title", "Bookings"]</PageTitle>
<div class="container-fluid">
    <div class="row align-items-center mb-2 mt-2">
        <div class="col-auto"><h5 class="mb-0">@L["bookings.header", "Bookings"]</h5></div>
        <div class="col-auto">
            <label class="me-1">@L["bookings.filterYear", "Year"]:</label>
            <input class="form-control d-inline-block" type="number" @bind="filterYear" style="width:90px" />
            <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="ApplyFilter">@L["bookings.load", "Load"]</button>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 border-end">
            <button class="btn btn-sm btn-primary mb-2" @onclick="NewRecord">+ @L["bookings.new", "New"]</button>
            @if (records is null) { <p><em>@L["common.loading", "Loading..."]</em></p> }
            else if (records.Count == 0) { <p class="text-muted">@L["bookings.emptyList", "No bookings"]</p> }
            else
            {
                <ul class="list-group">
                    @foreach (var r in records)
                    {
                        <li class="list-group-item list-group-item-action @(selected?.Id == r.Id ? "active" : "")"
                            style="cursor:pointer" @onclick="() => SelectRecord(r)">
                            <div class="fw-bold">@r.Year — @GetClientDisplayName(r.ClientId)</div>
                            <small>@FormatDate(r.ArrivalDate) → @FormatDate(r.DepartureDate) (@r.Status)</small>
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="col-md-6 border-end">
            @if (editing)
            {
                <h5 class="mt-1">@(isNew ? L["bookings.newBooking", "New Booking"] : L["bookings.editBooking", "Edit Booking"])</h5>
                <div class="row g-2">
                    <div class="col-6"><label>@L["bookings.year", "Year"] *</label><input class="form-control" type="number" @bind="form.Year" /></div>
                    <div class="col-6"><label>@L["bookings.roomSearchLabel", "Find room"] *</label><input class="form-control" value="@roomSearch" placeholder="@L["bookings.roomSearchPlaceholder", "Type room name or ID"]" @oninput="OnRoomSearchChanged" /></div>

                    @if (roomMatches.Count > 0)
                    {
                        <div class="col-12">
                            <div class="list-group">
                                @foreach (var room in roomMatches)
                                {
                                    <button type="button" class="list-group-item list-group-item-action" @onclick="() => SelectRoom(room)">
                                        <div class="fw-semibold">@GetRoomDisplayName(room.Id)</div>
                                        <small class="text-muted">@L["bookings.room", "Room"]: @GetRoomDisplayName(room.Id) · @L["rooms.capacityLabel", "Capacity"]: @room.Capacity</small>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (selectedRoom is not null)
                    {
                        <div class="col-12">
                            <div class="border rounded p-2 bg-light-subtle">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@GetRoomDisplayName(selectedRoom.Id)</div>
                                        <small class="text-muted">@L["bookings.room", "Room"]: @GetRoomDisplayName(selectedRoom.Id) · @L["rooms.capacityLabel", "Capacity"]: @selectedRoom.Capacity</small>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearRoomSelection">@L["bookings.clearSelection", "Clear"]</button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (selectedRoom is null && !string.IsNullOrWhiteSpace(roomSearch))
                    {
                        <div class="col-12">
                            <div class="text-muted small">@L["bookings.noRoomMatch", "No room matches this search."]</div>
                        </div>
                    }

                    <div class="col-6"><label>@L["bookings.status", "Status"]</label><input class="form-control" @bind="form.Status" /></div>
                    <div class="col-6"><label>@L["bookings.arrivalDate", "Arrival Date"]</label><input class="form-control" type="date" @bind="form.ArrivalDate" /></div>
                    <div class="col-6"><label>@L["bookings.departureDate", "Departure Date"]</label><input class="form-control" type="date" @bind="form.DepartureDate" /></div>
                    <div class="col-6"><label>@L["bookings.actualArrivalDateOptional", "Actual Arrival Date (optional)"]</label><input class="form-control" type="date" @bind="form.ActualArrivalDate" /></div>
                    <div class="col-6"><label>@L["bookings.actualGuestCount", "Guests On Arrival"]</label><input class="form-control" type="number" min="1" @bind="form.ActualGuestCount" /></div>
                    <div class="col-6"><label>@L["bookings.prepaidAmount", "Prepaid Amount"]</label><input class="form-control" type="number" min="0" step="0.01" @bind="form.PrepaidAmount" /></div>
                    <div class="col-12"><label>@L["bookings.notes", "Notes"]</label><input class="form-control" @bind="form.Notes" /></div>

                    <div class="col-12 mt-3">
                        <h6 class="text-muted mb-2">@L["bookings.client", "Client"]</h6>
                    </div>
                    <div class="col-12">
                        <label>@L["bookings.clientSearchLabel", "Find existing client"]</label>
                        <input class="form-control"
                               value="@clientSearch"
                               placeholder="@L["bookings.clientSearchPlaceholder", "Type last name, first name, email, or phone"]"
                               @oninput="OnClientSearchChanged" />
                    </div>

                    @if (clientMatches.Count > 0)
                    {
                        <div class="col-12">
                            <div class="list-group">
                                @foreach (var client in clientMatches)
                                {
                                    <button type="button" class="list-group-item list-group-item-action" @onclick="() => SelectClient(client)">
                                        <div class="fw-semibold">@ClientDisplayName(client)</div>
                                        <small class="text-muted">@client.Email @client.Phone @client.City</small>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (selectedClient is not null)
                    {
                        <div class="col-12">
                            <div class="border rounded p-2 bg-light-subtle">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@ClientDisplayName(selectedClient)</div>
                                        <small class="text-muted">@selectedClient.Email · @selectedClient.Phone</small>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearClientSelection">@L["bookings.clearSelection", "Clear"]</button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (selectedClient is null && !creatingNewClient && !string.IsNullOrWhiteSpace(clientSearch))
                    {
                        <div class="col-12">
                            <div class="text-muted small">@L["bookings.noClientMatch", "No existing client matches this search."]</div>
                            <button type="button" class="btn btn-sm btn-outline-primary mt-1" @onclick="EnableInlineClientCreate">@L["bookings.createClientInline", "Enter new client details"]</button>
                        </div>
                    }

                    @if (creatingNewClient)
                    {
                        <div class="col-12 mt-2">
                            <div class="border rounded p-3">
                                <div class="row g-2">
                                    <div class="col-6"><label>@L["bookings.clientLastName", "Last Name"] *</label><input class="form-control" @bind="clientForm.LastName" /></div>
                                    <div class="col-6"><label>@L["bookings.clientFirstName", "First Name"]</label><input class="form-control" @bind="clientForm.FirstName" /></div>
                                    <div class="col-6"><label>@L["bookings.clientNickname", "Nickname"]</label><input class="form-control" @bind="clientForm.Nickname" /></div>
                                    <div class="col-6"><label>@L["bookings.clientLanguage", "Language"]</label><input class="form-control" @bind="clientForm.Language" /></div>
                                    <div class="col-6"><label>@L["bookings.clientPhone", "Phone"]</label><input class="form-control" @bind="clientForm.Phone" /></div>
                                    <div class="col-6"><label>@L["bookings.clientEmail", "Email"]</label><input class="form-control" @bind="clientForm.Email" /></div>
                                    <div class="col-6"><label>@L["bookings.clientNation", "Nation"]</label><input class="form-control" @bind="clientForm.Nation" /></div>
                                    <div class="col-6"><label>@L["bookings.clientCity", "City"]</label><input class="form-control" @bind="clientForm.City" /></div>
                                    <div class="col-6"><label>@L["bookings.clientDocumentType", "Document Type"]</label><input class="form-control" @bind="clientForm.DocumentType" /></div>
                                    <div class="col-6"><label>@L["bookings.clientDocumentNumber", "Document Number"]</label><input class="form-control" @bind="clientForm.DocumentNumber" /></div>
                                    <div class="col-6"><label>@L["bookings.clientTaxCode", "Tax Code"]</label><input class="form-control" @bind="clientForm.TaxCode" /></div>
                                    <div class="col-6"><label>@L["bookings.clientVatNumber", "VAT Number"]</label><input class="form-control" @bind="clientForm.VatNumber" /></div>
                                    <div class="col-12"><label>@L["bookings.notes", "Notes"]</label><input class="form-control" @bind="clientForm.Notes" /></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(errorMsg)) { <div class="alert alert-danger mt-2">@errorMsg</div> }
                <div class="mt-3">
                    <button class="btn btn-primary me-2" @onclick="Save">@L["common.save", "Save"]</button>
                    <button class="btn btn-secondary" @onclick="Cancel">@L["common.cancel", "Cancel"]</button>
                </div>
            }
        </div>
        <div class="col-md-3">
            @if (selected is not null && !editing)
            {
                <h5 class="mt-1">@L["common.details"]</h5>
                <dl>
                    <dt>@L["bookings.year", "Year"]</dt><dd>@selected.Year</dd>
                    <dt>@L["bookings.client", "Client"]</dt><dd>@GetClientDisplayName(selected.ClientId)</dd>
                    <dt>@L["bookings.room", "Room"]</dt><dd>@GetRoomDisplayName(selected.RoomId)</dd>
                    <dt>@L["bookings.status", "Status"]</dt><dd>@selected.Status</dd>
                    <dt>@L["bookings.arrivalDate", "Arrival Date"]</dt><dd>@FormatDate(selected.ArrivalDate)</dd>
                    <dt>@L["bookings.departureDate", "Departure Date"]</dt><dd>@FormatDate(selected.DepartureDate)</dd>
                    <dt>@L["bookings.actualArrivalDate", "Actual Arrival Date"]</dt><dd>@FormatDate(selected.ActualArrivalDate)</dd>
                    <dt>@L["bookings.actualGuestCount", "Guests On Arrival"]</dt><dd>@(selected.ActualGuestCount?.ToString() ?? "-")</dd>
                    <dt>@L["bookings.prepaidAmount", "Prepaid Amount"]</dt><dd>@(selected.PrepaidAmount?.ToString("0.00") ?? "-")</dd>
                    <dt>@L["bookings.notes", "Notes"]</dt><dd>@selected.Notes</dd>
                </dl>
                <button class="btn btn-sm btn-outline-primary me-1" @onclick="EditSelected">@L["bookings.editBooking", "Edit Booking"]</button>
                <button class="btn btn-sm btn-outline-warning me-1" @onclick="CancelBooking">@L["bookings.cancelBooking", "Cancel Booking"]</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="DeleteSelected">@L["common.delete", "Delete"]</button>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "selectedId")]
    public string? SelectedId { get; set; }

    [SupplyParameterFromQuery(Name = "edit")]
    public bool? EditRequested { get; set; }

    [SupplyParameterFromQuery(Name = "roomId")]
    public string? RoomIdQuery { get; set; }

    private List<BookingDto>? records;
    private BookingDto? selected;
    private List<ClientRecord> knownClients = new();
    private List<RoomRecord> knownRooms = new();
    private List<ClientRecord> clientMatches = new();
    private List<RoomRecord> roomMatches = new();
    private ClientRecord? selectedClient;
    private RoomRecord? selectedRoom;
    private bool creatingNewClient;
    private string clientSearch = string.Empty;
    private string roomSearch = string.Empty;
    private bool editing, isNew;
    private string errorMsg = "";
    private int? filterYear;
    private FormModel form = new();
    private ClientFormModel clientForm = new();

    protected override async Task OnInitializedAsync()
    {
        filterYear = ActiveYearService.CurrentYear;
        knownClients = await ClientApi.GetAllAsync();
        knownRooms = await RoomApiService.GetRoomsAsync();
        await LoadAll();

        if (IsNewBookingRoute())
        {
            NewRecord();
            return;
        }

        await ApplySelectedRecordFromQueryAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await ApplySelectedRecordFromQueryAsync();
    }

    private bool IsNewBookingRoute()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        return string.Equals(relative, "bookings/new", StringComparison.OrdinalIgnoreCase);
    }

    private async Task LoadAll()
    {
        records = (await BookingApi.ListAsync(filterYear))
            .OrderBy(booking => booking.ArrivalDate ?? DateOnly.MinValue)
            .ThenBy(booking => booking.Id, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task ApplySelectedRecordFromQueryAsync()
    {
        if (records is null || string.IsNullOrWhiteSpace(SelectedId) || IsNewBookingRoute())
        {
            return;
        }

        var record = records.FirstOrDefault(current => string.Equals(current.Id, SelectedId, StringComparison.OrdinalIgnoreCase));
        if (record is null)
        {
            return;
        }

        SelectRecord(record);
        if (EditRequested == true)
        {
            await EditSelected();
        }
    }
    private async Task ApplyFilter() => await LoadAll();

    private void NewRecord()
    {
        form = new()
        {
            Year = filterYear ?? ActiveYearService.CurrentYear,
            RoomId = RoomIdQuery
        };
        isNew = true;
        editing = true;
        selected = null;
        errorMsg = "";
        ResetClientSelection();
        InitializeRoomSelectionForCurrentForm();
    }

    private void SelectRecord(BookingDto r) { selected = r; editing = false; }

    private async Task EditSelected()
    {
        if (selected is null) return;
        form = new()
        {
            Year = selected.Year,
            ClientId = selected.ClientId,
            RoomId = selected.RoomId,
            Status = selected.Status,
            ArrivalDate = selected.ArrivalDate,
            DepartureDate = selected.DepartureDate,
            Notes = selected.Notes,
            ActualArrivalDate = selected.ActualArrivalDate,
            ActualGuestCount = selected.ActualGuestCount,
            PrepaidAmount = selected.PrepaidAmount
        };
        isNew = false;
        editing = true;
        errorMsg = "";
        await InitializeClientSelectionForEdit();
        InitializeRoomSelectionForCurrentForm();
    }

    private async Task Save()
    {
        if (form.ArrivalDate.HasValue)
        {
            form.Year = form.ArrivalDate.Value.Year;
        }
        if (form.Year == 0) { errorMsg = L["bookings.yearRequired", "Year is required."]; return; }
        if (!form.ActualGuestCount.HasValue || form.ActualGuestCount.Value <= 0)
        {
            form.ActualGuestCount = null;
        }
        if (selectedRoom is not null)
        {
            form.RoomId = selectedRoom.Id;
        }
        if (string.IsNullOrWhiteSpace(form.RoomId)) { errorMsg = L["bookings.roomRequired", "Room is required."]; return; }
        if (!form.ArrivalDate.HasValue) { errorMsg = L["bookings.arrivalRequired", "Arrival Date is required."]; return; }
        if (!form.DepartureDate.HasValue) { errorMsg = L["bookings.departureRequired", "Departure Date is required."]; return; }
        if (form.DepartureDate.Value <= form.ArrivalDate.Value) { errorMsg = L["bookings.departureAfterArrival", "Departure Date must be after Arrival Date."]; return; }
        if (form.ActualArrivalDate.HasValue && !form.ActualGuestCount.HasValue) { errorMsg = L["bookings.actualGuestCountRequiredWithArrival", "Guests On Arrival is required when Actual Arrival Date is set."]; return; }
        if (form.ActualGuestCount.HasValue && !form.ActualArrivalDate.HasValue) { errorMsg = L["bookings.actualArrivalRequiredWithGuestCount", "Actual Arrival Date is required when Guests On Arrival is set."]; return; }
        if (form.ActualGuestCount.HasValue && form.ActualGuestCount.Value <= 0) { errorMsg = L["bookings.actualGuestCountPositive", "Guests On Arrival must be greater than zero."]; return; }
        if (form.ActualArrivalDate.HasValue && form.DepartureDate.HasValue && form.ActualArrivalDate.Value >= form.DepartureDate.Value) { errorMsg = L["bookings.actualArrivalBeforeDeparture", "Actual Arrival Date must be before Departure Date."]; return; }
        if (form.PrepaidAmount.HasValue && form.PrepaidAmount.Value < 0) { errorMsg = L["bookings.prepaidAmountNonNegative", "Prepaid Amount must be greater than or equal to zero."]; return; }

        var bookingClientId = await ResolveClientIdForSave();
        if (string.IsNullOrWhiteSpace(bookingClientId))
        {
            return;
        }

        var dto = new BookingDto(
            selected?.Id,
            form.Year,
            bookingClientId,
            form.RoomId,
            form.ArrivalDate,
            form.DepartureDate,
            form.Status,
            form.Notes,
            form.ActualArrivalDate,
            form.ActualGuestCount,
            form.PrepaidAmount);
        try
        {
            if (isNew) await BookingApi.CreateAsync(dto);
            else await BookingApi.UpdateAsync(selected!.Year, selected.Id!, dto);
            editing = false;
            await LoadAll();
            await RefreshKnownClients();
        }
        catch (Exception ex) { errorMsg = TranslateBookingSaveError(ex); }
    }

    private void Cancel()
    {
        editing = false;
        errorMsg = "";
        ResetClientSelection();
        ResetRoomSelection();
    }

    private async Task CancelBooking()
    {
        if (selected?.Id is null) return;
        try { await BookingApi.CancelAsync(selected.Year, selected.Id); selected = null; await LoadAll(); }
        catch { errorMsg = L["bookings.cancelFailed", "Cancel failed."]; }
    }

    private async Task DeleteSelected()
    {
        if (selected?.Id is null) return;
        try { await BookingApi.DeleteAsync(selected.Year, selected.Id); selected = null; await LoadAll(); }
        catch { errorMsg = L["bookings.deleteFailed", "Delete failed."]; }
    }

    private async Task OnClientSearchChanged(ChangeEventArgs args)
    {
        clientSearch = args.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(clientSearch))
        {
            clientMatches.Clear();
            if (selectedClient is null)
            {
                form.ClientId = null;
            }
            return;
        }

        var term = clientSearch.Trim();
        clientMatches = knownClients
            .Where(c => ContainsClientSearch(c, term))
            .OrderBy(c => c.LastName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(c => c.FirstName, StringComparer.OrdinalIgnoreCase)
            .Take(8)
            .ToList();
    }

    private void SelectClient(ClientRecord client)
    {
        selectedClient = client;
        form.ClientId = client.Id;
        creatingNewClient = false;
        clientForm = new();
        clientSearch = ClientDisplayName(client);
        clientMatches.Clear();
    }

    private void ClearClientSelection()
    {
        selectedClient = null;
        form.ClientId = null;
        clientSearch = string.Empty;
        clientMatches.Clear();
    }

    private async Task OnRoomSearchChanged(ChangeEventArgs args)
    {
        roomSearch = args.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(roomSearch))
        {
            roomMatches.Clear();
            if (selectedRoom is null)
            {
                form.RoomId = null;
            }
            return;
        }

        var term = roomSearch.Trim();
        roomMatches = knownRooms
            .Where(r => ContainsRoomSearch(r, term))
            .OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => r.Id, StringComparer.OrdinalIgnoreCase)
            .Take(8)
            .ToList();
    }

    private void SelectRoom(RoomRecord room)
    {
        selectedRoom = room;
        form.RoomId = room.Id;
        roomSearch = string.IsNullOrWhiteSpace(room.Name) ? room.Id : room.Name;
        roomMatches.Clear();
    }

    private void ClearRoomSelection()
    {
        selectedRoom = null;
        form.RoomId = null;
        roomSearch = string.Empty;
        roomMatches.Clear();
    }

    private void EnableInlineClientCreate()
    {
        creatingNewClient = true;
        selectedClient = null;
        form.ClientId = null;
        clientMatches.Clear();
    }

    private async Task RefreshKnownClients()
    {
        knownClients = await ClientApi.GetAllAsync();
    }

    private async Task InitializeClientSelectionForEdit()
    {
        selectedClient = null;
        creatingNewClient = false;
        clientForm = new();
        clientMatches.Clear();
        clientSearch = string.Empty;

        if (string.IsNullOrWhiteSpace(form.ClientId))
        {
            return;
        }

        selectedClient = knownClients.FirstOrDefault(c => string.Equals(c.Id, form.ClientId, StringComparison.OrdinalIgnoreCase));
        if (selectedClient is null)
        {
            selectedClient = await ClientApi.GetByIdAsync(form.ClientId);
            if (selectedClient is not null)
            {
                knownClients.Add(selectedClient);
            }
        }

        if (selectedClient is not null)
        {
            clientSearch = ClientDisplayName(selectedClient);
        }
    }

    private void InitializeRoomSelectionForCurrentForm()
    {
        selectedRoom = null;
        roomMatches.Clear();
        roomSearch = string.Empty;

        if (string.IsNullOrWhiteSpace(form.RoomId))
        {
            return;
        }

        selectedRoom = knownRooms.FirstOrDefault(room => string.Equals(room.Id, form.RoomId, StringComparison.OrdinalIgnoreCase));
        if (selectedRoom is not null)
        {
            roomSearch = string.IsNullOrWhiteSpace(selectedRoom.Name) ? selectedRoom.Id : selectedRoom.Name;
            return;
        }

        roomSearch = form.RoomId;
    }

    private async Task<string?> ResolveClientIdForSave()
    {
        if (!string.IsNullOrWhiteSpace(selectedClient?.Id))
        {
            return selectedClient.Id;
        }

        if (!string.IsNullOrWhiteSpace(form.ClientId))
        {
            return form.ClientId;
        }

        if (creatingNewClient)
        {
            if (string.IsNullOrWhiteSpace(clientForm.LastName))
            {
                errorMsg = L["bookings.clientLastNameRequired", "Last Name is required for a new client."];
                return null;
            }

            try
            {
                var createdClientId = await ClientApi.CreateAsync(new ClientRecord(
                    null,
                    clientForm.LastName,
                    clientForm.FirstName,
                    clientForm.Nickname,
                    null,
                    null,
                    clientForm.Language,
                    null,
                    null,
                    null,
                    null,
                    clientForm.DocumentNumber,
                    null,
                    clientForm.DocumentType,
                    null,
                    null,
                    null,
                    null,
                    clientForm.Nation,
                    null,
                    clientForm.City,
                    null,
                    null,
                    clientForm.Phone,
                    null,
                    null,
                    clientForm.Email,
                    null,
                    null,
                    clientForm.TaxCode,
                    clientForm.VatNumber,
                    clientForm.Notes));

                if (string.IsNullOrWhiteSpace(createdClientId))
                {
                    errorMsg = L["bookings.clientCreateFailed", "Failed to create client."];
                    return null;
                }

                form.ClientId = createdClientId;
                await RefreshKnownClients();
                selectedClient = knownClients.FirstOrDefault(c => string.Equals(c.Id, createdClientId, StringComparison.OrdinalIgnoreCase));
                if (selectedClient is not null)
                {
                    clientSearch = ClientDisplayName(selectedClient);
                }

                return createdClientId;
            }
            catch
            {
                errorMsg = L["bookings.clientCreateFailed", "Failed to create client."];
                return null;
            }
        }

        errorMsg = L["bookings.clientRequired", "Select an existing client or enter new client details."];
        return null;
    }

    private void ResetClientSelection()
    {
        selectedClient = null;
        creatingNewClient = false;
        clientSearch = string.Empty;
        clientMatches.Clear();
        clientForm = new();
    }

    private void ResetRoomSelection()
    {
        selectedRoom = null;
        roomSearch = string.Empty;
        roomMatches.Clear();
    }

    private static bool ContainsClientSearch(ClientRecord client, string term)
    {
        return (!string.IsNullOrWhiteSpace(client.LastName) && client.LastName.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(client.FirstName) && client.FirstName.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(client.Email) && client.Email.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(client.Phone) && client.Phone.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(client.Id) && client.Id.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private static bool ContainsRoomSearch(RoomRecord room, string term)
    {
        return (!string.IsNullOrWhiteSpace(room.Name) && room.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(room.Id) && room.Id.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private string GetClientDisplayName(string? clientId)
    {
        if (string.IsNullOrWhiteSpace(clientId))
        {
            return L["bookings.unknownClient", "Unknown client"];
        }

        var client = knownClients.FirstOrDefault(current => string.Equals(current.Id, clientId, StringComparison.OrdinalIgnoreCase));
        return client is null ? L["bookings.unknownClient", "Unknown client"] : ClientDisplayName(client);
    }

    private string GetRoomDisplayName(string? roomId)
    {
        if (string.IsNullOrWhiteSpace(roomId))
        {
            return L["bookings.unassignedRoom", "Unassigned room"];
        }

        var room = knownRooms.FirstOrDefault(current => string.Equals(current.Id, roomId, StringComparison.OrdinalIgnoreCase));
        if (room is null)
        {
            return L["bookings.unknownRoom", "Unknown room"];
        }

        return string.IsNullOrWhiteSpace(room.Name) ? L["bookings.unknownRoom", "Unknown room"] : room.Name;
    }

    private string TranslateBookingSaveError(Exception ex)
    {
        return ex.Message switch
        {
            "Year is required" => L["bookings.yearRequired", "Year is required."],
            "ClientId is required" => L["bookings.clientRequired", "Select an existing client or enter new client details."],
            "ArrivalDate is required" => L["bookings.arrivalRequired", "Arrival Date is required."],
            "DepartureDate is required" => L["bookings.departureRequired", "Departure Date is required."],
            "DepartureDate must be after ArrivalDate" => L["bookings.departureAfterArrival", "Departure Date must be after Arrival Date."],
            "PrepaidAmount must be greater than or equal to zero" => L["bookings.prepaidAmountNonNegative", "Prepaid Amount must be greater than or equal to zero."],
            "ActualGuestCount is required when ActualArrivalDate is provided" => L["bookings.actualGuestCountRequiredWithArrival", "Guests On Arrival is required when Actual Arrival Date is set."],
            "ActualArrivalDate is required when ActualGuestCount is provided" => L["bookings.actualArrivalRequiredWithGuestCount", "Actual Arrival Date is required when Guests On Arrival is set."],
            "ActualGuestCount must be greater than zero" => L["bookings.actualGuestCountPositive", "Guests On Arrival must be greater than zero."],
            "ActualArrivalDate must be before DepartureDate" => L["bookings.actualArrivalBeforeDeparture", "Actual Arrival Date must be before Departure Date."],
            _ when !string.IsNullOrWhiteSpace(ex.Message) => L["bookings.saveFailedStatus", ex.Message],
            _ => L["bookings.saveFailed", "Save failed."]
        };
    }

    private static string ClientDisplayName(ClientRecord client)
    {
        var fullName = string.Join(" ", new[] { client.LastName, client.FirstName }.Where(x => !string.IsNullOrWhiteSpace(x)));
        return string.IsNullOrWhiteSpace(fullName) ? "Unknown client" : fullName;
    }

