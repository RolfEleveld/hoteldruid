@page "/bookings"
@page "/bookings/new"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.DependencyInjection
@using HotelDruid.Client.Services
@using HotelDruid.Shared
@using HotelDruid.Shared.Configuration
@using ClientRecord = HotelDruid.Client.Services.ClientDto
@using RoomRecord = HotelDruid.Client.Services.RoomDto
@inject IBookingApiService BookingApi
@inject IBookingFinanceApiService FinanceApi
@inject IClientApiService ClientApi
@inject IRoomApiService RoomApiService
@inject ITariffApiService TariffApi
@inject NavigationManager Navigation
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JS

@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["bookings.title", "Bookings"]</PageTitle>
<div class="container-fluid bookings-manager">
    <div class="row g-3 h-100">
        <!-- LEFT: Bookings List -->
        <div class="col-md-3">
            <div class="panel panel-default h-100 d-flex flex-column">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["bookings.title", "Bookings"]</h3>
                </div>
                <div class="panel-body flex-grow-1 overflow-auto">
                    <button class="btn btn-success btn-sm w-100 mb-3" @onclick="NewRecord">
                        <span class="bi bi-plus"></span> @L["bookings.new", "New"]
                    </button>
                    <div class="d-flex gap-1 mb-3">
                        <input class="form-control form-control-sm" type="date" @bind="rangeFrom" aria-label="@L["bookings.stayFrom"]" />
                        <input class="form-control form-control-sm" type="date" @bind="rangeTo" aria-label="@L["bookings.stayTo"]" />
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ApplyFilter">@L["bookings.load", "Load"]</button>
                    </div>
                    <div class="mb-3">
                        <input type="text" class="form-control form-control-sm" @bind="listFilter" @bind:event="oninput"
                               placeholder="@L["bookings.searchPlaceholder", "Search by client, room, status, or year"]" />
                    </div>
                    @if (records is null)
                    {
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">@L["common.loading", "Loading..."]</span>
                        </div>
                    }
                    else if (FilteredRecords.Count == 0)
                    {
                        <div class="alert alert-info">@L["bookings.emptyList", "No bookings"]</div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var r in FilteredRecords)
                            {
                                <button type="button" class="list-group-item list-group-item-action @(selected?.Id == r.Id ? "active" : "")"
                                        @onclick="() => SelectRecordAndEdit(r)">
                                    <div class="fw-semibold">@GetClientDisplayName(r.ClientId)</div>
                                    <small class="text-muted">@DescribeBooking(r)@StatusSuffix(r)</small>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- MIDDLE: Edit Form -->
        <div class="col-md-6">
            @if (editing)
            {
                <div class="panel panel-default h-100 d-flex flex-column">
                    <div class="panel-heading">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h3 class="panel-title mb-0">@(isNew || selected is null ? L["bookings.newBooking", "New Booking"] : DescribeBooking(selected))</h3>
                                <small class="text-muted">@L["bookings.editBooking", "Edit Booking"]</small>
                            </div>
                            @if (!string.IsNullOrEmpty(errorMsg))
                            {
                                <span class="badge bg-danger">@L["common.error", "Error"]</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(errorMsg))
                        {
                            <div class="alert alert-danger alert-sm mt-2 mb-0">@errorMsg</div>
                        }
                    </div>
                    <div class="panel-body flex-grow-1 overflow-auto">
                        <div class="row g-2">
                            <div class="col-6"><label class="form-label">@L["bookings.status", "Status"]</label><input class="form-control" @bind="form.Status" /></div>
                            @if (form.ArrivalDate.HasValue)
                            {
                                <div class="col-12"><div class="form-text">@L["bookings.reportingYear", form.ArrivalDate.Value.Year]</div></div>
                            }
                            <div class="col-6"><label class="form-label">@L["bookings.arrivalDate", "Arrival Date"]</label><input class="form-control" type="date" @bind="form.ArrivalDate" @bind:after="RefreshTariffPreviewAsync" /></div>
                            <div class="col-6"><label class="form-label">@L["bookings.departureDate", "Departure Date"]</label><input class="form-control" type="date" @bind="form.DepartureDate" @bind:after="RefreshTariffPreviewAsync" /></div>
                            <div class="col-6"><label class="form-label">@L["bookings.actualArrivalDateOptional", "Actual Arrival Date (optional)"]</label><input class="form-control" type="date" @bind="form.ActualArrivalDate" /></div>
                            <div class="col-6"><label class="form-label">@L["bookings.actualDepartureDateOptional", "Actual Checkout Date (optional)"]</label><input class="form-control" type="date" @bind="form.ActualDepartureDate" /></div>
                            <div class="col-6"><label class="form-label">@L["bookings.expectedGuestCount", "Expected Guests"]</label><input class="form-control" type="number" min="1" @bind="form.ExpectedGuestCount" @bind:event="oninput" @bind:after="RefreshTariffPreviewAsync" /></div>
                            <div class="col-6"><label class="form-label">@L["bookings.actualGuestCount", "Guests On Arrival"]</label><input class="form-control" type="number" min="1" @bind="form.ActualGuestCount" @bind:event="oninput" @bind:after="RefreshTariffPreviewAsync" /></div>
                             <div class="col-6"><label class="form-label">@L["bookings.prepaidAmount", "Prepaid Amount"]</label><input class="form-control" type="number" min="0" step="0.01" @bind="form.PrepaidAmount" @bind:event="oninput" /></div>
                             <div class="col-6"><label class="form-label">@L["bookings.prepaidMethod", "Prepaid Method"]</label><input class="form-control" @bind="form.PrepaidMethod" placeholder="cash, card, bank, ota..." /></div>
                             <div class="col-6"><label class="form-label">@L["bookings.prepaidReference", "Prepaid Reference"]</label><input class="form-control" @bind="form.PrepaidReference" placeholder="last 4 digits / txn id" /></div>
                             <div class="col-6"><label class="form-label">@L["bookings.preAuthReference", "Guarantee / Pre-auth"]</label><input class="form-control" @bind="form.PreAuthReference" placeholder="auth code or OTA ref" /></div>
                             <div class="col-6"><label class="form-label">@L["bookings.preAuthMethod", "Guarantee Method"]</label><input class="form-control" @bind="form.PreAuthMethod" placeholder="credit-card, ota, agreement..." /></div>
                             <div class="col-6">
                                 <label class="form-label">@L["bookingFinance.totalDue", "Total due"]</label>
                                <button type="button" class="form-control text-start" @onclick="OpenFinance" disabled="@(selected is null || isNew)">
                                    @FormatMoney(GetDisplayedTotalDue())
                                </button>
                                <div class="form-text">@L["bookingFinance.totalDueHint", "Stay price plus extras, minus prepaid amount and recorded payments."]</div>
                            </div>
                             <div class="col-12"><label class="form-label">@L["bookings.notes", "Notes"]</label><input class="form-control" @bind="form.Notes" /></div>
                             <div class="col-6"><label class="form-label">@L["bookings.source", "Source"]</label><input class="form-control" @bind="form.Source" placeholder="desk, phone, email, homepage, Booking.com" /></div>
                             <div class="col-6"><label class="form-label">@L["bookings.externalReference", "External reference"]</label><input class="form-control" @bind="form.ExternalReference" /></div>
                             <div class="col-6">
                                 <label class="form-label">@L["bookings.groupCode", "Group"]</label>
                                 @if (!string.IsNullOrWhiteSpace(form.GroupCode))
                                 {
                                     <div class="border rounded p-2 bg-light-subtle mb-2">
                                         <div class="d-flex justify-content-between align-items-center gap-2">
                                             <div>
                                                 <div class="fw-semibold">@(string.IsNullOrWhiteSpace(form.GroupName) ? form.GroupCode : form.GroupName)</div>
                                                 <div class="small text-muted">@GroupWhen(FindGroup(form.GroupCode))</div>
                                             </div>
                                             <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearGroup">@L["bookings.groupRemove", "Remove"]</button>
                                         </div>
                                     </div>
                                 }
                                 <div class="input-group">
                                     <input class="form-control" value="@groupSearch" placeholder="@L["bookings.groupNamePlaceholder", "Party name"]" @oninput="OnGroupSearch" />
                                     <button type="button" class="btn btn-outline-secondary" disabled="@groupBusy" @onclick="CreateGroupAsync">@L["bookings.newGroup", "New group"]</button>
                                 </div>
                                 @if (GroupMatches.Count > 0)
                                 {
                                     <div class="list-group mt-1">
                                         @foreach (var party in GroupMatches)
                                         {
                                             <button type="button" class="list-group-item list-group-item-action" @onclick="() => PickGroup(party)">@DescribeGroup(party)</button>
                                         }
                                     </div>
                                 }
                                 @if (!string.IsNullOrWhiteSpace(groupError))
                                 {
                                     <div class="form-text text-danger">@groupError</div>
                                 }
                                 <div class="form-text">@L["bookings.groupHelp", "A group is one party. Rooms in it can arrive on different days. Pick the party that is already in the hotel, or start a new one. The same name later is a different party."]</div>
                             </div>
                             <div class="col-6 d-flex align-items-end">
                                 <div class="form-check mb-2">
                                     <input class="form-check-input" type="checkbox" id="roomFixed" @bind="form.RoomFixed" />
                                     <label class="form-check-label" for="roomFixed">@L["bookings.roomFixed", "Room fixed on request"]</label>
                                 </div>
                             </div>

                             @if (form.ActualDepartureDate.HasValue)
                             {
                                 <div class="col-12 mt-3">
                                     <div class="border rounded p-3 bg-light-subtle">
                                         <h6 class="mb-2">@L["bookings.settlement", "Settlement / Folio Close"]</h6>
                                         <div class="row g-2">
                                             <div class="col-6"><label class="form-label small">Settlement Date</label><input class="form-control form-control-sm" value="@(form.SettlementDate?.ToString("yyyy-MM-dd") ?? "—")" readonly /></div>
                                             <div class="col-6"><label class="form-label small">Final Method</label><input class="form-control form-control-sm" @bind="form.PrepaidMethod" /></div>
                                             <div class="col-12"><button class="btn btn-primary btn-sm" @onclick="SettleFolioAsync" disabled="@(selected is null)">Settle & Close Folio</button></div>
                                         </div>
                                     </div>
                                 </div>
                             }

                            <div class="col-12 mt-2"><h6 class="text-muted mb-1">@L["bookings.roomSearchLabel", "Find room"] *</h6></div>
                            @if (GuestIsInHouse)
                            {
                                <div class="col-12">
                                    <div class="input-group">
                                        <input class="form-control" value="@GetRoomDisplayName(form.RoomId)" disabled />
                                        @if (CanMoveSelected)
                                        {
                                            <button type="button" class="btn btn-outline-primary" @onclick="OpenMove">@L["bookings.assignRoom", "Assign a new room"]</button>
                                        }
                                    </div>
                                    <div class="form-text">@(CanMoveSelected ? L["bookings.roomStaying", "This guest is in this room. Assign a new room to move them from a later night."] : L["bookings.roomStayingShort", "This guest is in this room."])</div>
                                </div>
                                @if (moveOpen)
                                {
                                    <div class="col-12">
                                        <BookingMoveFields Rooms="MoveRoomChoices"
                                                           @bind-From="moveFrom"
                                                           @bind-RoomId="moveRoomId"
                                                           @bind-Reason="moveReason"
                                                           @bind-Note="moveNote"
                                                           Error="moveError"
                                                           Busy="moveBusy"
                                                           Confirm="ConfirmMoveAsync"
                                                           Cancel="CloseMove" />
                                    </div>
                                }
                            }
                            else
                            {
                            <div class="col-12"><input class="form-control" value="@roomSearch" placeholder="@L["bookings.roomSearchPlaceholder", "Type room name or ID"]" @oninput="OnRoomSearchChanged" /></div>
                            @if (roomMatches.Count > 0)
                            {
                                <div class="col-12">
                                    <div class="list-group">
                                        @foreach (var room in roomMatches)
                                        {
                                            <button type="button" class="list-group-item list-group-item-action" @onclick="() => SelectRoom(room)">
                                                <div class="fw-semibold">@GetRoomDisplayName(room.Id)</div>
                                                <small class="text-muted">@L["rooms.capacityLabel", "Capacity"]: @room.Capacity</small>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                            @if (selectedRoom is not null)
                            {
                                <div class="col-12">
                                    <div class="border rounded p-2 bg-light-subtle">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <button type="button" class="btn btn-link p-0 text-start" @onclick="() => GoToRoom(selectedRoom.Id)">
                                                <div class="fw-semibold">@GetRoomDisplayName(selectedRoom.Id)</div>
                                                <small class="text-muted">@L["rooms.capacityLabel", "Capacity"]: @selectedRoom.Capacity</small>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearRoomSelection">@L["bookings.clearSelection", "Clear"]</button>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (selectedRoom is null && !string.IsNullOrWhiteSpace(roomSearch))
                            {
                                <div class="col-12 text-muted small">@L["bookings.noRoomMatch", "No room matches this search."]</div>
                            }
                            }

                            <div class="col-12 mt-2"><h6 class="text-muted mb-1">@L["bookings.tariffLabel", "Tariff"]</h6></div>
                            <div class="col-12">
                                @if (previewTariffLoading)
                                {
                                    <div class="text-muted small">@L["common.loading", "Loading..."]</div>
                                }
                                else if (previewTariff is not null)
                                {
                                    @if (previewTariff.DailySegments is not null && previewTariff.DailySegments.Count > 1)
                                    {
                                        <div class="border rounded p-2 bg-light-subtle small">
                                            <div class="fw-semibold mb-1">@previewTariff.TariffName — Daily breakdown</div>
                                            <table class="table table-sm mb-0">
                                                <thead>
                                                    <tr><th>Date</th><th>Tariff</th><th class="text-end">Price</th></tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var seg in previewTariff.DailySegments)
                                                    {
                                                        <tr>
                                                            <td>@seg.Date.ToString("yyyy-MM-dd")</td>
                                                            <td>@seg.TariffName</td>
                                                            <td class="text-end">@seg.Price.ToString("0.00")</td>
                                                        </tr>
                                                    }
                                                    <tr class="fw-semibold">
                                                        <td colspan="2">Total</td>
                                                        <td class="text-end">@previewTariff.TotalPrice.ToString("0.00")</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="border rounded p-2 bg-light-subtle">
                                            <button type="button" class="btn btn-link p-0 text-start" @onclick="() => GoToTariff(previewTariff.TariffId)">
                                                <div class="fw-semibold">@previewTariff.TariffName</div>
                                                <small class="text-muted">@previewTariff.Nights @L["bookings.nightsLabel", "night(s)"] · @previewTariff.TotalPrice.ToString("0.00")</small>
                                            </button>
                                        </div>
                                    }
                                }
                                else if (!string.IsNullOrWhiteSpace(form.TariffId))
                                {
                                    <div class="border rounded p-2 bg-light-subtle">
                                        <button type="button" class="btn btn-link p-0 text-start" @onclick="() => GoToTariff(form.TariffId)">
                                            <div class="fw-semibold">@GetTariffDisplayName(form.TariffId)</div>
                                            <small class="text-muted">@StoredStayNights() @L["bookings.nightsLabel", "night(s)"] · @((form.TariffTotalPrice ?? 0).ToString("0.00"))</small>
                                        </button>
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(form.RoomId)
                                    && form.ArrivalDate.HasValue
                                    && form.DepartureDate.HasValue
                                    && form.DepartureDate.Value > form.ArrivalDate.Value)
                                {
                                    <div class="text-muted small">@L["bookings.tariffNoneAssigned", "No tariff is assigned to this room for these dates."]</div>
                                }
                                else
                                {
                                    <div class="text-muted small">@L["bookings.tariffUnavailable", "Select a room, arrival and departure date to see the applicable tariff."]</div>
                                }
                            </div>

                            <div class="col-12 mt-2"><h6 class="text-muted mb-1">@L["bookings.clientSearchLabel", "Find existing client"]</h6></div>
                            <div class="col-12">
                                <input class="form-control" value="@clientSearch"
                                       placeholder="@L["bookings.clientSearchPlaceholder", "Type last name, first name, email, or phone"]"
                                       @oninput="OnClientSearchChanged" />
                            </div>
                            @if (clientMatches.Count > 0)
                            {
                                <div class="col-12">
                                    <div class="list-group">
                                        @foreach (var client in clientMatches)
                                        {
                                            <button type="button" class="list-group-item list-group-item-action" @onclick="() => SelectClient(client)">
                                                <div class="fw-semibold">@ClientDisplayName(client)</div>
                                                <small class="text-muted">@client.Email @client.Phone @client.City</small>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                            @if (selectedClient is not null)
                            {
                                <div class="col-12">
                                    <div class="border rounded p-2 bg-light-subtle">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <button type="button" class="btn btn-link p-0 text-start" @onclick="() => GoToClient(selectedClient.Id)">
                                                <div class="fw-semibold">@ClientDisplayName(selectedClient)</div>
                                                <small class="text-muted">@selectedClient.Email · @selectedClient.Phone</small>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearClientSelection">@L["bookings.clearSelection", "Clear"]</button>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (selectedClient is null && !creatingNewClient && !string.IsNullOrWhiteSpace(clientSearch))
                            {
                                <div class="col-12">
                                    <div class="text-muted small">@L["bookings.noClientMatch", "No existing client matches this search."]</div>
                                    <button type="button" class="btn btn-sm btn-outline-primary mt-1" @onclick="EnableInlineClientCreate">@L["bookings.createClientInline", "Enter new client details"]</button>
                                </div>
                            }
                            @if (creatingNewClient)
                            {
                                <div class="col-12 mt-2">
                                    <div class="border rounded p-3">
                                        <div class="row g-2">
                                            <div class="col-6"><label class="form-label">@L["bookings.clientLastName", "Last Name"] *</label><input class="form-control" @bind="clientForm.LastName" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientFirstName", "First Name"]</label><input class="form-control" @bind="clientForm.FirstName" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientNickname", "Nickname"]</label><input class="form-control" @bind="clientForm.Nickname" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientLanguage", "Language"]</label><input class="form-control" @bind="clientForm.Language" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientPhone", "Phone"]</label><input class="form-control" @bind="clientForm.Phone" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientEmail", "Email"]</label><input class="form-control" @bind="clientForm.Email" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientNation", "Nation"]</label><input class="form-control" @bind="clientForm.Nation" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientCity", "City"]</label><input class="form-control" @bind="clientForm.City" /></div>
                                            <div class="col-6"><label class="form-label">@L["clients.genderLabel", "Gender"]</label><input class="form-control" @bind="clientForm.Gender" /></div>
                                            <div class="col-6"><label class="form-label">@L["clients.dateOfBirthLabel", "Date of Birth"]</label><input type="date" class="form-control" @bind="clientForm.DateOfBirth" /></div>
                                            <div class="col-6"><label class="form-label">@L["clients.birthCityLabel", "Birth City"]</label><input class="form-control" @bind="clientForm.BirthCity" /></div>
                                            <div class="col-6"><label class="form-label">@L["clients.birthNationLabel", "Birth Nation"]</label><input class="form-control" @bind="clientForm.BirthNation" /></div>
                                            <div class="col-6"><label class="form-label">@L["clients.nationalityLabel", "Nationality"]</label><input class="form-control" @bind="clientForm.Nationality" /></div>
                                            <div class="col-6"><label class="form-label">@L["clients.secondNationalityLabel", "Second nationality"]</label><input class="form-control" @bind="clientForm.SecondNationality" /></div>
                                            <div class="col-8"><label class="form-label">@L["clients.streetLabel", "Street"]</label><input class="form-control" @bind="clientForm.Street" /></div>
                                            <div class="col-4"><label class="form-label">@L["clients.postalCodeLabel", "Postal Code"]</label><input class="form-control" @bind="clientForm.PostalCode" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientDocumentType", "Document Type"]</label><input class="form-control" @bind="clientForm.DocumentType" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientDocumentNumber", "Document Number"]</label><input class="form-control" @bind="clientForm.DocumentNumber" /></div>
                                            <div class="col-6"><label class="form-label">@L["clients.documentExpiryLabel", "Document Expiry"]</label><input type="date" class="form-control" @bind="clientForm.DocumentExpiry" /></div>
                                            <div class="col-6"><label class="form-label">@L["clients.documentCityLabel", "Document City"]</label><input class="form-control" @bind="clientForm.DocumentCity" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientTaxCode", "Tax Code"]</label><input class="form-control" @bind="clientForm.TaxCode" /></div>
                                            <div class="col-6"><label class="form-label">@L["bookings.clientVatNumber", "VAT Number"]</label><input class="form-control" @bind="clientForm.VatNumber" /></div>
                                            <div class="col-12"><label class="form-label">@L["bookings.notes", "Notes"]</label><input class="form-control" @bind="clientForm.Notes" /></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="panel-footer">
                        <div class="btn-group w-100" role="group">
                            <button class="btn btn-primary flex-grow-1" @onclick="Save">@L["common.save", "Save"]</button>
                            <button class="btn btn-secondary flex-grow-1" @onclick="Cancel">@L["common.cancel", "Cancel"]</button>
                            @if (selected is not null && !isNew && !string.IsNullOrWhiteSpace(selected.Id))
                            {
                                <a class="btn btn-outline-secondary flex-grow-1" href="@GetInvoiceUrl(selected)" target="_blank">@L["bookingFinance.printInvoice", "Invoice"]</a>
                                <button type="button" class="btn btn-outline-secondary flex-grow-1" @onclick="() => DownloadInvoiceMail(selected)">@L["bookingFinance.emailInvoice", "Email invoice"]</button>
                                <a class="btn btn-outline-secondary flex-grow-1" href="@GetDocumentUrl(selected, "rechnung")" target="_blank">@L["bookingFinance.printRechnung", "Rechnung"]</a>
                            }
                            @if (CanMarkArrivedSelected)
                            {
                                <button class="btn btn-info flex-grow-1" @onclick="CheckInSelected">@L["Dashboard.Reservations.Menu.Arrived", "Arrived"]</button>
                                <button class="btn btn-warning flex-grow-1" @onclick="MarkNoShowSelected">@L["bookings.markNoShow", "Mark No-Show"]</button>
                                <button class="btn btn-outline-danger flex-grow-1" @onclick="CancelBooking">@L["bookings.cancelBooking", "Cancel Booking"]</button>
                            }
                            else if (CanCheckOutSelected)
                            {
                                <button class="btn btn-dark flex-grow-1" @onclick="CheckOutSelected">@L["bookings.checkOut", "Check Out"]</button>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="panel panel-default h-100 d-flex align-items-center justify-content-center">
                    <div class="panel-body text-center text-muted">
                        <p class="mb-2"><span class="bi bi-arrow-left" style="font-size: 2rem;"></span></p>
                        <p>@L["bookings.selectPrompt", "Select a booking from the list or create a new one"]</p>
                    </div>
                </div>
            }
        </div>

        <!-- RIGHT: Details -->
        <div class="col-md-3">
            <div class="panel panel-default h-100 d-flex flex-column">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["common.details", "Details"]</h3>
                </div>
                <div class="panel-body flex-grow-1 overflow-auto">
                    @if (selected is not null)
                    {
                        <div class="booking-summary-card">
                            <div class="booking-summary-name"><a class="booking-summary-link" href="@GetBookingUrl(selected)">@DescribeBooking(selected)</a></div>
                            <div class="booking-summary-meta">@GetBookingSummaryMeta(selected)</div>
                        </div>

                        <dl class="booking-detail-grid mt-3">
                            <dt>@L["bookings.year", "Year"]</dt><dd>@selected.Year</dd>
                            <dt>@L["bookings.client", "Client"]</dt>
                            <dd>
                                @if (!string.IsNullOrWhiteSpace(selected.ClientId))
                                {
                                    <a href="/clients?selectedId=@selected.ClientId">@GetClientDisplayName(selected.ClientId)</a>
                                }
                                else { <text>-</text> }
                            </dd>
                            <dt>@L["bookings.room", "Room"]</dt>
                            <dd>
                                @if (GuestIsInHouse)
                                {
                                    <div class="input-group">
                                        <input class="form-control form-control-sm" value="@GetRoomDisplayName(selected.RoomId)" disabled />
                                        @if (CanMoveSelected)
                                        {
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="OpenMove">@L["bookings.assignRoom", "Assign a new room"]</button>
                                        }
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(selected.RoomId))
                                {
                                    <a href="/rooms?selectedId=@selected.RoomId">@GetRoomDisplayName(selected.RoomId)</a>
                                }
                                else { <text>-</text> }
                            </dd>
                        </dl>
                        @if (moveOpen && !editing)
                        {
                            <BookingMoveFields Rooms="MoveRoomChoices"
                                               @bind-From="moveFrom"
                                               @bind-RoomId="moveRoomId"
                                               @bind-Reason="moveReason"
                                               @bind-Note="moveNote"
                                               Error="moveError"
                                               Busy="moveBusy"
                                               Confirm="ConfirmMoveAsync"
                                               Cancel="CloseMove" />
                        }
                        <dl class="booking-detail-grid">
                            <dt>@L["bookings.status", "Status"]</dt><dd>@selected.Status</dd>
                            <dt>@L["bookings.arrivalDate", "Arrival Date"]</dt>
                            <dd><a href="@GetCalendarUrl(selected.ArrivalDate)">@FormatDate(selected.ArrivalDate)</a></dd>
                            <dt>@L["bookings.departureDate", "Departure Date"]</dt>
                            <dd><a href="@GetCalendarUrl(selected.DepartureDate)">@FormatDate(selected.DepartureDate)</a></dd>
                            <dt>@L["bookings.actualArrivalDate", "Actual Arrival Date"]</dt><dd>@FormatDate(selected.ActualArrivalDate)</dd>
                            <dt>@L["bookings.actualDepartureDate", "Actual Checkout Date"]</dt><dd>@FormatDate(selected.ActualDepartureDate)</dd>
                            <dt>@L["bookings.actualGuestCount", "Guests On Arrival"]</dt><dd>@(selected.ActualGuestCount?.ToString() ?? "-")</dd>
                            <dt>@L["bookings.expectedGuestCount", "Expected Guests"]</dt><dd>@(selected.ExpectedGuestCount?.ToString() ?? "-")</dd>
                            <dt>@L["bookings.tariffLabel", "Tariff"]</dt>
                            <dd>
                                @if (!string.IsNullOrWhiteSpace(selected.TariffId))
                                {
                                    <a href="/tariffs?selectedId=@selected.TariffId">@GetTariffDisplayName(selected.TariffId)</a>
                                }
                                else { <text>-</text> }
                            </dd>
                            <dt>@L["bookings.prepaidAmount", "Prepaid Amount"]</dt><dd>@(selected.PrepaidAmount?.ToString("0.00") ?? "-")</dd>
                            @if (CanCheckOutSelected && !string.IsNullOrWhiteSpace(selected.Id))
                            {
                                <dt>@L["pos.title", "Point of sale"]</dt>
                                <dd><a href="/point-of-sale?bookingId=@selected.Id">@L["pos.onStay", "On the stay"]</a></dd>
                            }
                            <dt>@L["bookingFinance.totalDue", "Total due"]</dt>
                            <dd>
                                @if (!string.IsNullOrWhiteSpace(selected.Id))
                                {
                                    <a href="@GetFinanceUrl(selected)">@FormatMoney(GetDisplayedTotalDue())</a>
                                }
                                else
                                {
                                    @FormatMoney(financeSummary?.TotalDue)
                                }
                            </dd>
                            <dt>@L["bookings.notes", "Notes"]</dt><dd>@selected.Notes</dd>
                            @if (selected.DeletedAt.HasValue)
                            {
                                <dt>@L["bookings.removedFromList", "Working list"]</dt>
                                <dd>@L["bookings.removedFromListValue", "Hidden. The ledger still cites this booking."]</dd>
                            }
                        </dl>

                        @if (!string.IsNullOrWhiteSpace(selected.ContinuedFromId) || !string.IsNullOrWhiteSpace(selected.ContinuedToId))
                        {
                            <section class="booking-section mt-3">
                                <h4 class="booking-section-title">@L["bookings.continuedTitle", "Continued stay"]</h4>
                                <div class="list-group">
                                    @if (!string.IsNullOrWhiteSpace(selected.ContinuedFromId))
                                    {
                                        <a class="list-group-item list-group-item-action" href="@BookingReference.Href(selected.ContinuedFromId)">@L["bookings.continuedFrom", "Continued from the previous room"]</a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(selected.ContinuedToId))
                                    {
                                        <a class="list-group-item list-group-item-action" href="@BookingReference.Href(selected.ContinuedToId)">@L["bookings.continuedTo", "Continues in the next room"]</a>
                                    }
                                </div>
                            </section>
                        }

                        <section class="booking-section booking-section-guest mt-3">
                            <h4 class="booking-section-title">@L["bookings.guestDetailsTitle", "Guest Details"]</h4>
                            @if (GetSelectedGuestClient() is { } guestClient)
                            {
                                <div class="booking-summary-card booking-summary-card-guest">
                                    <div class="booking-summary-name"><a class="booking-summary-link" href="@GetClientUrl(guestClient.Id)">@GetClientDisplayName(guestClient.Id)</a></div>
                                    <div class="booking-summary-meta">@GetGuestProfileSummary(guestClient)</div>
                                </div>

                                var guestFields = GetGuestDetailFields(guestClient).ToList();
                                @if (guestFields.Any())
                                {
                                    <dl class="booking-detail-grid mt-3">
                                        @foreach (var field in guestFields)
                                        {
                                            <dt>@field.Label</dt><dd>@field.Value</dd>
                                        }
                                    </dl>
                                }
                            }
                            else
                            {
                                <div class="alert alert-info mb-0">@L["bookings.unknownClient", "Unknown client"]</div>
                            }
                        </section>

                        <section class="booking-section booking-section-history mt-3">
                            <h4 class="booking-section-title"><a href="@GetFinanceUrl(selected)">@L["bookings.paymentsTitle", "Payments"]</a></h4>
                            @if (isPaymentsLoading)
                            {
                                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                                <span class="ms-2">@L["common.loading", "Loading..."]</span>
                            }
                            else if (selectedPayments is null || selectedPayments.Count == 0)
                            {
                                <div class="alert alert-info mb-0">@L["bookings.noPayments", "No payments recorded on this stay."]</div>
                            }
                            else
                            {
                                <div class="list-group">
                                    @foreach (var payment in selectedPayments)
                                    {
                                        <div class="list-group-item">
                                            <div class="fw-semibold">@DescribePayment(payment)</div>
                                            <div class="small text-muted">@payment.Timestamp.ToLocalTime().ToString("yyyy-MM-dd")</div>
                                        </div>
                                    }
                                </div>
                            }
                        </section>

                        <section class="booking-section booking-section-history mt-3">
                            <h4 class="booking-section-title">@L["bookings.guestHistoryTitle", "Other Bookings"]</h4>
                            @if (isGuestHistoryLoading)
                            {
                                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                                <span class="ms-2">@L["common.loading", "Loading..."]</span>
                            }
                            else if (selectedGuestBookings is null || !selectedGuestBookings.Any())
                            {
                                <div class="alert alert-info mb-0">@L["bookings.noGuestHistory", "No other bookings found for this guest."]</div>
                            }
                            else
                            {
                                <div class="list-group">
                                    @foreach (var booking in selectedGuestBookings.Take(5))
                                    {
                                        <a class="list-group-item list-group-item-action" href="@GetBookingUrl(booking)">
                                            <div class="fw-semibold">@DescribeBooking(booking)</div>
                                            <div class="small text-muted">@GetClientDisplayName(booking.ClientId)</div>
                                        </a>
                                    }
                                </div>
                            }
                        </section>

                        @if (!string.IsNullOrWhiteSpace(selected.GroupCode))
                        {
                            <section class="booking-section booking-section-history mt-3">
                                <h4 class="booking-section-title">@L["bookings.groupRoomsTitle", "Other rooms in this group"]</h4>
                                <div class="small text-muted mb-2">@GroupHeading(selected)</div>
                                @if (isGroupLoading)
                                {
                                    <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                                }
                                else if (selectedGroupBookings is null || selectedGroupBookings.Count == 0)
                                {
                                    <div class="alert alert-info mb-0">@L["bookings.noGroupRooms", "No other rooms share this group."]</div>
                                }
                                else
                                {
                                    <div class="list-group">
                                        @foreach (var member in selectedGroupBookings)
                                        {
                                            <a class="list-group-item list-group-item-action" href="@GetBookingUrl(member)">
                                                <div class="fw-semibold">@DescribeBooking(member)</div>
                                                <div class="small text-muted">@GetClientDisplayName(member.ClientId) · @member.Status</div>
                                            </a>
                                        }
                                    </div>
                                }
                            </section>
                        }
                    }
                    else if (selected is null)
                    {
                        <div class="text-muted">@L["bookings.selectPrompt", "Select a booking from the list or create a new one"]</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@code {
    [SupplyParameterFromQuery(Name = "selectedId")]
    public string? SelectedId { get; set; }

    [SupplyParameterFromQuery(Name = "edit")]
    public bool? EditRequested { get; set; }

    [SupplyParameterFromQuery(Name = "roomId")]
    public string? RoomIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = "view")]
    public string? ViewQuery { get; set; }

    [SupplyParameterFromQuery(Name = "lookAheadDays")]
    public int? LookAheadDaysQuery { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public string? FromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public string? ToQuery { get; set; }

    [SupplyParameterFromQuery(Name = "focus")]
    public string? FocusQuery { get; set; }

    private List<BookingDto>? records;
    private BookingDto? selected;
    private List<ClientRecord> knownClients = new();
    private List<RoomRecord> knownRooms = new();
    private List<TariffDto> knownTariffs = new();
    private TariffResolutionDto? previewTariff;
    private bool previewTariffLoading;
    private int tariffPreviewGeneration;
    private BookingFinanceSummaryDto? financeSummary;
    private List<BookingTransactionDto>? selectedPayments;
    private bool isPaymentsLoading;
    private List<ClientRecord> clientMatches = new();
    private List<RoomRecord> roomMatches = new();
    private List<BookingDto>? selectedGuestBookings;
    private List<BookingDto>? selectedGroupBookings;
    private List<StayGroupDto> knownGroups = new();
    private string groupSearch = "";
    private string? groupError;
    private bool groupBusy;
    private bool moveOpen;
    private bool moveBusy;
    private DateOnly? moveFrom;
    private string? moveRoomId;
    private string moveReason = "Relocate";
    private string? moveNote;
    private string? moveError;
    private bool isGroupLoading;
    private ClientRecord? selectedClient;
    private RoomRecord? selectedRoom;
    private bool creatingNewClient;
    private string clientSearch = string.Empty;
    private string roomSearch = string.Empty;
    private bool editing, isNew;
    private bool isGuestHistoryLoading;
    private string errorMsg = "";
    private DateOnly rangeFrom = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly rangeTo = DateOnly.FromDateTime(DateTime.Today);
    private bool dateFilterActive;
    private string? alignedSelectionId;
    private string listFilter = string.Empty;
    private FormModel form = new();
    private ClientFormModel clientForm = new();

    private bool CanMarkArrivedSelected
        => selected is not null
           && !isNew
           && IsPreArrivalBooking(selected);

    private bool CanCheckOutSelected
        => selected is not null
           && !isNew
           && IsCheckedInBooking(selected);

    private List<BookingDto> FilteredRecords
    {
        get
        {
            if (records is null) return new();
            if (string.IsNullOrWhiteSpace(listFilter)) return records;
            var term = listFilter.Trim();
            return records.Where(r =>
                GetClientDisplayName(r.ClientId).Contains(term, StringComparison.OrdinalIgnoreCase)
                || GetRoomDisplayName(r.RoomId).Contains(term, StringComparison.OrdinalIgnoreCase)
                || DescribeBooking(r).Contains(term, StringComparison.OrdinalIgnoreCase)
                || (r.Status?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || r.Year.ToString().Contains(term))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        PrepareRange();
        var clientsTask = RefreshKnownClients();
        var roomsTask = RoomApiService.GetRoomsAsync();
        var tariffsTask = TariffApi.GetTariffsAsync();

        var alignedToSelection = await AlignRangeToSelectedBookingAsync();
        if (!alignedToSelection)
        {
            if (!dateFilterActive && string.IsNullOrWhiteSpace(ViewQuery) && LookAheadDaysQuery is null)
            {
                var lookAhead = await ReadArrivalsLookAheadAsync();
                rangeTo = rangeFrom.AddDays(lookAhead);
            }

            await LoadAll();
        }

        await InvokeAsync(StateHasChanged);

        knownRooms = await roomsTask;
        knownTariffs = await tariffsTask;
        if (IsNewBookingRoute())
        {
            NewRecord();
        }
        else
        {
            await ApplySelectedRecordFromQueryAsync();
        }

        await clientsTask;
        _ = LoadStayGroupsAsync();
        await InvokeAsync(StateHasChanged);
        await RevealSelectedBookingAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (records is null || IsNewBookingRoute())
        {
            return;
        }

        if (!string.Equals(alignedSelectionId, SelectedId, StringComparison.OrdinalIgnoreCase))
        {
            await AlignRangeToSelectedBookingAsync();
        }

        await ApplySelectedRecordFromQueryAsync();
        await RevealSelectedBookingAsync();
    }

    private bool IsNewBookingRoute()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        return string.Equals(relative, "bookings/new", StringComparison.OrdinalIgnoreCase);
    }

    private void PrepareRange()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        rangeFrom = today;
        rangeTo = today.AddDays(Math.Clamp(LookAheadDaysQuery ?? 0, 0, 14));
        if (TryParseDate(FromQuery, out var from))
        {
            rangeFrom = from;
            dateFilterActive = true;
        }

        if (TryParseDate(ToQuery, out var to))
        {
            rangeTo = to;
            dateFilterActive = true;
        }
    }

    private static bool TryParseDate(string? value, out DateOnly date)
        => DateOnly.TryParse(value, out date);

    private async Task<int> ReadArrivalsLookAheadAsync()
    {
        var http = ServiceProvider.GetService<HttpClient>();
        if (http is null)
        {
            return 0;
        }

        try
        {
            var config = await http.GetFromJsonAsync<SystemConfiguration>("/api/system/configuration");
            if (config?.Settings is not null
                && config.Settings.TryGetValue("DashboardArrivalsLookAheadDays", out var raw)
                && int.TryParse(raw, out var days))
            {
                return Math.Clamp(days, 0, 14);
            }
        }
        catch
        {
            // The desk still opens on today when the setting cannot be read.
        }

        return 0;
    }

    private Task<List<BookingDto>>? LoadViewAsync()
    {
        if (dateFilterActive || string.IsNullOrWhiteSpace(ViewQuery))
        {
            return null;
        }

        if (string.Equals(ViewQuery, "stays", StringComparison.OrdinalIgnoreCase))
        {
            return BookingApi.ListStaysAsync(null);
        }

        if (string.Equals(ViewQuery, "arrivals", StringComparison.OrdinalIgnoreCase))
        {
            return BookingApi.ListArrivalsAsync(null, LookAheadDaysQuery ?? 0);
        }

        if (string.Equals(ViewQuery, "departures", StringComparison.OrdinalIgnoreCase))
        {
            return BookingApi.ListDeparturesAsync(null);
        }

        if (string.Equals(ViewQuery, "reservations", StringComparison.OrdinalIgnoreCase))
        {
            return BookingApi.ListReservationsAsync(null);
        }

        return null;
    }

    private async Task LoadAll()
    {
        if (rangeTo < rangeFrom)
        {
            rangeTo = rangeFrom;
        }

        var view = LoadViewAsync();
        var loaded = view is not null
            ? await view
            : await BookingApi.ListAsync(from: rangeFrom, to: rangeTo);

        records = loaded
            .GroupBy(booking => booking.Id ?? string.Empty, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .OrderBy(booking => booking.ArrivalDate ?? DateOnly.MinValue)
            .ThenBy(booking => booking.Id, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task<bool> AlignRangeToSelectedBookingAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedId) || IsNewBookingRoute())
        {
            return false;
        }

        if (string.Equals(alignedSelectionId, SelectedId, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        alignedSelectionId = SelectedId;
        var opened = records?.FirstOrDefault(current => string.Equals(current.Id, SelectedId, StringComparison.OrdinalIgnoreCase))
            ?? await BookingApi.GetByIdAsync(SelectedId);
        if (opened is null || !TrySetRangeToBooking(opened))
        {
            return false;
        }

        dateFilterActive = true;
        await LoadAll();
        EnsureListed(opened);
        return true;
    }

    private bool TrySetRangeToBooking(BookingDto booking)
    {
        var arrival = booking.ArrivalDate ?? booking.ActualArrivalDate;
        if (arrival is null)
        {
            return false;
        }

        var departure = booking.DepartureDate ?? booking.ActualDepartureDate ?? arrival;
        rangeFrom = arrival.Value;
        rangeTo = departure.Value < arrival.Value ? arrival.Value : departure.Value;
        return true;
    }

    private void EnsureListed(BookingDto booking)
    {
        if (records is null || string.IsNullOrWhiteSpace(booking.Id))
        {
            return;
        }

        if (records.Any(current => string.Equals(current.Id, booking.Id, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        records.Add(booking);
        records = records
            .OrderBy(current => current.ArrivalDate ?? DateOnly.MinValue)
            .ThenBy(current => current.Id, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task RevealSelectedBookingAsync()
    {
        if (string.IsNullOrWhiteSpace(selected?.Id))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("hotelDruidCulture.revealActiveBooking");
        }
        catch
        {
            // The row stays marked in the list when the page cannot scroll.
        }
    }

    private async Task ApplySelectedRecordFromQueryAsync()
    {
        if (records is null || string.IsNullOrWhiteSpace(SelectedId) || IsNewBookingRoute())
        {
            return;
        }

        var record = records.FirstOrDefault(current => string.Equals(current.Id, SelectedId, StringComparison.OrdinalIgnoreCase));
        if (record is null)
        {
            record = await BookingApi.GetByIdAsync(SelectedId);
            if (record is null)
            {
                return;
            }

            EnsureListed(record);
        }

        SelectRecord(record);
        await EditSelected();
    }
    private async Task ApplyFilter()
    {
        dateFilterActive = true;
        await LoadAll();
    }

    private void NewRecord()
    {
        form = new()
        {
            RoomId = RoomIdQuery
        };
        isNew = true;
        editing = true;
        selected = null;
        financeSummary = null;
        selectedPayments = null;
        errorMsg = "";
        ResetClientSelection();
        InitializeRoomSelectionForCurrentForm();
        _ = RefreshTariffPreviewAsync();
    }

    private async Task SelectRecordAndEdit(BookingDto r)
    {
        selected = r;
        await EditSelected();
    }

    private void SelectRecord(BookingDto r)
    {
        selected = r;
        editing = false;
        moveOpen = false;
        _ = LoadSelectedGuestHistoryAsync();
        _ = LoadSelectedGroupAsync();
    }

    private async Task EditSelected()
    {
        await LoadSelectedGuestHistoryAsync();
        await LoadSelectedGroupAsync();
        moveOpen = false;
        if (selected is null) return;
        form = new()
        {
            Year = selected.Year,
            ClientId = selected.ClientId,
            RoomId = selected.RoomId,
            Status = selected.Status,
            ArrivalDate = selected.ArrivalDate,
            DepartureDate = selected.DepartureDate,
            Notes = selected.Notes,
            Source = selected.Source,
            ExternalReference = selected.ExternalReference,
            GroupCode = selected.GroupCode,
            GroupName = selected.GroupName,
            RoomFixed = selected.RoomFixed,
            ActualArrivalDate = selected.ActualArrivalDate,
            ActualDepartureDate = selected.ActualDepartureDate,
            ActualGuestCount = selected.ActualGuestCount,
            ExpectedGuestCount = selected.ExpectedGuestCount,
            PrepaidAmount = selected.PrepaidAmount,
            PrepaidMethod = selected.PrepaidMethod,
            PrepaidReference = selected.PrepaidReference,
            PreAuthReference = selected.PreAuthReference,
            PreAuthMethod = selected.PreAuthMethod,
            TariffId = selected.TariffId,
            TariffTotalPrice = selected.TariffTotalPrice
        };
        isNew = false;
        editing = true;
        errorMsg = "";
        await InitializeClientSelectionForEdit();
        InitializeRoomSelectionForCurrentForm();
        await RefreshTariffPreviewAsync();
        await RefreshFinanceSummaryAsync();
    }

    private void OnGroupSearch(ChangeEventArgs e)
    {
        groupSearch = e.Value?.ToString() ?? "";
        groupError = null;
    }

    private void PickGroup(StayGroupDto party)
    {
        form.GroupCode = party.Id;
        form.GroupName = string.IsNullOrWhiteSpace(party.Name) ? party.Id : party.Name;
        groupSearch = "";
        groupError = null;
    }

    private void ClearGroup()
    {
        form.GroupCode = null;
        form.GroupName = null;
        groupSearch = "";
        groupError = null;
    }

    private async Task CreateGroupAsync()
    {
        var name = groupSearch.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            groupError = L["bookings.groupNameRequired", "Type the name of the party."];
            return;
        }

        try
        {
            groupBusy = true;
            groupError = null;
            var created = await BookingApi.CreateStayGroupAsync(name);
            if (string.IsNullOrWhiteSpace(created?.Id))
            {
                groupError = L["bookings.groupCreateFailed", "The group could not be started."];
                return;
            }

            form.GroupCode = created.Id;
            form.GroupName = string.IsNullOrWhiteSpace(created.Name) ? name : created.Name;
            groupSearch = "";
            await LoadStayGroupsAsync();
        }
        catch (Exception ex)
        {
