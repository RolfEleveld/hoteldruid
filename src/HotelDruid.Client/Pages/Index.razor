    private async Task MarkBookingArrivedAsync(BookingDto booking)
    {
      openReservationMenuId = null;
      openStayMenuId = null;
      openArrivalMenuId = null;
      openDepartureMenuId = null;

      if (string.IsNullOrWhiteSpace(booking.Id)
          || booking.Year <= 0
          || string.IsNullOrWhiteSpace(booking.ClientId)
          || string.IsNullOrWhiteSpace(booking.ArrivalDate)
          || string.IsNullOrWhiteSpace(booking.DepartureDate))
      {
        GoToBooking(booking.Id, booking.Year, edit: true);
        return;
      }

      var now = DateOnly.FromDateTime(DateTime.UtcNow).ToString("yyyy-MM-dd");
      var payload = new
      {
        Year = booking.Year,
        ClientId = booking.ClientId,
        RoomId = booking.RoomId,
        ArrivalDate = booking.ArrivalDate,
        DepartureDate = booking.DepartureDate,
        Status = string.IsNullOrWhiteSpace(booking.Status) ? "Arrived" : booking.Status,
        Notes = booking.Notes,
        ActualArrivalDate = now,
        ActualGuestCount = booking.ActualGuestCount.HasValue && booking.ActualGuestCount.Value > 0 ? booking.ActualGuestCount.Value : 1,
        PrepaidAmount = booking.PrepaidAmount
      };

      var response = await Http.PutAsJsonAsync($"/api/bookings/{booking.Year}/{booking.Id}", payload);
      if (!response.IsSuccessStatusCode)
      {
        GoToBooking(booking.Id, booking.Year, edit: true);
        return;
      }

      booking.ActualArrivalDate = now;
      if (!booking.ActualGuestCount.HasValue || booking.ActualGuestCount.Value <= 0)
      {
        booking.ActualGuestCount = 1;
      }

      StateHasChanged();
    }

