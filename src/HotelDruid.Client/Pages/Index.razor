    private string GetArrivalCheckpointLabel(BookingDto booking)
    {
      var actualArrival = TryParseDate(booking.ActualArrivalDate);
      if (!actualArrival.HasValue)
      {
        return L["Dashboard.Reservations.NotArrived"];
      }

      var guests = booking.ActualGuestCount.HasValue ? booking.ActualGuestCount.Value.ToString() : "-";
      return $"{L["Dashboard.Reservations.ArrivedOn"]}: {actualArrival.Value:yyyy-MM-dd} · {L["Dashboard.Reservations.ArrivedGuests"]}: {guests}";
    }

