    private async Task ResetLayoutToDefaultAsync()
    {
      isDashboardSettingsMenuOpen = false;

      foreach (var item in DefaultWidgetSizes)
      {
        widgetSizes[item.Key] = item.Value;
      }
      foreach (var item in DefaultWidgetVisibleCounts)
      {
        widgetVisibleCounts[item.Key] = item.Value;
      }
      calendarWidgetMonthCount = 3;
      roomSortMode = RoomSortMode.Priority;
      showRoomsWithoutBeds = false;
      compactRoomsView = true;
      arrivalsLookAheadDays = 0;
      roomsSearch = string.Empty;
      inventorySearch = string.Empty;

      await SavePreferencesAsync();
      await SaveSystemDefaultsAsync();
    }

    private async Task SaveSystemDefaultsAsync()
    {
      systemConfiguration ??= new SystemConfiguration
      {
        Id = "system",
        CreatedUtc = DateTime.UtcNow,
        UpdatedUtc = DateTime.UtcNow
      };

      systemConfiguration.Settings ??= new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
      systemConfiguration.Settings[HotelNameSettingKey] = hotelName;
      systemConfiguration.Settings[WidgetSizeDefaultsSettingKey] = JsonSerializer.Serialize(widgetSizes);
      systemConfiguration.Settings[RoomsDisplayCountDefaultsSettingKey] = GetWidgetVisibleCount("rooms").ToString();
      systemConfiguration.Settings[WidgetVisibleCountsDefaultsSettingKey] = JsonSerializer.Serialize(widgetVisibleCounts);
      systemConfiguration.Settings[RoomsSortModeDefaultsSettingKey] = roomSortMode.ToString();
      systemConfiguration.Settings[RoomsIncludeWithoutBedsDefaultsSettingKey] = showRoomsWithoutBeds.ToString();
      systemConfiguration.Settings[RoomsCompactViewDefaultsSettingKey] = compactRoomsView.ToString();
      systemConfiguration.Settings[ArrivalsLookAheadDaysSettingKey] = arrivalsLookAheadDays.ToString();
      systemConfiguration.UpdatedUtc = DateTime.UtcNow;

      await Http.PutAsJsonAsync("/api/system/configuration", systemConfiguration);
    }

