      if (!string.IsNullOrWhiteSpace(inventorySearch))
      {
        var term = inventorySearch.Trim();
        query = query.Where(i =>
          (!string.IsNullOrWhiteSpace(i.AssetId) && i.AssetId.Contains(term, StringComparison.OrdinalIgnoreCase))
          || GetInventoryAssignedRoom(i).Contains(term, StringComparison.OrdinalIgnoreCase));
