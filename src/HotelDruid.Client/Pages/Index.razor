    protected override async Task OnInitializedAsync()
    {
        try
        {
          activeYearDisplay = ActiveYearService.CurrentYear.ToString();
          var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
          var setupQuery = uri.Query.Contains("configure=true", StringComparison.OrdinalIgnoreCase) ? "?configure=true" : string.Empty;
          var setup = await Http.GetFromJsonAsync<SetupStatusDto>($"/api/system/setup/status{setupQuery}");
          if (setup?.RequiresSetup == true)
          {
            Navigation.NavigateTo($"/setup?reason={setup.Reason}");
            return;
          }

          clients = await TryGetFromJsonAsync<List<ClientDto>>("/api/clients");
          bookings = await TryGetFromJsonAsync<List<BookingDto>>("/api/bookings");
          systemConfiguration = await TryGetFromJsonAsync<SystemConfiguration>("/api/system/configuration");

          ApplySystemDefaults();

          await LoadRoomsAsync();
          await LoadInventoryAsync();
          await LoadWarehousesAsync();
        }
        catch
        {
          // API may not be running during early development — ignore
        }
    }

    private async Task<T?> TryGetFromJsonAsync<T>(string requestUri)
    {
      try
      {
        return await Http.GetFromJsonAsync<T>(requestUri);
      }
      catch
      {
        return default;
      }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
      if (!firstRender)
      {
        return;
      }

      try
      {
        var json = await JS.InvokeAsync<string?>("localStorage.getItem", "hoteldruid.dashboard.preferences");
        if (string.IsNullOrWhiteSpace(json))
        {
          return;
        }

        var prefs = JsonSerializer.Deserialize<DashboardPreferences>(json);
        var hasInvalidPreferenceValues = false;

        if (prefs?.WidgetSizes is not null)
        {
          foreach (var item in prefs.WidgetSizes)
          {
            if (widgetSizes.ContainsKey(item.Key)
                && WidgetSizeOptions.Contains(item.Value, StringComparer.OrdinalIgnoreCase))
            {
              widgetSizes[item.Key] = item.Value;
            }
            else
            {
              hasInvalidPreferenceValues = true;
            }
          }
        }

        if (prefs?.WidgetVisibleCounts is not null)
        {
          foreach (var item in prefs.WidgetVisibleCounts)
          {
            if (widgetVisibleCounts.ContainsKey(item.Key)
                && WidgetVisibleCountOptions.Contains(item.Value))
            {
              widgetVisibleCounts[item.Key] = item.Value;
            }
            else
            {
              hasInvalidPreferenceValues = true;
            }
          }
        }

        if (prefs?.RoomSortMode is not null
            && Enum.TryParse<RoomSortMode>(prefs.RoomSortMode, ignoreCase: true, out var parsedSortMode))
        {
          roomSortMode = parsedSortMode;
        }

        if (prefs?.ShowRoomsWithoutBeds is not null)
        {
          showRoomsWithoutBeds = prefs.ShowRoomsWithoutBeds.Value;
        }

        if (prefs?.CompactRoomsView is not null)
        {
          compactRoomsView = prefs.CompactRoomsView.Value;
        }

        // Restore calendarWidgetMonthCount if present and valid, else revert to default and remove invalid
        if (prefs?.CalendarWidgetMonthCount is int val)
        {
          if (CalendarWidgetMonthOptions.Contains(val))
          {
            calendarWidgetMonthCount = val;
          }
          else
          {
            calendarWidgetMonthCount = 3;
            hasInvalidPreferenceValues = true;
          }
        }

        if (hasInvalidPreferenceValues)
        {
          await SavePreferencesAsync();
        }

        StateHasChanged();
      }
      catch
      {
        // Ignore local storage failures.
      }
    }


