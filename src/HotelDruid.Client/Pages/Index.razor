    private void OnRoomSortModeChanged(ChangeEventArgs args)
    {
      var value = args.Value?.ToString();
      if (!string.IsNullOrWhiteSpace(value) && Enum.TryParse<RoomSortMode>(value, ignoreCase: true, out var parsedMode))
      {
        roomSortMode = parsedMode;
        _ = SavePreferencesAsync();
      }
    }

    private void OnShowRoomsWithoutBedsChanged(ChangeEventArgs args)
    {
      showRoomsWithoutBeds = args.Value switch
      {
        bool boolValue => boolValue,
        string stringValue when bool.TryParse(stringValue, out var parsed) => parsed,
        _ => showRoomsWithoutBeds
      };
      _ = SavePreferencesAsync();
      StateHasChanged();
    }

    private List<RoomDto> GetVisibleRooms()
    {
      IEnumerable<RoomDto> query = availableRooms;
      var unavailableRoomIds = GetUnavailableRoomIds(bookings, DateOnly.FromDateTime(DateTime.UtcNow));

      if (!showRoomsWithoutBeds)
      {
        query = query.Where(r => r.HasBeds);
      }

      query = query.Where(r => !unavailableRoomIds.Contains(r.Id));

      if (!string.IsNullOrWhiteSpace(roomsSearch))
      {
        var term = roomsSearch.Trim();
        query = query.Where(r =>
          (!string.IsNullOrWhiteSpace(r.Name) && r.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
          || (!string.IsNullOrWhiteSpace(r.HouseNumber) && r.HouseNumber.Contains(term, StringComparison.OrdinalIgnoreCase))
          || (r.FloorNumber?.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
          || r.Capacity.ToString().Contains(term, StringComparison.OrdinalIgnoreCase));
      }

      query = roomSortMode switch
      {
        RoomSortMode.Name => query.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase),
        RoomSortMode.Capacity => query.OrderByDescending(r => r.Capacity).ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase),
        RoomSortMode.Floor => query.OrderBy(r => r.FloorNumber ?? int.MaxValue).ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase),
        _ => query.OrderBy(r => r.Priority).ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase)
      };

      var result = query.ToList();
      if (selectedRoomId is not null && !result.Any(r => r.Id == selectedRoomId))
      {
        selectedRoomId = null;
      }

      return result;
    }

    private List<BookingDto> GetVisibleReservations()
    {
      if (bookings is null)
      {
        return new List<BookingDto>();
      }

      return bookings
        .Where(booking => !IsNonBlockingStatus(booking.Status) && !TryParseDate(booking.ActualArrivalDate).HasValue)
        .OrderByDescending(GetBookingSortDate)
        .ThenByDescending(booking => booking.Year)
        .ThenByDescending(booking => booking.Id, StringComparer.OrdinalIgnoreCase)
        .Take(GetWidgetVisibleCount("reservations"))
        .ToList();
    }

    private List<BookingDto> GetCurrentStays()
    {
      if (bookings is null)
      {
        return new List<BookingDto>();
      }

      var today = DateOnly.FromDateTime(DateTime.UtcNow);
      return bookings
        .Where(booking => IsCurrentStay(booking, today))
        .OrderBy(booking => GetRoomDisplayName(booking.RoomId), StringComparer.OrdinalIgnoreCase)
        .ThenBy(booking => GetBookingClientDisplayName(booking), StringComparer.OrdinalIgnoreCase)
        .Take(GetWidgetVisibleCount("stays"))
        .ToList();
    }

    private List<BookingDto> GetPendingArrivals()
    {
      if (bookings is null)
      {
        return new List<BookingDto>();
      }

      var today = DateOnly.FromDateTime(DateTime.UtcNow);
      return bookings
        .Where(booking => IsPendingArrival(booking, today, arrivalsLookAheadDays))
        .OrderBy(booking => TryParseDate(booking.ArrivalDate) ?? DateOnly.MaxValue)
        .ThenBy(booking => GetBookingClientDisplayName(booking), StringComparer.OrdinalIgnoreCase)
        .Take(GetWidgetVisibleCount("arrivals"))
        .ToList();
    }

    private List<BookingDto> GetPendingDepartures()
    {
      if (bookings is null)
      {
        return new List<BookingDto>();
      }

      var today = DateOnly.FromDateTime(DateTime.UtcNow);
      return bookings
        .Where(booking => IsPendingDeparture(booking, today))
        .OrderBy(booking => GetRoomDisplayName(booking.RoomId), StringComparer.OrdinalIgnoreCase)
        .ThenBy(booking => GetBookingClientDisplayName(booking), StringComparer.OrdinalIgnoreCase)
        .Take(GetWidgetVisibleCount("departures"))
        .ToList();
    }

    private static DateOnly GetBookingSortDate(BookingDto booking)
    {
      return TryParseDate(booking.ArrivalDate) ?? TryParseDate(booking.DepartureDate) ?? DateOnly.MinValue;
    }

    private static DateOnly? TryParseDate(string? value)
    {
      return DateOnly.TryParse(value, out var parsed) ? parsed : null;
    }

    private static bool IsCurrentStay(BookingDto booking, DateOnly today)
    {
      if (string.IsNullOrWhiteSpace(booking.RoomId)
          || IsNonBlockingStatus(booking.Status))
      {
        return false;
      }

      var actualArrival = TryParseDate(booking.ActualArrivalDate);
      var departure = TryParseDate(booking.DepartureDate);
      if (!actualArrival.HasValue || !departure.HasValue || departure.Value <= actualArrival.Value)
      {
        return false;
      }
      if (!booking.ActualGuestCount.HasValue || booking.ActualGuestCount.Value <= 0)
      {
        return false;
      }

      return actualArrival.Value <= today && today < departure.Value;
    }

    private static bool IsPendingArrival(BookingDto booking, DateOnly today, int lookAheadDays)
    {
      if (IsNonBlockingStatus(booking.Status))
      {
        return false;
      }

      if (TryParseDate(booking.ActualArrivalDate).HasValue)
      {
        return false;
      }

      var arrival = TryParseDate(booking.ArrivalDate);
      var departure = TryParseDate(booking.DepartureDate);
      if (!arrival.HasValue || !departure.HasValue || departure.Value <= arrival.Value)
      {
        return false;
      }

      var latestArrival = today.AddDays(Math.Max(0, lookAheadDays));
      return today <= arrival.Value && arrival.Value <= latestArrival;
    }

    private static bool IsPendingDeparture(BookingDto booking, DateOnly today)
    {
      if (string.IsNullOrWhiteSpace(booking.RoomId)
          || IsNonBlockingStatus(booking.Status))
      {
        return false;
      }

      var actualArrival = TryParseDate(booking.ActualArrivalDate);
      var departure = TryParseDate(booking.DepartureDate);
      if (!actualArrival.HasValue || !departure.HasValue || departure.Value <= actualArrival.Value)
      {
        return false;
      }

      return departure.Value == today;
    }

    private static HashSet<string> GetUnavailableRoomIds(IEnumerable<BookingDto>? currentBookings, DateOnly today)
    {
      var unavailable = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
      if (currentBookings is null)
      {
        return unavailable;
      }

      foreach (var booking in currentBookings)
      {
        if (IsCurrentStay(booking, today) && !string.IsNullOrWhiteSpace(booking.RoomId))
        {
          unavailable.Add(booking.RoomId);
        }
      }

      return unavailable;
    }

    private static bool IsNonBlockingStatus(string? status)
    {
      if (string.IsNullOrWhiteSpace(status))
      {
        return false;
      }

      return status.Contains("cancel", StringComparison.OrdinalIgnoreCase)
             || status.Contains("void", StringComparison.OrdinalIgnoreCase)
             || status.Contains("deleted", StringComparison.OrdinalIgnoreCase);
    }

    private string BuildCompactRoomSummary(RoomDto room)
    {
      var floor = room.FloorNumber?.ToString() ?? "-";
      var house = string.IsNullOrWhiteSpace(room.HouseNumber) ? "-" : room.HouseNumber;
      return $"{L["DashboardRooms.RoomCapacity", room.Capacity]} · {L["DashboardRooms.Detail.Floor"]}: {floor} · {L["DashboardRooms.Detail.House"]}: {house}";
    }

    private string GetBookingClientDisplayName(BookingDto booking)
    {
      if (clients is null || string.IsNullOrWhiteSpace(booking.ClientId))
      {
        return L["Dashboard.Reservations.UnknownClient"];
      }

      var client = clients.FirstOrDefault(current => string.Equals(current.Id, booking.ClientId, StringComparison.OrdinalIgnoreCase));
      return client is null ? L["Dashboard.Reservations.UnknownClient"] : BuildClientDisplayName(client);
    }

    private static string BuildClientDisplayName(ClientDto client)
    {
      if (!string.IsNullOrWhiteSpace(client.LastName) && !string.IsNullOrWhiteSpace(client.FirstName))
      {
        return $"{client.LastName}, {client.FirstName}";
      }

      if (!string.IsNullOrWhiteSpace(client.LastName))
      {
        return client.LastName;
      }

      if (!string.IsNullOrWhiteSpace(client.FirstName))
      {
        return client.FirstName;
      }

      return "Unknown client";
    }

    private string GetReservationDateRange(BookingDto booking)
    {
