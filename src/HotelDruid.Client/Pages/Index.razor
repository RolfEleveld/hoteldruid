    private async Task SavePreferencesAsync()
    {
      try
      {
        var prefs = new DashboardPreferences
        {
          WidgetSizes = widgetSizes,
          WidgetVisibleCounts = widgetVisibleCounts,
          RoomSortMode = roomSortMode.ToString(),
          ShowRoomsWithoutBeds = showRoomsWithoutBeds,
          CompactRoomsView = compactRoomsView,
          CalendarWidgetMonthCount = CalendarWidgetMonthOptions.Contains(calendarWidgetMonthCount) ? calendarWidgetMonthCount : 3
        };

        var json = JsonSerializer.Serialize(prefs);
        await JS.InvokeVoidAsync("localStorage.setItem", "hoteldruid.dashboard.preferences", json);
      }
      catch
      {
        // Ignore local storage failures.
      }
    }

    private void ApplySystemDefaults()
    {
      var settings = systemConfiguration?.Settings;
      if (settings is null)
      {
        return;
      }

      if (settings.TryGetValue(HotelNameSettingKey, out var configuredHotelName)
          && !string.IsNullOrWhiteSpace(configuredHotelName))
      {
        hotelName = configuredHotelName;
      }

      if (settings.TryGetValue(WidgetSizeDefaultsSettingKey, out var widgetSizeDefaults)
          && !string.IsNullOrWhiteSpace(widgetSizeDefaults))
      {
        var sizes = JsonSerializer.Deserialize<Dictionary<string, string>>(widgetSizeDefaults);
        if (sizes is not null)
        {
          foreach (var pair in sizes)
          {
            if (widgetSizes.ContainsKey(pair.Key)
                && WidgetSizeOptions.Contains(pair.Value, StringComparer.OrdinalIgnoreCase))
            {
              widgetSizes[pair.Key] = pair.Value;
            }
          }
        }
      }

      if (settings.TryGetValue(RoomsDisplayCountDefaultsSettingKey, out var roomCountValue)
          && int.TryParse(roomCountValue, out var parsedCount)
          && WidgetVisibleCountOptions.Contains(parsedCount))
      {
        widgetVisibleCounts["rooms"] = parsedCount;
      }

      if (settings.TryGetValue(WidgetVisibleCountsDefaultsSettingKey, out var widgetVisibleCountDefaults)
          && !string.IsNullOrWhiteSpace(widgetVisibleCountDefaults))
      {
        var visibleCounts = JsonSerializer.Deserialize<Dictionary<string, int>>(widgetVisibleCountDefaults);
        if (visibleCounts is not null)
        {
          foreach (var pair in visibleCounts)
          {
            if (widgetVisibleCounts.ContainsKey(pair.Key) && WidgetVisibleCountOptions.Contains(pair.Value))
            {
              widgetVisibleCounts[pair.Key] = pair.Value;
            }
          }
        }
      }

      if (settings.TryGetValue(RoomsSortModeDefaultsSettingKey, out var roomSortSetting)
          && Enum.TryParse<RoomSortMode>(roomSortSetting, ignoreCase: true, out var parsedRoomSort))
      {
        roomSortMode = parsedRoomSort;
      }

      if (settings.TryGetValue(RoomsIncludeWithoutBedsDefaultsSettingKey, out var includeWithoutBedsSetting)
          && bool.TryParse(includeWithoutBedsSetting, out var parsedIncludeWithoutBeds))
      {
        showRoomsWithoutBeds = parsedIncludeWithoutBeds;
      }

      if (settings.TryGetValue(RoomsCompactViewDefaultsSettingKey, out var compactViewSetting)
          && bool.TryParse(compactViewSetting, out var parsedCompactView))
      {
        compactRoomsView = parsedCompactView;
      }

      if (settings.TryGetValue(ArrivalsLookAheadDaysSettingKey, out var arrivalsWindow)
          && int.TryParse(arrivalsWindow, out var parsedArrivalsWindow)
          && parsedArrivalsWindow >= 0
          && parsedArrivalsWindow <= 14)
      {
        arrivalsLookAheadDays = parsedArrivalsWindow;
      }
    }

