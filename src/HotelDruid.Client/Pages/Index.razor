      var room = availableRooms.FirstOrDefault(current => string.Equals(current.Id, roomId, StringComparison.OrdinalIgnoreCase));
      return string.IsNullOrWhiteSpace(room?.Name)
        ? L["Dashboard.Reservations.UnknownRoom", "Unknown room"]
        : room.Name;
    }

