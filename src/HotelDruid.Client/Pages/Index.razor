      if (!CalendarWidgetMonthOptions.Contains(count))
      {
        calendarWidgetMonthCount = 3;
        _ = SavePreferencesAsync();
      }
      else
      {
        calendarWidgetMonthCount = count;
        _ = SavePreferencesAsync();
      }
    }

