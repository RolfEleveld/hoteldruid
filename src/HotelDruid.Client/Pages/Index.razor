@page "/"
@using System.Net.Http.Json
@using System.Text.Json
@using HotelDruid.Shared.Configuration
@using Microsoft.Extensions.Localization
@using HotelDruid.Client.Localization
@using HotelDruid.Client.Services
@inject HttpClient Http
@inject IRoomApiService RoomApiService
@inject IInventoryApiService InventoryApiService
@inject IWarehouseApiService WarehouseApiService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IActiveYearService ActiveYearService
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Index.PageTitle"]</PageTitle>

<div class="landing-hero py-5 bg-light">
  <div class="container-fluid px-3 px-xl-4 dashboard-layout-fluid">
    <div class="mb-4">
      <div class="text-start">
        @if (!isEditingHotelName)
        {
          <div class="d-flex align-items-center gap-2 mb-2">
            <p class="lead text-muted mb-0">@L["Index.HeroSubtitle"]</p>
            <div class="position-relative">
                <button type="button" class="btn btn-outline-secondary btn-sm widget-menu-button" title="@L["Dashboard.Settings.Menu"]" @onclick="ToggleDashboardSettingsMenu">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                @if (isDashboardSettingsMenuOpen)
                {
                  <div class="dropdown-menu show shadow-sm dashboard-dropdown dashboard-dropdown-start">
                    <button class="dropdown-item" @onclick="BeginEditHotelName">@L["Dashboard.Settings.EditHotelName"]</button>
                    <button class="dropdown-item" @onclick="SaveCurrentLayoutAsDefaultAsync">@L["Dashboard.Settings.SaveDefaults"]</button>
                    <button class="dropdown-item" @onclick="ResetLayoutToDefaultAsync">@L["Dashboard.Settings.ResetDefaults"]</button>
                  </div>
                }
            </div>
          </div>
        }
        else
        {
          <div class="d-flex flex-wrap gap-2 align-items-center">
            <input class="form-control form-control-lg hotel-name-input" @bind="hotelNameDraft" />
            <button type="button" class="btn btn-primary btn-sm" @onclick="SaveHotelNameAsync">@L["Dashboard.Settings.Save"]</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEditHotelName">@L["Dashboard.Settings.Cancel"]</button>
          </div>
        }
      </div>
    </div>

    <div class="row gx-3 gy-3 features dashboard-widgets">
      <div class="@GetWidgetColumnClass("reservations")">
        <div class="card feature-card border-primary dashboard-widget h-100">
          @WidgetHeader("reservations", "bi-calendar-check-fill", L["Index.Feature.Reservations.Title"], "Dashboard.Widget.VisibleCount.Reservations", "Index.QuickAction.NewReservation", "/bookings/new")
          <div class="card-body d-flex flex-column">
            <p class="text-muted small">@L["Index.Feature.Reservations.Subtitle"]</p>
            <p class="small fw-semibold">@L["Dashboard.Count.Bookings", bookings?.Count ?? 0]</p>
            @if (GetVisibleReservations().Count > 0)
            {
              <ul class="list-group list-group-flush mb-3 reservation-widget-list">
                @foreach (var booking in GetVisibleReservations())
                {
                  <li class="list-group-item px-0 py-2 reservation-widget-item">
                    <div class="d-flex justify-content-between align-items-start gap-2 reservation-row-header">
                      <button type="button" class="btn btn-link p-0 text-start reservation-details-link" @onclick="() => GoToBooking(booking.Id, booking.Year, edit: true)">
                        <div class="reservation-card-main">
                          <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                              <div class="fw-semibold reservation-link">@GetBookingClientDisplayName(booking)</div>
                              <div class="text-muted small">@GetReservationDateRange(booking)</div>
                            </div>
                            <span class="badge text-bg-light reservation-status">@GetBookingStatusLabel(booking)</span>
                          </div>
                          <div class="small text-muted mt-1">@GetReservationRoomLabel(booking)</div>
                          <div class="small text-muted">@GetArrivalCheckpointLabel(booking)</div>
                        </div>
                      </button>

                      <div class="position-relative">
                        <button type="button" class="btn btn-sm btn-outline-secondary widget-menu-button"
                                title="@L["Dashboard.Reservations.RowMenu"]" @onclick="() => ToggleReservationMenu(GetBookingMenuKey(booking))">
                          <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        @if (openReservationMenuId == GetBookingMenuKey(booking))
                        {
                          <div class="dropdown-menu dropdown-menu-end show shadow-sm dashboard-dropdown">
                            <button class="dropdown-item" @onclick="() => GoToBooking(booking.Id, booking.Year, edit: true)">@L["Dashboard.Reservations.Action.OpenReservation"]</button>
                            <button class="dropdown-item" @onclick="() => MarkBookingArrivedAsync(booking)">@L["Dashboard.Reservations.Menu.Arrived"]</button>
                            <button class="dropdown-item" @onclick="() => GoToBookingCosts(booking.Id, booking.Year)">@L["Dashboard.Stays.Action.AddCosts"]</button>
                            <button class="dropdown-item" @onclick="() => GoToBookingGuests(booking.Id, booking.ClientId, booking.Year)">@L["Dashboard.Stays.Action.AddGuests"]</button>
                            @if (!string.IsNullOrWhiteSpace(booking.ClientId))
                            {
                              <button class="dropdown-item" @onclick="() => GoToClient(booking.ClientId)">@L["Dashboard.Stays.Action.OpenClient"]</button>
                              <button class="dropdown-item" @onclick="() => GoToClientWishes(booking.ClientId)">@L["Dashboard.Stays.Action.RecordWishes"]</button>
                            }
                          </div>
                        }
                      </div>
                    </div>
                  </li>
                }
              </ul>
            }
            else
            {
              <p class="small text-muted">@L["Dashboard.Reservations.Empty"]</p>
            }
            <div class="d-flex gap-2 mt-auto">
              <a class="btn btn-success btn-sm" href="/bookings/new">@L["Index.QuickAction.NewReservation"]</a>
              <a class="btn btn-outline-primary btn-sm" href="/bookings">@L["Index.Feature.Reservations.Button"]</a>
            </div>
          </div>
        </div>
      </div>

      <div class="@GetWidgetColumnClass("arrivals")">
        <div class="card feature-card border-secondary dashboard-widget h-100">
          @WidgetHeader("arrivals", "bi-calendar-event", L["Dashboard.Arrivals.Title"], "Dashboard.Widget.VisibleCount.Arrivals", "Index.QuickAction.NewReservation", "/bookings/new")
          <div class="card-body d-flex flex-column">
            <p class="text-muted small">@L["Dashboard.Arrivals.Subtitle", arrivalsLookAheadDays]</p>
            <p class="small fw-semibold">@L["Dashboard.Arrivals.Count", GetPendingArrivals().Count]</p>
            @if (GetPendingArrivals().Count > 0)
            {
              <ul class="list-group list-group-flush mb-3 reservation-widget-list">
                @foreach (var arrival in GetPendingArrivals())
                {
                  <li class="list-group-item px-0 py-2 reservation-widget-item">
                    <div class="d-flex justify-content-between align-items-start gap-2 reservation-row-header">
                      <button type="button" class="btn btn-link p-0 text-start reservation-details-link" @onclick="() => GoToBooking(arrival.Id, arrival.Year, edit: true)">
                        <div class="reservation-card-main">
                          <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                              <div class="fw-semibold reservation-link">@GetBookingClientDisplayName(arrival)</div>
                              <div class="text-muted small">@GetReservationDateRange(arrival)</div>
                            </div>
                            <span class="badge text-bg-warning-subtle">@L["Dashboard.Arrivals.Badge"]</span>
                          </div>
                          <div class="small text-muted mt-1">@GetReservationRoomLabel(arrival)</div>
                        </div>
                      </button>

                      <div class="position-relative">
                        <button type="button" class="btn btn-sm btn-outline-secondary widget-menu-button"
                                title="@L["Dashboard.Arrivals.RowMenu"]" @onclick="() => ToggleArrivalMenu(GetBookingMenuKey(arrival))">
                          <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        @if (openArrivalMenuId == GetBookingMenuKey(arrival))
                        {
                          <div class="dropdown-menu dropdown-menu-end show shadow-sm dashboard-dropdown">
                            <button class="dropdown-item" @onclick="() => GoToBooking(arrival.Id, arrival.Year, edit: true)">@L["Dashboard.Reservations.Action.OpenReservation"]</button>
                            <button class="dropdown-item" @onclick="() => MarkBookingArrivedAsync(arrival)">@L["Dashboard.Reservations.Menu.Arrived"]</button>
                            <button class="dropdown-item" @onclick="() => GoToBookingGuests(arrival.Id, arrival.ClientId, arrival.Year)">@L["Dashboard.Stays.Action.AddGuests"]</button>
                            @if (!string.IsNullOrWhiteSpace(arrival.ClientId))
                            {
                              <button class="dropdown-item" @onclick="() => GoToClient(arrival.ClientId)">@L["Dashboard.Stays.Action.OpenClient"]</button>
                              <button class="dropdown-item" @onclick="() => GoToClientWishes(arrival.ClientId)">@L["Dashboard.Stays.Action.RecordWishes"]</button>
                            }
                          </div>
                        }
                      </div>
                    </div>
                  </li>
                }
              </ul>
            }
            else
            {
              <p class="small text-muted">@L["Dashboard.Arrivals.Empty"]</p>
            }

            <div class="d-flex gap-2 mt-auto">
              <a class="btn btn-success btn-sm" href="/bookings/new">@L["Index.QuickAction.NewReservation"]</a>
              <a class="btn btn-outline-secondary btn-sm" href="/bookings?view=arrivals">@L["Dashboard.Arrivals.Button"]</a>
            </div>
          </div>
        </div>
      </div>

      <div class="@GetWidgetColumnClass("stays")">
        <div class="card feature-card border-danger dashboard-widget h-100">
          @WidgetHeader("stays", "bi-door-open-fill", L["Dashboard.Stays.Title"], "Dashboard.Widget.VisibleCount.Stays", "Index.QuickAction.NewStay", "/bookings/new?mode=stay")
          <div class="card-body d-flex flex-column">
            <p class="text-muted small">@L["Dashboard.Stays.Subtitle"]</p>
            <p class="small fw-semibold">@L["Dashboard.Stays.Count", GetCurrentStays().Count]</p>
            @if (GetCurrentStays().Count > 0)
            {
              <ul class="list-group list-group-flush mb-3 reservation-widget-list">
                @foreach (var stay in GetCurrentStays())
                {
                  <li class="list-group-item px-0 py-2 reservation-widget-item stay-widget-item">
                    <div class="d-flex justify-content-between align-items-start gap-2 reservation-row-header">
                      <button type="button" class="btn btn-link p-0 text-start reservation-details-link" @onclick="() => GoToBooking(stay.Id, stay.Year, edit: true)">
                        <div class="reservation-card-main">
                          <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                              <div class="fw-semibold">@GetRoomDisplayName(stay.RoomId)</div>
                              <div class="reservation-link small">@GetBookingClientDisplayName(stay)</div>
                            </div>
                            <span class="badge text-bg-danger-subtle">@L["Dashboard.Stays.ActiveBadge"]</span>
                          </div>
                          <div class="small text-muted mt-1">@GetReservationDateRange(stay)</div>
                        </div>
                      </button>

                      <div class="position-relative">
                        <button type="button" class="btn btn-sm btn-outline-secondary widget-menu-button"
                                title="@L["Dashboard.Stays.RowMenu"]" @onclick="() => ToggleStayMenu(GetBookingMenuKey(stay))">
                          <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        @if (openStayMenuId == GetBookingMenuKey(stay))
                        {
                          <div class="dropdown-menu dropdown-menu-end show shadow-sm dashboard-dropdown">
                            <button class="dropdown-item" @onclick="() => GoToBooking(stay.Id, stay.Year, edit: true)">@L["Dashboard.Stays.Action.OpenReservation"]</button>
                            <button class="dropdown-item" @onclick="() => GoToBookingCosts(stay.Id, stay.Year)">@L["Dashboard.Stays.Action.AddCosts"]</button>
                            <button class="dropdown-item" @onclick="() => GoToBookingGuests(stay.Id, stay.ClientId, stay.Year)">@L["Dashboard.Stays.Action.AddGuests"]</button>
                            @if (!string.IsNullOrWhiteSpace(stay.ClientId))
                            {
                              <button class="dropdown-item" @onclick="() => GoToClient(stay.ClientId)">@L["Dashboard.Stays.Action.OpenClient"]</button>
                              <button class="dropdown-item" @onclick="() => GoToClientWishes(stay.ClientId)">@L["Dashboard.Stays.Action.RecordWishes"]</button>
                            }
                          </div>
                        }
                      </div>
                    </div>
                  </li>
                }
              </ul>
            }
            else
            {
              <p class="small text-muted">@L["Dashboard.Stays.Empty"]</p>
            }

            <div class="d-flex gap-2 mt-auto">
              <a class="btn btn-success btn-sm" href="/bookings/new?mode=stay">@L["Index.QuickAction.NewStay"]</a>
              <a class="btn btn-outline-primary btn-sm" href="/bookings?view=stays">@L["Dashboard.Stays.Button"]</a>
            </div>
          </div>
        </div>
      </div>

      <div class="@GetWidgetColumnClass("departures")">
        <div class="card feature-card border-dark dashboard-widget h-100">
          @WidgetHeader("departures", "bi-box-arrow-right", L["Dashboard.Departures.Title"], "Dashboard.Widget.VisibleCount.Departures", "Index.QuickAction.NewReservation", "/bookings/new")
          <div class="card-body d-flex flex-column">
            <p class="text-muted small">@L["Dashboard.Departures.Subtitle"]</p>
            <p class="small fw-semibold">@L["Dashboard.Departures.Count", GetPendingDepartures().Count]</p>
            @if (GetPendingDepartures().Count > 0)
            {
              <ul class="list-group list-group-flush mb-3 reservation-widget-list">
                @foreach (var departure in GetPendingDepartures())
                {
                  <li class="list-group-item px-0 py-2 reservation-widget-item stay-widget-item">
                    <div class="d-flex justify-content-between align-items-start gap-2 reservation-row-header">
                      <button type="button" class="btn btn-link p-0 text-start reservation-details-link" @onclick="() => GoToBooking(departure.Id, departure.Year, edit: true)">
                        <div class="reservation-card-main">
                          <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                              <div class="fw-semibold">@GetRoomDisplayName(departure.RoomId)</div>
                              <div class="reservation-link small">@GetBookingClientDisplayName(departure)</div>
                            </div>
                            <span class="badge text-bg-secondary-subtle">@L["Dashboard.Departures.Badge"]</span>
                          </div>
                          <div class="small text-muted mt-1">@GetReservationDateRange(departure)</div>
                        </div>
                      </button>

                      <div class="position-relative">
                        <button type="button" class="btn btn-sm btn-outline-secondary widget-menu-button"
                                title="@L["Dashboard.Departures.RowMenu"]" @onclick="() => ToggleDepartureMenu(GetBookingMenuKey(departure))">
                          <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        @if (openDepartureMenuId == GetBookingMenuKey(departure))
                        {
                          <div class="dropdown-menu dropdown-menu-end show shadow-sm dashboard-dropdown">
                            <button class="dropdown-item" @onclick="() => GoToBooking(departure.Id, departure.Year, edit: true)">@L["Dashboard.Stays.Action.OpenReservation"]</button>
                            <button class="dropdown-item" @onclick="() => GoToBookingCosts(departure.Id, departure.Year)">@L["Dashboard.Stays.Action.AddCosts"]</button>
                            @if (!string.IsNullOrWhiteSpace(departure.ClientId))
                            {
                              <button class="dropdown-item" @onclick="() => GoToClient(departure.ClientId)">@L["Dashboard.Stays.Action.OpenClient"]</button>
                            }
                          </div>
                        }
                      </div>
                    </div>
                  </li>
                }
              </ul>
            }
            else
            {
              <p class="small text-muted">@L["Dashboard.Departures.Empty"]</p>
            }

            <div class="d-flex gap-2 mt-auto">
              <a class="btn btn-dark btn-sm" href="/booking-costs">@L["Dashboard.Stays.Action.AddCosts"]</a>
              <a class="btn btn-outline-dark btn-sm" href="/bookings?view=departures">@L["Dashboard.Departures.Button"]</a>
            </div>
          </div>
        </div>
      </div>

      <div class="@GetWidgetColumnClass("clients")">
        <div class="card feature-card border-warning dashboard-widget h-100">
          @WidgetHeader("clients", "bi-people-fill", L["Index.Feature.Clients.Title"], "Dashboard.Widget.VisibleCount.Clients", "Index.QuickAction.NewClient", "/clients/new")
          <div class="card-body d-flex flex-column">
            <p class="text-muted small">@L["Index.Feature.Clients.Subtitle"]</p>
            <p class="small fw-semibold">@L["Dashboard.Count.Clients", clients?.Count ?? 0]</p>
            @if (clients is { Count: > 0 })
            {
              <ul class="list-group list-group-flush mb-3">
                @foreach (var client in clients.OrderBy(c => c.LastName, StringComparer.OrdinalIgnoreCase).ThenBy(c => c.FirstName, StringComparer.OrdinalIgnoreCase).Take(GetWidgetVisibleCount("clients")))
                {
                  <li class="list-group-item list-group-item-action px-0 py-1 small text-start" @onclick="() => GoToClient(client.Id)">
                    <strong>@BuildClientDisplayName(client)</strong>
                  </li>
                }
              </ul>
            }
            <div class="d-flex gap-2 mt-auto">
              <a class="btn btn-warning btn-sm" href="/clients/new">@L["Index.QuickAction.NewClient"]</a>
              <a class="btn btn-outline-warning btn-sm" href="/clients">@L["Index.Feature.Clients.Button"]</a>
            </div>
          </div>
        </div>
      </div>

      <div class="@GetWidgetColumnClass("rooms")">
        <div class="card feature-card border-success dashboard-widget h-100">
          @WidgetHeader("rooms", "bi-house-fill", L["DashboardRooms.Title"], "Dashboard.Widget.VisibleCount.Rooms", "DashboardRooms.Menu.AddRoom", "/rooms")
          <div class="card-body d-flex flex-column">
            <p class="text-muted small">@L["DashboardRooms.Subtitle"]</p>

            <div class="room-widget-toolbar mb-2">
              <input class="form-control form-control-sm"
                     placeholder="@L["DashboardRooms.FilterPlaceholder"]"
                     @bind="roomsSearch"
                     @bind:event="oninput" />
              <div class="d-flex gap-2 mt-2">
                <select class="form-select form-select-sm" value="@roomSortMode" @onchange="OnRoomSortModeChanged">
                  <option value="@RoomSortMode.Priority">@L["DashboardRooms.Sort.Priority"]</option>
                  <option value="@RoomSortMode.Name">@L["DashboardRooms.Sort.Name"]</option>
                  <option value="@RoomSortMode.Capacity">@L["DashboardRooms.Sort.Capacity"]</option>
                  <option value="@RoomSortMode.Floor">@L["DashboardRooms.Sort.Floor"]</option>
                </select>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        title="@L["DashboardRooms.ToggleCompact"]"
                        @onclick="ToggleCompactRoomsView">
                  @if (compactRoomsView)
                  {
                    <span>@L["DashboardRooms.Compact.On"]</span>
                  }
                  else
                  {
                    <span>@L["DashboardRooms.Compact.Off"]</span>
                  }
                </button>
              </div>
              <div class="form-check mt-2 mb-0">
                <input class="form-check-input" type="checkbox" id="rooms-show-without-beds" checked="@showRoomsWithoutBeds" @onchange="OnShowRoomsWithoutBedsChanged" />
                <label class="form-check-label small" for="rooms-show-without-beds">
                  @L["DashboardRooms.IncludeWithoutBeds"]
                </label>
              </div>
            </div>

            @if (roomsLoading)
            {
              <p class="small text-muted">@L["DashboardRooms.Loading"]</p>
            }
            else
            {
              var visibleRooms = GetVisibleRooms();

              if (!visibleRooms.Any())
              {
                <p class="small text-muted">@L["DashboardRooms.FilterEmpty"]</p>
              }
              else
              {
                <ul class="list-group list-group-flush actionable-room-list mb-3">
                  @foreach (var room in visibleRooms.Take(GetWidgetVisibleCount("rooms")))
                {
                  var isSelected = selectedRoomId == room.Id;
                  <li class="list-group-item px-0 py-2">
                    <div class="d-flex justify-content-between align-items-start gap-2 room-row-header">
                      <button type="button" class="btn btn-link p-0 text-start room-link" @onclick="() => GoToRoomManagement(room.Id)">
                        <span class="fw-semibold room-link-title">@room.Name</span>
                        @if (compactRoomsView)
                        {
                          <span class="text-muted small room-link-meta">@BuildCompactRoomSummary(room)</span>
                        }
                        else
                        {
                          <span class="text-muted small room-link-meta">@L["DashboardRooms.RoomCapacity", room.Capacity]</span>
                        }
                      </button>

                      <div class="position-relative">
                        <button type="button" class="btn btn-sm btn-outline-secondary widget-menu-button"
                                title="@L["DashboardRooms.RoomMenu"]" @onclick="() => ToggleRoomMenu(room.Id)">
                          <i class="bi bi-three-dots-vertical"></i>
                        </button>

                        @if (openRoomMenuId == room.Id)
                        {
                          <div class="dropdown-menu dropdown-menu-end show shadow-sm dashboard-dropdown">
                            <button class="dropdown-item" @onclick="() => GoToNewReservation(room.Id)">@L["DashboardRooms.Menu.NewReservation"]</button>
                            <div class="dropdown-divider"></div>
                            <button class="dropdown-item" @onclick="() => GoToRoomManagement(room.Id)">@L["DashboardRooms.Menu.ViewDetails"]</button>
                            <button class="dropdown-item" @onclick="() => GoToRoomManagement(room.Id)">@L["DashboardRooms.Menu.ManageRoom"]</button>
                            <button class="dropdown-item text-danger" @onclick="() => DeleteRoomAsync(room.Id)">@L["DashboardRooms.Menu.DeleteRoom"]</button>
                          </div>
                        }
                      </div>
                    </div>

                    @if (isSelected && !compactRoomsView)
                    {
                      <div class="room-details mt-2">
                        <div class="small text-muted">@L["DashboardRooms.Detail.Floor"]: @(room.FloorNumber?.ToString() ?? "-")</div>
                        <div class="small text-muted">@L["DashboardRooms.Detail.House"]: @(string.IsNullOrWhiteSpace(room.HouseNumber) ? "-" : room.HouseNumber)</div>
                        <div class="small text-muted">@L["DashboardRooms.Detail.Priority"]: @room.Priority</div>
                      </div>
                    }
                  </li>
                }
                </ul>
              }
            }

            <div class="d-flex gap-2 mt-auto">
              <a class="btn btn-outline-success btn-sm" href="/rooms">@L["DashboardRooms.AllRooms"]</a>
            </div>
          </div>
        </div>
      </div>


      <div class="@GetWidgetColumnClass("calendar")">
        <div class="card feature-card border-purple dashboard-widget h-100">
          @WidgetHeader("calendar", "bi-calendar2-week-fill", L["Index.Feature.Calendar.Title"], "Dashboard.Widget.VisibleCount.Calendar", "Dashboard.Widget.Menu.AddYear", "/years")
          <div class="card-body d-flex flex-column">
            <p class="text-muted small">@L["Index.Feature.Calendar.Subtitle"]</p>
            <p class="small fw-semibold">@L["Dashboard.Count.ActiveYear", activeYearDisplay]</p>
            <div class="calendar-months-widget-list mb-2">
              @foreach (var month in GetCalendarWidgetMonths())
              {
                <button type="button" class="calendar-month-widget-box" @onclick="() => GoToCalendarMonth(month.Year, month.Month)">
                  <div class="calendar-month-widget-label">@month.ToString("MMM yyyy")</div>
                </button>
              }
            </div>
            <div class="d-flex gap-2 mt-auto">
              <a class="btn btn-outline-dark btn-sm w-100" href="/calendar">@L["Index.Feature.Calendar.Button"]</a>
            </div>
          </div>
        </div>
      </div>


      <div class="@GetWidgetColumnClass("inventory")">
        <div class="card feature-card border-dark dashboard-widget h-100">
          @WidgetHeader("inventory", "bi-boxes", L["Index.Feature.Inventory.Title"], "Dashboard.Widget.VisibleCount.Inventory", "Dashboard.Widget.Menu.AddInventoryItem", "/inventory")
          <div class="card-body d-flex flex-column">
