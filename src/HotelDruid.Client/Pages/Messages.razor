@page "/messages"
@using HotelDruid.Client.Services
@using HotelDruid.Shared
@inject IMessageApiService MessageApi
@inject HttpClient Http

@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["messages.title"]</PageTitle>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@L["dispatch.title"]</h5>
                    @if (dispatch is null)
                    {
                        <div>@L["common.loading"]</div>
                    }
                    else if (dispatch.Count == 0)
                    {
                        <div class="text-muted">@L["dispatch.empty"]</div>
                    }
                    else
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>@L["dispatch.channel"]</th>
                                    <th>@L["dispatch.to"]</th>
                                    <th>@L["dispatch.subject"]</th>
                                    <th>@L["dispatch.due"]</th>
                                    <th>@L["dispatch.status"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in dispatch)
                                {
                                    <tr>
                                        <td>@Phrase("dispatch.channel", row.Channel)</td>
                                        <td>@row.To</td>
                                        <td>@row.Subject</td>
                                        <td>@(row.DeliverBy is null ? "—" : HotelTime.Display(row.DeliverBy.Value, HotelClock.ZoneId).ToString("g"))</td>
                                        <td>@Phrase("dispatch.status", row.Status)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@L["messages.list"]</h5>
                    <button class="btn btn-success btn-sm w-100 mb-2" @onclick="AddNew"><span class="bi bi-plus"></span> @L["messages.new"]</button>
                    @if (items == null)
                    {
                        <div>@L["common.loading"]</div>
                    }
                    else if (items.Count == 0)
                    {
                        <div class="alert alert-info">@L["messages.emptyList"]</div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var item in items)
                            {
                                <a class="list-group-item list-group-item-action @(selected?.Id == item.Id ? "active" : "")" @onclick="() => Select(item)">
                                    @item.Sender — @item.Body?.Substring(0, Math.Min(item.Body?.Length ?? 0, 30))
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@L["messages.compose"]</h5>
                    <div class="mb-3">
                        <label class="form-label">@L["messages.sender"]</label>
                        <input class="form-control" @bind="editSender" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["messages.body"]</label>
                        <textarea class="form-control" @bind="editBody"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["messages.type"]</label>
                        <input class="form-control" @bind="editType" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["messages.recipients"]</label>
                        <input class="form-control" @bind="editRecipients" />
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary" @onclick="Save">@L["messages.send"]</button>
                        @if (selected != null)
                        {
                            <button class="btn btn-warning" @onclick="MarkRead">@L["messages.markRead"]</button>
                            <button class="btn btn-secondary" @onclick="Archive">@L["messages.archive"]</button>
                            <button class="btn btn-danger" @onclick="Delete">@L["common.delete"]</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@L["common.details"]</h5>
                    @if (selected != null)
                    {
                        <dl class="row">
                            <dt class="col-4">@L["messages.id"]</dt><dd class="col-8">@selected.Id</dd>
                            <dt class="col-4">@L["messages.status"]</dt><dd class="col-8">@Phrase("messages.status", selected.Status)</dd>
                            <dt class="col-4">@L["messages.type"]</dt><dd class="col-8">@Phrase("messages.type", selected.MessageType)</dd>
                            <dt class="col-4">@L["messages.sent"]</dt><dd class="col-8">@(string.IsNullOrWhiteSpace(selected.CreatedAt) ? "—" : selected.CreatedAt)</dd>
                            <dt class="col-4">@L["messages.seen"]</dt><dd class="col-8">@(string.IsNullOrWhiteSpace(selected.SeenAt) ? "—" : selected.SeenAt)</dd>
                        </dl>
                    }
                    else
                    {
                        <div class="text-muted">@L["messages.selectPrompt"]</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<MessageApiDto>? items;
    private List<DispatchMessageDto>? dispatch;
    private MessageApiDto? selected;
    private string editSender = string.Empty;
    private string editBody = string.Empty;
    private string editType = "internal";
    private string editRecipients = string.Empty;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        items = await MessageApi.GetMessagesAsync();
        try
        {
            dispatch = await Http.GetFromJsonAsync<List<DispatchMessageDto>>("/api/dispatch") ?? new();
        }
        catch
        {
            dispatch = new();
        }
        StateHasChanged();
    }

    private void Select(MessageApiDto item)
    {
        selected = item;
        editSender = item.Sender ?? string.Empty;
        editBody = item.Body ?? string.Empty;
        editType = item.MessageType ?? "internal";
        editRecipients = item.RecipientUserIds ?? string.Empty;
    }

    private void AddNew()
    {
        selected = null;
        editSender = string.Empty;
        editBody = string.Empty;
        editType = "internal";
        editRecipients = string.Empty;
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(editSender) || string.IsNullOrWhiteSpace(editBody)) return;
        var dto = new MessageApiDto(null, editType, null, editSender, editBody, editRecipients, null, null);
        await MessageApi.CreateMessageAsync(dto);
        await Load();
    }

    private async Task MarkRead()
    {
        if (selected == null) return;
        await MessageApi.MarkReadAsync(selected.Id!);
        await Load();
    }

    private async Task Archive()
    {
        if (selected == null) return;
        await MessageApi.ArchiveAsync(selected.Id!);
        await Load();
    }

    private async Task Delete()
    {
        if (selected == null) return;
        await MessageApi.DeleteMessageAsync(selected.Id!);
        selected = null;
        await Load();
    }

    private string Phrase(string group, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "—";
        var text = L[$"{group}.{value.Trim().ToLowerInvariant()}"];
        return text.ResourceNotFound ? value : text.Value;
    }
}


