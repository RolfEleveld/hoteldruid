@page "/cancelled-bookings"
@using HotelDruid.Client.Services
@inject ICancelledBookingApiService CancelledBookingApi
@inject IClientApiService ClientApi
@inject IRoomApiService RoomApiService

@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["cancelledBookings.title", "Cancelled Bookings"]</PageTitle>
<div class="container-fluid">
    <div class="row align-items-center mb-2 mt-2">
        <div class="col-auto"><h5 class="mb-0">Cancelled Bookings</h5></div>
        <div class="col-auto d-flex gap-1">
            <input class="form-control form-control-sm" type="date" @bind="rangeFrom" aria-label="@L["bookings.stayFrom"]" />
            <input class="form-control form-control-sm" type="date" @bind="rangeTo" aria-label="@L["bookings.stayTo"]" />
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAll">@L["common.load", "Load"]</button>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 border-end">
            @if (records is null) { <p><em>@L["common.loading", "Loading..."]</em></p> }
            else if (records.Count == 0) { <p class="text-muted">No cancelled bookings</p> }
            else
            {
                <ul class="list-group">
                    @foreach (var r in records)
                    {
                        <li class="list-group-item list-group-item-action @(selected?.Id == r.Id ? "active" : "")"
                            style="cursor:pointer" @onclick="() => SelectRecord(r)">
                            <div class="fw-bold">@r.Year — @GetClientDisplayName(r.ClientId)</div>
                            <small>@r.ArrivalDate → @r.DepartureDate | Cancelled: @r.CancelledAt</small>
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="col-md-8">
            @if (selected is not null)
            {
                <h5 class="mt-1">@L["common.details", "Details"]</h5>
                <dl>
                    <dt>Client</dt><dd>@GetClientDisplayName(selected.ClientId)</dd>
                    <dt>Room</dt><dd>@GetRoomDisplayName(selected.RoomId)</dd>
                    <dt>Status</dt><dd>@selected.Status</dd>
                    <dt>Arrival</dt><dd>@selected.ArrivalDate</dd>
                    <dt>Departure</dt><dd>@selected.DepartureDate</dd>
                    <dt>Cancelled At</dt><dd>@selected.CancelledAt</dd>
                    <dt>Notes</dt><dd>@selected.Notes</dd>
                </dl>
                @if (!string.IsNullOrEmpty(errorMsg)) { <div class="alert alert-danger mt-2">@errorMsg</div> }
                <button class="btn btn-sm btn-outline-danger" @onclick="DeleteSelected">Remove from Archive</button>
            }
        </div>
    </div>
</div>

@code {
    private List<CancelledBookingClientDto>? records;
    private List<ClientDto> clients = new();
    private List<RoomDto> rooms = new();
    private CancelledBookingClientDto? selected;
    private string errorMsg = "";
    private DateOnly rangeFrom = new(DateTime.Today.Year, 1, 1);
    private DateOnly rangeTo = new(DateTime.Today.Year, 12, 31);

    protected override async Task OnInitializedAsync()
    {
        clients = await ClientApi.GetAllAsync();
        rooms = await RoomApiService.GetRoomsAsync();
        await LoadAll();
    }

    private async Task LoadAll()
    {
        if (rangeTo < rangeFrom)
        {
            rangeTo = rangeFrom;
        }

        var combined = new List<CancelledBookingClientDto>();
        for (var year = rangeFrom.Year; year <= rangeTo.Year; year++)
        {
            combined.AddRange(await CancelledBookingApi.ListAsync(year));
        }

        records = combined
            .Where(item => StayOverlaps(item, rangeFrom, rangeTo))
            .GroupBy(item => item.Id ?? string.Empty, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .ToList();
    }

    private static bool StayOverlaps(CancelledBookingClientDto item, DateOnly from, DateOnly to)
    {
        if (!DateOnly.TryParse(item.ArrivalDate, out var arrival))
        {
            return item.Year >= from.Year && item.Year <= to.Year;
        }

        var departure = DateOnly.TryParse(item.DepartureDate, out var parsed) ? parsed : arrival;
        return arrival <= to && departure >= from;
    }
    private void SelectRecord(CancelledBookingClientDto r) { selected = r; errorMsg = ""; }

    private async Task DeleteSelected()
    {
        if (selected?.Id is null) return;
        try { await CancelledBookingApi.DeleteAsync(selected.Year, selected.Id); selected = null; await LoadAll(); }
        catch { errorMsg = "Delete failed."; }
    }

    private string GetClientDisplayName(string? clientId)
    {
        if (string.IsNullOrWhiteSpace(clientId))
        {
            return "Unknown client";
        }

        var client = clients.FirstOrDefault(current => string.Equals(current.Id, clientId, StringComparison.OrdinalIgnoreCase));
        if (client is null)
        {
            return "Unknown client";
        }

        if (!string.IsNullOrWhiteSpace(client.LastName) && !string.IsNullOrWhiteSpace(client.FirstName))
        {
            return $"{client.LastName}, {client.FirstName}";
        }

        return client.LastName ?? client.FirstName ?? "Unknown client";
    }

    private string GetRoomDisplayName(string? roomId)
    {
        if (string.IsNullOrWhiteSpace(roomId))
        {
            return "Unassigned room";
        }

        var room = rooms.FirstOrDefault(current => string.Equals(current.Id, roomId, StringComparison.OrdinalIgnoreCase));
        return string.IsNullOrWhiteSpace(room?.Name) ? "Unknown room" : room.Name;
    }
}


