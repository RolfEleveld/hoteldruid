@page "/warehouses"
@using HotelDruid.Client.Services
@inject IWarehouseApiService WarehouseApi
@inject IInventoryApiService InventoryApi
@inject IAssetApiService AssetApi
@inject NavigationManager Navigation

@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["warehouses.title", "Warehouses"]</PageTitle>

<div class="container-fluid warehouses-manager">
    <div class="row g-3 h-100">
        <!-- LEFT: Warehouse List -->
        <div class="col-md-3">
            <div class="panel panel-default h-100 d-flex flex-column">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["warehouses.title", "Warehouses"]</h3>
                </div>
                <div class="panel-body flex-grow-1 overflow-auto">
                    <button class="btn btn-success btn-sm w-100 mb-3" @onclick="AddNew">
                        <span class="bi bi-plus"></span> @L["warehouses.add", "Add Warehouse"]
                    </button>
                    <div class="mb-3">
                        <input type="text" class="form-control form-control-sm" @bind="warehouseListFilter" @bind:event="oninput"
                               placeholder="@L["warehouses.filterPlaceholder", "Filter warehouses"]" />
                    </div>
                    @if (items == null)
                    {
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">@L["common.loading", "Loading..."]</span>
                        </div>
                    }
                    else if (FilteredItems.Count == 0)
                    {
                        <div class="alert alert-info">@L["warehouses.emptyList", "No warehouses yet."]</div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var w in FilteredItems)
                            {
                                <button type="button" class="list-group-item list-group-item-action @(selected?.Id == w.Id ? "active" : "")" @onclick="() => Select(w)">
                                    <div class="fw-semibold">@w.Name</div>
                                    <small class="text-muted">@w.Code</small>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- MIDDLE: Edit Form -->
        <div class="col-md-6">
            @if (selected != null || editingNew)
            {
                <div class="panel panel-default h-100 d-flex flex-column">
                    <div class="panel-heading">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h3 class="panel-title mb-0">@(editingNew ? L["warehouses.newWarehouse", "New Warehouse"] : (selected?.Name ?? string.Empty))</h3>
                                <small class="text-muted">@L["warehouses.editTitle", "Manage Warehouse"]</small>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(validationMessage))
                        {
                            <div class="alert alert-warning alert-sm mt-2 mb-0" role="alert">@validationMessage</div>
                        }
                    </div>
                    <div class="panel-body flex-grow-1 overflow-auto">
                        <div class="mb-3"><label class="form-label">@L["warehouses.nameLabel", "Name"]</label><input class="form-control" @bind="edit.Name" /></div>
                        <div class="mb-3"><label class="form-label">@L["warehouses.codeLabel", "Code"]</label><input class="form-control" @bind="edit.Code" /></div>
                        <div class="mb-3"><label class="form-label">@L["warehouses.descriptionLabel", "Description"]</label><textarea class="form-control" @bind="edit.Description"></textarea></div>
                        <div class="mb-3"><label class="form-label">@L["warehouses.floorLabel", "Floor Number"]</label><input class="form-control" @bind="edit.FloorNumber" /></div>
                        <div class="mb-3"><label class="form-label">@L["warehouses.houseLabel", "House Number"]</label><input class="form-control" @bind="edit.HouseNumber" /></div>
                    </div>
                    <div class="panel-footer">
                        <div class="btn-group w-100" role="group">
                            <button class="btn btn-primary flex-grow-1" @onclick="Save">@L["common.save", "Save"]</button>
                            @if (selected != null)
                            {
                                <button class="btn btn-danger flex-grow-1" @onclick="Delete">@L["common.delete", "Delete"]</button>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="panel panel-default h-100 d-flex align-items-center justify-content-center">
                    <div class="panel-body text-center text-muted">
                        <p class="mb-2"><span class="bi bi-arrow-left" style="font-size: 2rem;"></span></p>
                        <p>@L["warehouses.selectPrompt", "Select a warehouse"]</p>
                    </div>
                </div>
            }
        </div>

        <!-- RIGHT: Details -->
        <div class="col-md-3">
            <div class="panel panel-default h-100 d-flex flex-column">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["warehouses.detailsTitle", "Warehouse details"]</h3>
                </div>
                <div class="panel-body flex-grow-1 overflow-auto">
                    @if (selected != null)
                    {
                        <dl class="row">
                            <dt class="col-5">ID</dt><dd class="col-7">@selected.Id</dd>
                            <dt class="col-5">@L["warehouses.codeLabel", "Code"]</dt><dd class="col-7">@selected.Code</dd>
                        </dl>
                        <section class="client-section client-section-inventory mt-3">
                            <h4 class="client-section-title">@L["warehouses.inventoryTitle", "Inventory in this warehouse"]</h4>
                            @if (isInventoryLoading)
                            {
                                <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                                <span class="ms-2">@L["common.loading", "Loading..."]</span>
                            }
                            else if (warehouseInventory is null || !warehouseInventory.Any())
                            {
                                <div class="alert alert-info mb-0">@L["warehouses.inventoryEmpty", "No inventory stored in this warehouse."]</div>
                            }
                            else
                            {
                                <div class="list-group">
                                    @foreach (var inv in warehouseInventory)
                                    {
                                        <a class="list-group-item list-group-item-action" href="@GetInventoryUrl(inv)">
                                            <div class="fw-semibold"><strong>@ResolveAssetName(inv.AssetId)</strong></div>
                                            <div class="small text-muted">@L["inventory.quantity", "Quantity"]: @inv.Quantity</div>
                                        </a>
                                    }
                                </div>
                            }
                        </section>
                    }
                    else { <div class="text-muted">@L["warehouses.selectPrompt", "Select a warehouse"]</div> }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.client-section { border-left: 4px solid #d8dee7; border-radius: 4px; background: #fff; padding: 14px; margin-bottom: 14px; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.04); }
.client-section-inventory { border-left-color: #2196f3; }
.client-section-title { font-size: 1rem; font-weight: 700; margin-bottom: 0.75rem; }
</style>

@code {
    [SupplyParameterFromQuery(Name = "id")]
    public string? SelectedId { get; set; }

    private List<WarehouseDto>? items;
    private List<InventoryDto>? warehouseInventory;
    private List<AssetDto> assets = new();
    private bool isInventoryLoading;
    private int inventoryLoadVersion;
    private WarehouseDto? selected;
    private WarehouseEditModel edit = new();
    private string? validationMessage;
    private string warehouseListFilter = string.Empty;
    private bool editingNew;

    private List<WarehouseDto> FilteredItems
    {
        get
        {
            if (items is null) return new();
            if (string.IsNullOrWhiteSpace(warehouseListFilter)) return items;
            var term = warehouseListFilter.Trim();
            return items.Where(w =>
                (w.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || (w.Code?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Load();
        ApplySelectedWarehouseFromQuery();
    }

    protected override Task OnParametersSetAsync()
    {
        ApplySelectedWarehouseFromQuery();
        return Task.CompletedTask;
    }

    private void ApplySelectedWarehouseFromQuery()
    {
        if (items is null || string.IsNullOrWhiteSpace(SelectedId))
            return;

        var warehouse = items.FirstOrDefault(w => string.Equals(w.Id, SelectedId, StringComparison.OrdinalIgnoreCase));
        if (warehouse is not null)
        {
            Select(warehouse);
            Navigation.NavigateTo("/warehouses", replace: true);
        }
    }

    private async Task Load()
    {
        items = await WarehouseApi.GetWarehousesAsync();
        assets = await AssetApi.GetAssetsAsync();
    }

    private async Task LoadWarehouseInventory(string warehouseId)
    {
        var version = ++inventoryLoadVersion;
        isInventoryLoading = true;
        warehouseInventory = null;
        try
        {
            var all = await InventoryApi.GetInventoryAsync();
            if (version != inventoryLoadVersion)
                return;

            warehouseInventory = all
                .Where(i => string.Equals(i.WarehouseId, warehouseId, StringComparison.OrdinalIgnoreCase))
                .OrderBy(i => ResolveAssetName(i.AssetId), StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        finally
        {
            if (version == inventoryLoadVersion)
            {
                isInventoryLoading = false;
                StateHasChanged();
            }
        }
    }

    private string GetInventoryUrl(InventoryDto item)
        => string.IsNullOrWhiteSpace(item.Id) ? "/inventory" : $"/inventory?selectedId={Uri.EscapeDataString(item.Id)}";

    private string ResolveAssetName(string? assetId)
    {
        if (string.IsNullOrWhiteSpace(assetId))
            return L["inventory.none", "None"];

        var asset = assets.FirstOrDefault(item => string.Equals(item.Id, assetId, StringComparison.OrdinalIgnoreCase));
        return string.IsNullOrWhiteSpace(asset?.Name) ? assetId : asset.Name;
    }

    private void Select(WarehouseDto w)
    {
        validationMessage = null;
        selected = w;
        editingNew = false;
        edit = WarehouseEditModel.FromDto(w);
        if (!string.IsNullOrWhiteSpace(w.Id))
            _ = LoadWarehouseInventory(w.Id);
    }

    private void AddNew()
    {
        validationMessage = null;
        selected = null;
        editingNew = true;
        warehouseInventory = null;
        edit = new WarehouseEditModel();
    }

    private async Task Save()
    {
        validationMessage = null;
        var dto = edit.ToDto();
        if (selected == null) await WarehouseApi.CreateWarehouseAsync(dto);
        else
        {
            if (!TryResolveSelectedId(out var selectedId))
            {
                return;
            }

            await WarehouseApi.UpdateWarehouseAsync(selectedId, dto);
        }

        await Load();
    }

    private async Task Delete()
    {
        validationMessage = null;
        if (selected == null) return;

        if (!TryResolveSelectedId(out var selectedId))
        {
            return;
        }

        await WarehouseApi.DeleteWarehouseAsync(selectedId);
        selected = null;
        await Load();
    }

    private bool TryResolveSelectedId(out string selectedId)
    {
        selectedId = string.Empty;
        if (selected == null || string.IsNullOrWhiteSpace(selected.Id))
        {
            validationMessage = "Unable to continue: the selected warehouse has no valid ID.";
            return false;
        }

        if (items?.Any(w => string.Equals(w.Id, selected.Id, StringComparison.Ordinal)) != true)
        {
            validationMessage = "The selected warehouse is no longer available. Refresh and try again.";
            return false;
        }

        selectedId = selected.Id;
        return true;
    }

    private class WarehouseEditModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Code { get; set; }
        public string? Description { get; set; }
        public string? FloorNumber { get; set; }
        public string? HouseNumber { get; set; }

        public WarehouseDto ToDto() => new(Id: string.Empty, Name: Name, Code: Code, Description: Description, FloorNumber: FloorNumber, HouseNumber: HouseNumber, CreatedAt: null);
        public static WarehouseEditModel FromDto(WarehouseDto d) => new() { Name = d.Name ?? string.Empty, Code = d.Code, Description = d.Description, FloorNumber = d.FloorNumber, HouseNumber = d.HouseNumber };
    }
}


