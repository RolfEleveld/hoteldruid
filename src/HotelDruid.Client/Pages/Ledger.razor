@page "/ledger"
@using HotelDruid.Client.Services
@using HotelDruid.Shared
@inject IBookingFinanceApiService FinanceApi
@inject IBookingApiService BookingApi
@inject IRoomApiService RoomApi
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["ledger.title", "General ledger"]</PageTitle>
<div class="container-fluid">
    <div class="row align-items-center mb-2 mt-2">
        <div class="col-auto"><h5 class="mb-0">@L["ledger.title", "General ledger"]</h5></div>
        <div class="col-auto">
            <label class="me-1">@L["ledger.from", "From"]</label>
            <input class="form-control d-inline-block" type="date" @bind="fromDate" style="width:150px" />
            <label class="ms-2 me-1">@L["ledger.to", "To"]</label>
            <input class="form-control d-inline-block" type="date" @bind="toDate" style="width:150px" />
            <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="Load">@L["common.load", "Load"]</button>
        </div>
    </div>
    <div class="row">
        <div class="col-md-3 border-end">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="unassigned" @bind="unassignedOnly" />
                <label class="form-check-label" for="unassigned">@L["ledger.unassigned", "Hotel cash only (no booking)"]</label>
            </div>
            <label class="mt-2">@L["ledger.account", "Account"]</label>
            <select class="form-select" @bind="accountCode">
                <option value="">@L["ledger.allAccounts", "All accounts"]</option>
                @foreach (var account in accounts)
                {
                    <option value="@account.Code">@account.Code · @L[$"chart.account.{account.Code}"]</option>
                }
            </select>
            <label class="mt-2">@L["ledger.booking", "Booking reference"]</label>
            <select class="form-select" @bind="BookingFilter" disabled="@unassignedOnly">
                <option value="">@L["ledger.allBookings", "All bookings"]</option>
                @foreach (var booking in catalog.Bookings)
                {
                    <option value="@booking.Id">@catalog.Label(booking)</option>
                }
            </select>
            <p class="text-muted small mt-2">@L["ledger.hint", "Empty booking reference means petty cash, purchases, or a non-staying guest."]</p>
        </div>
        <div class="col-md-9">
            @if (lines is null)
            {
                <p><em>@L["common.loading", "Loading..."]</em></p>
            }
            else if (!VisibleLines.Any())
            {
                <p class="text-muted">@L["ledger.empty", "No ledger lines in this range."]</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>@L["ledger.date", "Date"]</th>
                            <th>@L["ledger.account", "Account"]</th>
                            <th>@L["ledger.bookingColumn", "Booking"]</th>
                            <th>@L["ledger.payer", "Payer"]</th>
                            <th>@L["ledger.recordedBy", "Recorded by"]</th>
                            <th class="text-end">@L["ledger.debit", "Debit"]</th>
                            <th class="text-end">@L["ledger.credit", "Credit"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in VisibleLines)
                        {
                            <tr>
                                <td>@HotelTime.Display(line.Timestamp, HotelClock.ZoneId).ToString("yyyy-MM-dd")</td>
                                <td>@line.AccountCode <small class="text-muted">@line.EntryType</small></td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(line.BookingId))
                                    {
                                        <span class="text-muted">@L["ledger.hotel", "Hotel"]</span>
                                    }
                                    else
                                    {
                                        <a href="@BookingReference.Href(line.BookingId)">@BookingLabel(line.BookingId)</a>
                                        @if (!string.IsNullOrWhiteSpace(line.PrintedInvoiceNumber))
                                        {
                                            <div class="small text-muted">@line.PrintedInvoiceNumber</div>
                                        }
                                    }
                                </td>
                                <td>@(line.PayerName ?? line.Description)</td>
                                <td>@line.CreatedBy</td>
                                <td class="text-end">@(line.Debit == 0 ? "" : line.Debit.ToString("0.00"))</td>
                                <td class="text-end">@(line.Credit == 0 ? "" : line.Credit.ToString("0.00"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="5">@L["ledger.total", "Total"]</th>
                            <th class="text-end">@VisibleDebit.ToString("0.00")</th>
                            <th class="text-end">@VisibleCredit.ToString("0.00")</th>
                        </tr>
                        <tr>
                            <th colspan="5">@L["ledger.balance", "Balance (debit − credit)"]</th>
                            <th colspan="2" class="text-end">@((VisibleDebit - VisibleCredit).ToString("0.00"))</th>
                        </tr>
                    </tfoot>
                </table>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "bookingId")]
    public string? BookingQuery { get; set; }

    [SupplyParameterFromQuery(Name = "account")]
    public string? AccountQuery { get; set; }

    private List<LedgerLineDto>? lines;
    private List<ChartAccountDto> accounts = [];
    private BookingCatalog catalog = BookingCatalog.From(null, null);
    private DateTime fromDate = HotelClock.BusinessToday.AddDays(-30).ToDateTime(TimeOnly.MinValue);
    private DateTime toDate = HotelClock.BusinessToday.ToDateTime(TimeOnly.MinValue);
    private string? bookingId;
    private string accountCode = "";
    private bool unassignedOnly;

    private IEnumerable<LedgerLineDto> VisibleLines
        => (lines ?? []).Where(line => string.IsNullOrWhiteSpace(accountCode) || string.Equals(line.AccountCode, accountCode, StringComparison.Ordinal)).OrderBy(line => line.Timestamp);

    private decimal VisibleDebit => VisibleLines.Sum(line => line.Debit);
    private decimal VisibleCredit => VisibleLines.Sum(line => line.Credit);

    private string BookingFilter
    {
        get => bookingId ?? string.Empty;
        set => bookingId = string.IsNullOrWhiteSpace(value) ? null : value;
    }

    protected override async Task OnInitializedAsync()
    {
        bookingId = string.IsNullOrWhiteSpace(BookingQuery) ? null : BookingQuery;
        accountCode = AccountQuery ?? "";
        try
        {
            accounts = await FinanceApi.ListChartOfAccountsAsync();
        }
        catch
        {
            accounts = [];
        }
        try
        {
            var bookings = await BookingApi.ListAsync(includeDeleted: true);
            var rooms = await RoomApi.GetRoomsAsync();
            catalog = BookingCatalog.From(bookings, rooms);
        }
        catch
        {
            catalog = BookingCatalog.From(null, null);
        }

        await Load();
    }

    private string BookingLabel(string? id)
    {
        var label = catalog.Label(id);
        return string.IsNullOrWhiteSpace(label) ? L["ledger.bookingUnknown", "Booking"] : label;
    }

    private async Task Load()
    {
        lines = null;
        var from = DateOnly.FromDateTime(fromDate);
        var to = DateOnly.FromDateTime(toDate);
        lines = await FinanceApi.ListLedgerLinesAsync(from, to, unassignedOnly ? null : bookingId, unassignedOnly);
    }
}
