@page "/extra-costs"
@using HotelDruid.Client.Services
@inject IExtraCostApiService ExtraCostApi

@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["extraCosts.title", "Extra Costs"]</PageTitle>
<div class="container-fluid">
    <div class="row align-items-center mb-2 mt-2">
        <div class="col-auto"><h5 class="mb-0">@L["extraCosts.title", "Extra Costs"]</h5></div>
    </div>
    <div class="row">
        <div class="col-md-3 border-end">
            <button class="btn btn-sm btn-primary mb-2" @onclick="NewRecord">+ @L["common.new", "New"]</button>
            @if (records is null) { <p><em>@L["common.loading", "Loading..."]</em></p> }
            else if (records.Count == 0) { <p class="text-muted">@L["extraCosts.empty", "No extra costs"]</p> }
            else
            {
                <ul class="list-group">
                    @foreach (var r in records)
                    {
                        <li class="list-group-item list-group-item-action @(selected?.Id == r.Id ? "active" : "")"
                            style="cursor:pointer" @onclick="() => SelectRecord(r)">
                            <div class="fw-bold">@r.ExtraCostName</div>
                            <small>@FormatRange(r)</small>
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="col-md-6 border-end">
            @if (editing)
            {
                <h5 class="mt-1">@(isNew ? L["extraCosts.new", "New Extra Cost"] : L["extraCosts.edit", "Edit Extra Cost"])</h5>
                <div class="row g-2">
                    <div class="col-6"><label>@L["extras.validFrom"]</label><input class="form-control" type="date" @bind="form.ValidFrom" /></div>
                    <div class="col-6"><label>@L["extras.validUntil"]</label><input class="form-control" type="date" @bind="form.ValidUntil" /></div>
                    <div class="col-12"><div class="form-text">@L["extras.datesHelp"]</div></div>
                    <div class="col-6"><label>@L["extraCosts.nameLabel", "Extra Cost Name"]</label><input class="form-control" @bind="form.ExtraCostName" /></div>
                    <div class="col-6"><label>@L["extraCosts.costTypeLabel", "Cost Type"]</label><input class="form-control" @bind="form.CostType" /></div>
                    <div class="col-6"><label>@L["extraCosts.baseValueLabel", "Base Value"]</label><input class="form-control" type="number" step="0.01" @bind="form.BaseValue" /></div>
                    <div class="col-6"><label>@L["extraCosts.percentageValueLabel", "Percentage Value"]</label><input class="form-control" type="number" step="0.01" @bind="form.PercentageValue" /></div>
                    <div class="col-6"><label>@L["extraCosts.taxPercentageLabel", "Tax %"]</label><input class="form-control" type="number" step="0.01" @bind="form.TaxPercentage" /></div>
                    <div class="col-6"><label>@L["extraCosts.categoryLabel", "Category"]</label><input class="form-control" @bind="form.Category" /></div>
                    <div class="col-6"><label>@L["extraCosts.numberLimitLabel", "Number Limit"]</label><input class="form-control" type="number" @bind="form.NumberLimit" /></div>
                </div>
                @if (!string.IsNullOrEmpty(errorMsg)) { <div class="alert alert-danger mt-2">@errorMsg</div> }
                <div class="mt-3">
                    <button class="btn btn-primary me-2" @onclick="Save">@L["common.save", "Save"]</button>
                    <button class="btn btn-secondary" @onclick="Cancel">@L["common.cancel", "Cancel"]</button>
                </div>
            }
        </div>
        <div class="col-md-3">
            @if (selected is not null && !editing)
            {
                <h5 class="mt-1">@L["common.details", "Details"]</h5>
                <dl>
                    <dt>@L["extras.validFrom"]</dt><dd>@selected.ValidFrom?.ToString("yyyy-MM-dd")</dd>
                    <dt>@L["extras.validUntil"]</dt><dd>@selected.ValidUntil?.ToString("yyyy-MM-dd")</dd>
                    <dt>@L["extraCosts.nameLabel", "Extra Cost Name"]</dt><dd>@selected.ExtraCostName</dd>
                    <dt>@L["extraCosts.costTypeLabel", "Cost Type"]</dt><dd>@selected.CostType</dd>
                    <dt>@L["extraCosts.baseValueLabel", "Base Value"]</dt><dd>@selected.BaseValue</dd>
                    <dt>@L["extraCosts.categoryLabel", "Category"]</dt><dd>@selected.Category</dd>
                </dl>
                <button class="btn btn-sm btn-outline-primary me-1" @onclick="EditSelected">@L["common.edit", "Edit"]</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="DeleteSelected">@L["common.delete", "Delete"]</button>
            }
        </div>
    </div>
</div>

@code {
    private List<ExtraCostDto>? records;
    private ExtraCostDto? selected;
    private bool editing, isNew;
    private string errorMsg = "";
    private FormModel form = new();

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll() => records = await ExtraCostApi.ListAsync();

    private void NewRecord() { form = new(); isNew = true; editing = true; selected = null; errorMsg = ""; }
    private void SelectRecord(ExtraCostDto r) { selected = r; editing = false; }
    private void EditSelected()
    {
        if (selected is null) return;
        var from = selected.ValidFrom ?? new DateOnly(selected.Year, 1, 1);
        var until = selected.ValidUntil ?? new DateOnly(selected.Year, 12, 31);
        form = new()
        {
            ValidFrom = from,
            ValidUntil = until,
            ExtraCostName = selected.ExtraCostName,
            CostType = selected.CostType,
            BaseValue = selected.BaseValue,
            PercentageValue = selected.PercentageValue,
            TaxPercentage = selected.TaxPercentage,
            Category = selected.Category,
            NumberLimit = selected.NumberLimit
        };
        isNew = false; editing = true; errorMsg = "";
    }

    private async Task Save()
    {
        if (form.ValidFrom is null || form.ValidUntil is null)
        {
            errorMsg = "Valid from and valid until are required.";
            return;
        }

        var year = isNew ? form.ValidFrom.Value.Year : selected!.Year;
        var dto = new ExtraCostDto(selected?.Id, year, form.ExtraCostName, form.CostType, form.BaseValue, form.PercentageValue, form.TaxPercentage, form.Category, form.NumberLimit, form.ValidFrom, form.ValidUntil);
        try
        {
            if (isNew) await ExtraCostApi.CreateAsync(dto);
            else await ExtraCostApi.UpdateAsync(selected!.Year, selected.Id!, dto);
            editing = false;
            await LoadAll();
        }
        catch { errorMsg = "Save failed."; }
    }

    private void Cancel() { editing = false; errorMsg = ""; }

    private async Task DeleteSelected()
    {
        if (selected?.Id is null) return;
        try { await ExtraCostApi.DeleteAsync(selected.Year, selected.Id); selected = null; await LoadAll(); }
        catch { errorMsg = "Delete failed."; }
    }

    private static string FormatRange(ExtraCostDto extra)
    {
        var from = extra.ValidFrom ?? new DateOnly(extra.Year, 1, 1);
        var until = extra.ValidUntil ?? new DateOnly(extra.Year, 12, 31);
        return $"{from:yyyy-MM-dd} → {until:yyyy-MM-dd}";
    }

    private class FormModel
    {
        public DateOnly? ValidFrom { get; set; }
        public DateOnly? ValidUntil { get; set; }
        public string? ExtraCostName { get; set; }
        public string? CostType { get; set; }
        public double? BaseValue { get; set; }
        public double? PercentageValue { get; set; }
        public double? TaxPercentage { get; set; }
        public string? Category { get; set; }
        public int? NumberLimit { get; set; }
    }
}
