@page "/inventory"
@using HotelDruid.Client.Services
@using Microsoft.AspNetCore.Components
@inject IInventoryApiService InventoryApi
@inject IAssetApiService AssetApi
@inject IWarehouseApiService WarehouseApi
@inject IRoomApiService RoomApi
@inject NavigationManager Navigation

@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["inventory.title", "Inventory"]</PageTitle>

<div class="container-fluid inventory-manager">
    <div class="row g-3 h-100">
        <!-- LEFT: Inventory List -->
        <div class="col-md-3">
            <div class="panel panel-default h-100 d-flex flex-column">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["inventory.listTitle", "List of Inventory"]</h3>
                </div>
                <div class="panel-body flex-grow-1 overflow-auto">
                    <button class="btn btn-success btn-sm w-100 mb-3" @onclick="AddNew">
                        <span class="bi bi-plus"></span> @L["inventory.addItem", "Add Item"]
                    </button>
                    <div class="mb-3">
                        <input type="text" class="form-control form-control-sm" @bind="inventoryListFilter" @bind:event="oninput"
                               placeholder="@L["inventory.searchPlaceholder", "Search by asset, room, or warehouse"]" />
                    </div>
                    @if (rows == null)
                    {
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">@L["common.loading", "Loading..."]</span>
                        </div>
                    }
                    else if (FilteredRows.Count == 0)
                    {
                        <div class="alert alert-info">@L["inventory.emptyList", "No inventory items yet."]</div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var r in FilteredRows)
                            {
                                <button type="button" class="list-group-item list-group-item-action @(selected?.Id == r.Id ? "active" : "")" @onclick="() => Select(r)">
                                    <div class="fw-semibold">@GetAssetName(r)</div>
                                    <small class="text-muted">@GetLocationName(r) · @r.Quantity</small>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- MIDDLE: Edit Form -->
        <div class="col-md-6">
            @if (selected != null || rows?.Count == 0 || editingNew)
            {
                <div class="panel panel-default h-100 d-flex flex-column">
                    <div class="panel-heading">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h3 class="panel-title mb-0">@(editingNew ? L["inventory.addItem", "Add Item"] : GetInventoryListLabel(selected!))</h3>
                                <small class="text-muted">@L["inventory.updateTitle", "Update Inventory"]</small>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(validationMessage))
                        {
                            <div class="alert alert-warning alert-sm mt-2 mb-0" role="alert">@validationMessage</div>
                        }
                    </div>
                    <div class="panel-body flex-grow-1 overflow-auto">
                        <div class="mb-3">
                            <label class="form-label">@L["inventory.asset", "Asset"]</label>
                            <select class="form-select" @bind="edit.AssetId">
                                <option value="">@L["inventory.none", "None"]</option>
                                @foreach (var asset in assets.OrderBy(asset => asset.Name, StringComparer.OrdinalIgnoreCase))
                                {
                                    <option value="@asset.Id">@asset.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["inventory.room", "Room"]</label>
                            <select class="form-select" @bind="edit.RoomId" @bind:after="OnRoomChanged">
                                <option value="">@L["inventory.none", "None"]</option>
                                @foreach (var room in rooms)
                                {
                                    <option value="@room.Id">@room.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["inventory.warehouse", "Warehouse"]</label>
                            <input class="form-control"
                                   value="@warehouseSearch"
                                   placeholder="@L["inventory.selectWarehouse", "Select warehouse..."]"
                                   @oninput="OnWarehouseSearchChanged" />
                            @if (warehouseMatches.Count > 0)
                            {
                                <div class="list-group mt-2">
                                    @foreach (var warehouse in warehouseMatches)
                                    {
                                        <button type="button" class="list-group-item list-group-item-action" @onclick="() => SelectWarehouse(warehouse)">
                                            <div class="fw-semibold">@ResolveWarehouseDisplayName(warehouse)</div>
                                        </button>
                                    }
                                </div>
                            }
                            @if (selectedWarehouse is not null)
                            {
                                <div class="border rounded p-2 bg-light-subtle mt-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="fw-semibold">@ResolveWarehouseDisplayName(selectedWarehouse)</div>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearWarehouseSelection">@L["bookings.clearSelection", "Clear"]</button>
                                    </div>
                                </div>
                            }
                            @if (selectedWarehouse is null && !string.IsNullOrWhiteSpace(warehouseSearch))
                            {
                                <div class="text-muted small mt-2">@L["inventory.noWarehouseMatch", "No warehouse matches this search."]</div>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["inventory.quantity", "Quantity"]</label>
                            <input type="number" class="form-control" @bind="edit.Quantity" min="0" />
                        </div>
                    </div>
                    <div class="panel-footer">
                        <div class="btn-group w-100" role="group">
                            <button class="btn btn-primary flex-grow-1" @onclick="Save">@L["common.save", "Save"]</button>
                            @if (selected != null)
                            {
                                <button class="btn btn-danger flex-grow-1" @onclick="Delete">@L["common.delete", "Delete"]</button>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="panel panel-default h-100 d-flex align-items-center justify-content-center">
                    <div class="panel-body text-center text-muted">
                        <p class="mb-2"><span class="bi bi-arrow-left" style="font-size: 2rem;"></span></p>
                        <p>@L["inventory.selectPrompt", "Select an inventory item"]</p>
                    </div>
                </div>
            }
        </div>

        <!-- RIGHT: Details -->
        <div class="col-md-3">
            <div class="panel panel-default h-100 d-flex flex-column">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["inventory.detailsTitle", "Inventory details"]</h3>
                </div>
                <div class="panel-body flex-grow-1 overflow-auto">
                    @if (selected != null)
                    {
                        <dl class="row">
                            <dt class="col-5">@L["inventory.serial", "Serial"]</dt>
                            <dd class="col-7">
                                <div>@selected.Id</div>
                                <div class="text-muted small">@L["inventory.serialHint", "A QR label for this item uses this serial."]</div>
                            </dd>
                            <dt class="col-5">@L["inventory.asset", "Asset"]</dt><dd class="col-7">@ResolveAssetName(selected.AssetId)</dd>
                            <dt class="col-5">@L["inventory.room", "Room"]</dt><dd class="col-7">@ResolveRoomName(selected.RoomId)</dd>
                            <dt class="col-5">@L["inventory.warehouse", "Warehouse"]</dt>
                            <dd class="col-7">
                                @if (!string.IsNullOrWhiteSpace(selected.WarehouseId))
                                {
                                    <button class="btn btn-link p-0" @onclick="() => GoToWarehouse(selected.WarehouseId)">@ResolveWarehouseName(selected.WarehouseId)</button>
                                }
                                else { @L["inventory.none", "None"] }
                            </dd>
                            <dt class="col-5">@L["inventory.quantity", "Quantity"]</dt><dd class="col-7">@selected.Quantity</dd>
                        </dl>

                        @if (!string.IsNullOrWhiteSpace(selected.AssetId))
                        {
                            var otherLocations = GetSameAssetLocations(selected);
                            <hr />
                            <h6>@L["inventory.assetLocations", "Other locations for this asset"]</h6>
                            @if (otherLocations.Any())
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var loc in otherLocations)
                                    {
                                        <li class="list-group-item px-0 py-1">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="small">
                                                    @if (!string.IsNullOrWhiteSpace(loc.WarehouseId))
                                                    {
                                                        <button class="btn btn-link btn-sm p-0" @onclick="() => GoToWarehouse(loc.WarehouseId)">@ResolveWarehouseName(loc.WarehouseId)</button>
                                                    }
                                                    else { @ResolveRoomName(loc.RoomId) }
                                                </span>
                                                <span class="badge bg-secondary">@loc.Quantity</span>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                            else { <p class="text-muted small">@L["inventory.assetLocationsEmpty", "No other locations for this asset."]</p> }
                        }
                    }
                    else { <div class="text-muted">@L["inventory.selectPrompt", "Select an inventory item"]</div> }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "selectedId")]
    public string? SelectedId { get; set; }

    private List<InventoryDto>? rows;
    private List<AssetDto> assets = new();
    private List<RoomDto> rooms = new();
    private List<WarehouseDto> warehouses = new();
    private List<WarehouseDto> warehouseMatches = new();
    private InventoryDto? selected;
    private WarehouseDto? selectedWarehouse;
    private InventoryEditModel edit = new();
    private string? validationMessage;
    private string warehouseSearch = string.Empty;
    private string inventoryListFilter = string.Empty;
    private bool editingNew;

    private List<InventoryDto> FilteredRows
    {
        get
        {
            if (rows is null) return new();
            if (string.IsNullOrWhiteSpace(inventoryListFilter)) return rows;
            var term = inventoryListFilter.Trim();
            return rows.Where(r =>
                ResolveAssetName(r.AssetId).Contains(term, StringComparison.OrdinalIgnoreCase)
                || ResolveRoomName(r.RoomId).Contains(term, StringComparison.OrdinalIgnoreCase)
                || ResolveWarehouseName(r.WarehouseId).Contains(term, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private string GetAssetName(InventoryDto item) => ResolveAssetName(item.AssetId);
    private string GetLocationName(InventoryDto item) =>
        !string.IsNullOrWhiteSpace(item.WarehouseId) ? ResolveWarehouseName(item.WarehouseId) : ResolveRoomName(item.RoomId);

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();
        await Load();
        ApplySelectedInventoryFromQuery();
    }

    protected override Task OnParametersSetAsync()
    {
        ApplySelectedInventoryFromQuery();
        return Task.CompletedTask;
    }

    private async Task Load() => rows = await InventoryApi.GetInventoryAsync();

    private void ApplySelectedInventoryFromQuery()
    {
        if (rows is null || string.IsNullOrWhiteSpace(SelectedId))
            return;

        var target = rows.FirstOrDefault(r => string.Equals(r.Id, SelectedId, StringComparison.OrdinalIgnoreCase));
        if (target is null)
            return;

        Select(target);
    }

    private async Task LoadLookups()
    {
        assets = await AssetApi.GetAssetsAsync();
        rooms = await RoomApi.GetRoomsAsync();
        warehouses = await WarehouseApi.GetWarehousesAsync();
    }

    private void Select(InventoryDto r)
    {
        validationMessage = null;
        selected = r;
        editingNew = false;
        edit = InventoryEditModel.FromDto(r);
        InitializeWarehouseSelectionForCurrentEdit();
    }

    private void AddNew()
    {
        validationMessage = null;
        selected = null;
        editingNew = true;
        edit = new InventoryEditModel();
        ResetWarehouseSelection();
    }

    private async Task Save()
    {
        validationMessage = null;
        if (selectedWarehouse is not null)
            edit.WarehouseId = selectedWarehouse.Id;

        if (string.IsNullOrWhiteSpace(edit.AssetId))
        {
            validationMessage = L["inventory.validation.assetRequired", "Select an asset."];
            return;
        }

        if (string.IsNullOrWhiteSpace(edit.RoomId) && string.IsNullOrWhiteSpace(edit.WarehouseId))
        {
            validationMessage = L["inventory.validation.locationRequired", "Select a room or a warehouse."];
            return;
        }

        var dto = edit.ToDto();
        if (selected == null) await InventoryApi.CreateInventoryAsync(dto);
        else
        {
            if (!TryResolveSelectedId(out var selectedId))
            {
                return;
            }

            await InventoryApi.UpdateInventoryAsync(selectedId, dto);
        }

        await Load();
    }

    private void OnRoomChanged()
    {
        // Keep warehouse selection when room changes so reassignment can preserve both links.
    }

    private async Task OnWarehouseSearchChanged(ChangeEventArgs args)
    {
        warehouseSearch = args.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(warehouseSearch))
        {
            warehouseMatches.Clear();
            if (selectedWarehouse is null)
                edit.WarehouseId = null;
            return;
        }

        var term = warehouseSearch.Trim();
        warehouseMatches = warehouses
            .Where(w => ContainsWarehouseSearch(w, term))
            .OrderBy(w => w.Name, StringComparer.OrdinalIgnoreCase)
            .ThenBy(w => w.Id, StringComparer.OrdinalIgnoreCase)
            .Take(8)
            .ToList();
        await Task.CompletedTask;
    }

    private void SelectWarehouse(WarehouseDto warehouse)
    {
        selectedWarehouse = warehouse;
        edit.WarehouseId = warehouse.Id;
        warehouseSearch = ResolveWarehouseDisplayName(warehouse);
        warehouseMatches.Clear();
    }

    private void ClearWarehouseSelection()
    {
        selectedWarehouse = null;
        edit.WarehouseId = null;
        warehouseSearch = string.Empty;
        warehouseMatches.Clear();
    }

    private void InitializeWarehouseSelectionForCurrentEdit()
    {
        selectedWarehouse = null;
        warehouseMatches.Clear();
        warehouseSearch = string.Empty;

        if (string.IsNullOrWhiteSpace(edit.WarehouseId))
            return;

        selectedWarehouse = warehouses.FirstOrDefault(w => string.Equals(w.Id, edit.WarehouseId, StringComparison.OrdinalIgnoreCase));
        if (selectedWarehouse is not null)
        {
            warehouseSearch = ResolveWarehouseDisplayName(selectedWarehouse);
            return;
        }

        warehouseSearch = edit.WarehouseId;
    }

    private void ResetWarehouseSelection()
    {
        selectedWarehouse = null;
        warehouseSearch = string.Empty;
        warehouseMatches.Clear();
    }

    private async Task Delete()
    {
        validationMessage = null;
        if (selected == null) return;

        if (!TryResolveSelectedId(out var selectedId))
        {
            return;
        }

        await InventoryApi.DeleteInventoryAsync(selectedId);
        selected = null;
        await Load();
    }

    private bool TryResolveSelectedId(out string selectedId)
    {
        selectedId = string.Empty;
        if (selected == null || string.IsNullOrWhiteSpace(selected.Id))
        {
            validationMessage = L["inventory.validation.missingSelectedId", "Unable to continue: the selected inventory item has no valid ID."];
            return false;
        }

        if (rows?.Any(r => string.Equals(r.Id, selected.Id, StringComparison.Ordinal)) != true)
        {
            validationMessage = L["inventory.validation.itemUnavailable", "The selected inventory item is no longer available. Refresh and try again."];
            return false;
        }

        selectedId = selected.Id;
        return true;
    }

    private string GetInventoryListLabel(InventoryDto item)
    {
        var assetName = ResolveAssetName(item.AssetId);
        var location = !string.IsNullOrWhiteSpace(item.WarehouseId)
            ? ResolveWarehouseName(item.WarehouseId)
            : ResolveRoomName(item.RoomId);

        return string.IsNullOrWhiteSpace(location)
            ? $"{assetName} ({item.Quantity})"
            : $"{assetName} - {location} ({item.Quantity})";
    }

    private string ResolveAssetName(string? id)
    {
        if (string.IsNullOrWhiteSpace(id))
            return L["inventory.none", "None"];

        var asset = assets.FirstOrDefault(a => string.Equals(a.Id, id, StringComparison.Ordinal));
        return asset?.Name ?? id;
    }

    private string ResolveRoomName(string? id)
    {
        if (string.IsNullOrWhiteSpace(id))
            return L["inventory.none", "None"];

        var room = rooms.FirstOrDefault(r => string.Equals(r.Id, id, StringComparison.Ordinal));
        return room?.Name ?? id;
    }

    private string ResolveWarehouseName(string? id)
    {
        if (string.IsNullOrWhiteSpace(id))
            return L["inventory.none", "None"];

        var warehouse = warehouses.FirstOrDefault(w => string.Equals(w.Id, id, StringComparison.Ordinal));
        return warehouse?.Name ?? id;
    }

    private string ResolveWarehouseDisplayName(WarehouseDto warehouse)
    {
        if (!string.IsNullOrWhiteSpace(warehouse.Name))
            return warehouse.Name;
        return warehouse.Id ?? L["inventory.unknownWarehouse", "Unknown warehouse"];
    }

    private static bool ContainsWarehouseSearch(WarehouseDto warehouse, string term)
    {
        return (!string.IsNullOrWhiteSpace(warehouse.Name) && warehouse.Name.Contains(term, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(warehouse.Id) && warehouse.Id.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private List<InventoryDto> GetSameAssetLocations(InventoryDto current)
    {
        if (rows is null || string.IsNullOrWhiteSpace(current.AssetId))
            return new();

        return rows
            .Where(r => string.Equals(r.AssetId, current.AssetId, StringComparison.OrdinalIgnoreCase)
                     && !string.Equals(r.Id, current.Id, StringComparison.OrdinalIgnoreCase))
            .OrderBy(r => ResolveWarehouseName(r.WarehouseId))
            .ThenBy(r => ResolveRoomName(r.RoomId))
            .ToList();
    }

    private void GoToWarehouse(string? warehouseId)
    {
        if (string.IsNullOrWhiteSpace(warehouseId)) return;
        Navigation.NavigateTo($"/warehouses?id={Uri.EscapeDataString(warehouseId)}");
    }

    private class InventoryEditModel
    {
        public string? AssetId { get; set; }
        public string? RoomId { get; set; }
        public string? WarehouseId { get; set; }
        public int Quantity { get; set; } = 0;

        public InventoryDto ToDto() => new(Id: string.Empty, AssetId: AssetId, RoomId: RoomId, WarehouseId: WarehouseId, Quantity: Quantity, MinQuantityDefault: null, RequiredOnCheckin: null, CreatedAt: null);
        public static InventoryEditModel FromDto(InventoryDto d) => new() { AssetId = d.AssetId, RoomId = d.RoomId, WarehouseId = d.WarehouseId, Quantity = d.Quantity };
    }
}


