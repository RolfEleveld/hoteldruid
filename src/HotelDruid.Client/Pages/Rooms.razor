@page "/rooms"
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.RegularExpressions
@using System.Text.Json
@using HotelDruid.Shared
@using TariffServices = HotelDruid.Client.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L
@inject TariffServices.ITariffApiService TariffApi
@inject TariffServices.ITariffAssignmentApiService TariffAssignmentApi
@inject TariffServices.IBookingApiService BookingApi
@implements IAsyncDisposable

<PageTitle>@L["rooms.title", "Top Rooms"]</PageTitle>

<div class="container-fluid rooms-manager">
    <div class="row g-3 h-100">
        <!-- LEFT PANEL: Room List -->
        <div class="col-md-3">
            <div class="panel panel-default h-100 d-flex flex-column">
                <div class="panel-heading">
                    <h3 class="panel-title">@L["rooms.title", "Top Rooms"]</h3>
                </div>
                <div class="panel-body flex-grow-1 overflow-auto">
                    <div class="d-flex gap-2 mb-2">
                        <a class="btn btn-outline-secondary btn-sm flex-grow-1" href="/reports/room-status">@L["reports.rooms.title", "Room status"]</a>
                        <a class="btn btn-outline-secondary btn-sm flex-grow-1" href="/reports/room-board">@L["reports.roomBoard.title", "Room board"]</a>
                    </div>
                    <button class="btn btn-success btn-sm w-100 mb-3" @onclick="AddNewRoom">
                        <span class="bi bi-plus"></span> @L["rooms.add", "Add Room"]
                    </button>

                    @if (rooms == null)
                    {
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">@L["common.loading", "Loading..."]</span>
                        </div>
                    }
                    else if (rooms.Count == 0)
                    {
                        <div class="alert alert-info">@L["rooms.emptyList", "No rooms available"]</div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var room in rooms)
                            {
                                <button type="button"
                                    class="list-group-item list-group-item-action @(selectedRoom?.Id == room.Id ? "active" : "")"
                                    @onclick="() => SelectRoom(room)">
                                    <div class="d-flex justify-content-between">
                                        <span>
                                            @room.Name
                                            @if (ShowsHouseHeadings() && !string.IsNullOrWhiteSpace(room.HouseNumber)) { <small class="text-muted ms-1">@room.HouseNumber</small> }
                                            @if (IsClosedForMaintenance(room.Condition) || MaintenanceTonight(room.Id, room.Name) is not null) { <span class="badge text-bg-warning ms-1">@L["rooms.condition.maintenance", "Maintenance"]</span> }
                                        </span>
                                        <small class="text-muted">@L["rooms.capacityPeople", room.Capacity]</small>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- CENTER PANEL: Room Details Editor -->
        <div class="col-md-5">
            @if (editModel is not null)
            {
                <div class="panel panel-default h-100 d-flex flex-column">
                    <div class="panel-heading">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h3 class="panel-title mb-0">
                                    @if (string.IsNullOrEmpty(editModel.Name))
                                    {
                                        <span>@L["rooms.newRoom", "New Room"]</span>
                                    }
                                    else
                                    {
                                        <span>@editModel.Name</span>
                                    }
                                </h3>
                                <small class="text-muted">@L["rooms.manageRoom", "Manage the room"]</small>
                            </div>
                            <div class="status-badge" title="@statusMessage">
                                @if (isSaving)
                                {
                                    <span class="badge bg-warning"><span class="spinner-border spinner-border-sm me-1"></span>@L["common.saving", "Saving..."]</span>
                                }
                                else if (!string.IsNullOrEmpty(lastError))
                                {
                                    <span class="badge bg-danger" title="@lastError">@L["common.error", "Error"]</span>
                                }
                                else if (!string.IsNullOrEmpty(lastWarning))
                                {
                                    <span class="badge bg-warning" title="@lastWarning">@L["common.warning", "Warning"]</span>
                                }
                                else if (isSaved)
                                {
                                    <span class="badge bg-success">@L["common.saved", "Saved"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">@L["common.unsaved", "Unsaved changes"]</span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(lastError))
                        {
                            <div class="alert alert-danger alert-sm mt-2 mb-0">@lastError</div>
                        }
                        @if (!string.IsNullOrEmpty(lastWarning))
                        {
                            <div class="alert alert-warning alert-sm mt-2 mb-0">@lastWarning</div>
                        }
                    </div>

                    <div class="panel-body flex-grow-1 overflow-auto">
                        <form>
                            <div class="mb-3">
                                <label class="form-label">@L["rooms.nameLabel", "Room name"] <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" @bind="editModel.Name" 
                                    @bind:event="oninput" @onchange="() => OnFieldChanged()" disabled="@(editModel.Id is not null)" />
                                <small class="form-text text-muted">@L["rooms.nameHelp", "Shown to staff and guests. Another building may use the same name."]</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">@L["rooms.capacityLabel", "Capacity"] <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" @bind="editModel.Capacity" 
                                    @bind:event="oninput" @onchange="() => OnFieldChanged()" min="1" />
                                <small class="form-text text-muted">@L["rooms.capacityHelp", "Max occupants"]</small>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@L["rooms.floorNumber", "Floor Number"]</label>
                                    <input type="text" class="form-control" @bind="editModel.FloorNumber" 
                                        @bind:event="oninput" @onchange="() => OnFieldChanged()" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@L["rooms.houseNumber", "House Number"]</label>
                                    <input type="text" class="form-control" @bind="editModel.HouseNumber" 
                                        @bind:event="oninput" @onchange="() => OnFieldChanged()" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@L["rooms.priorityLabel", "Priority"]</label>
                                    <input type="number" class="form-control" @bind="editModel.Priority" 
                                        @bind:event="oninput" @onchange="() => OnFieldChanged()" />
                                    <small class="form-text text-muted">@L["rooms.priorityHelp", "Booking priority (lower = higher)"]</small>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">@L["rooms.secondaryPriorityLabel", "Secondary Priority"]</label>
                                    <input type="number" class="form-control" @bind="editModel.SecondaryPriority" 
                                        @bind:event="oninput" @onchange="() => OnFieldChanged()" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">@L["rooms.hasBedsLabel", "Has Beds"]</label>
                                <select class="form-select" @bind="editModel.HasBeds">
                                    <option value="">@L["rooms.selectOption", "Select..."]</option>
                                    <option value="S">@L["common.yes", "Yes"]</option>
                                    <option value="N">@L["common.no", "No"]</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">@L["rooms.conditionLabel", "Condition"]</label>
                                <select class="form-select" @bind="editModel.Condition" @bind:after="OnFieldChanged">
                                    <option value="">@L["rooms.condition.clean", "Clean"]</option>
                                    <option value="dirty">@L["rooms.condition.dirty", "Dirty"]</option>
                                    <option value="blocked">@L["rooms.condition.blocked", "Blocked"]</option>
                                    <option value="maintenance">@L["rooms.condition.maintenance", "Maintenance"]</option>
                                </select>
                                <small class="form-text text-muted">@L["rooms.conditionHelp", "Occupied and available come from the stays. Use this for the room itself."]</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">@L["rooms.commentsLabel", "Comments"]</label>
                                <textarea class="form-control" @bind="editModel.Comments" 
                                    @bind:event="oninput" @onchange="() => OnFieldChanged()" rows="3"></textarea>
                            </div>

                            @if (editModel.Id is not null)
                            {
                                <div class="room-tariff-section mt-4 pt-3">
                                    <h6 class="mb-1">@L["tariffs.sectionTitle", "Tariffs"]</h6>
                                    <p class="text-muted small">@L["tariffs.sectionHelp", "Check a tariff to activate it for this room. Select a line to see when it applies."]</p>
                                    @if (allTariffs is null)
                                    {
                                        <div class="text-muted small">@L["common.loading", "Loading..."]</div>
                                    }
                                    else if (allTariffs.Count == 0)
                                    {
                                        <div class="alert alert-info">@L["tariffs.emptyList", "No tariffs available"]</div>
                                        <a class="btn btn-outline-secondary btn-sm" href="/tariffs">@L["tariffs.add", "Add Tariff"]</a>
                                    }
                                    else
                                    {
                                        <div class="row g-3">
                                            <div class="col-7">
                                                <div class="list-group">
                                                    @foreach (var tariff in allTariffs)
                                                    {
                                                        var isSelected = string.Equals(tariff.Id, selectedTariffId, StringComparison.OrdinalIgnoreCase);
                                                        <div class="list-group-item list-group-item-action room-tariff-row d-flex align-items-center gap-2 @(isSelected ? "active" : "")"
                                                             @onclick="() => SelectTariffLine(tariff)">
                                                            <input type="checkbox" class="form-check-input m-0"
                                                                   checked="@IsTariffAssignedToRoom(tariff.Id)"
                                                                   @onclick:stopPropagation="true"
                                                                   @onchange="e => ToggleRoomTariff(tariff, (bool)(e.Value ?? false))" />
                                                            <span class="flex-grow-1">
                                                                <span class="d-block">@tariff.Name</span>
                                                                <small class="@(isSelected ? "room-tariff-window" : "text-muted")">@DescribeTariffWindow(tariff)</small>
                                                            </span>
                                                            <span class="small">@tariff.PricePerNight.ToString("0.00")</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-5">
                                                @if (SelectedTariff is null)
                                                {
                                                    <div class="alert alert-light border small mb-0">@L["tariffs.selectLine", "Select a line to see when that tariff applies."]</div>
                                                }
                                                else
                                                {
                                                    <div class="fw-semibold mb-1">@SelectedTariff.Name</div>
                                                    <div class="text-muted small mb-2">@DescribeTariffWindow(SelectedTariff)</div>
                                                    @if (TariffUsesCalendar(SelectedTariff))
                                                    {
                                                        <TariffMiniCalendar @key="SelectedTariff.Id" IsApplicable="IsSelectedTariffDay" />
                                                    }
                                                    else
                                                    {
                                                        <div class="alert alert-light border small mb-0">@L["tariffs.rangeNotByDay", "This tariff is not limited to particular days."]</div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @if (editModel.Id is not null)
                            {
                                var stay = OccupyingBooking();
                                var closure = MaintenanceTonight(editModel.Id, editModel.Name);
                                var closed = IsClosedForMaintenance(editModel.Condition);
                                @if (stay is not null)
                                {
                                    <div class="room-stay mt-4">
                                        <div class="text-muted small mb-1">@L["rooms.occupiedNow", "In this room"]</div>
                                        <a class="list-group-item list-group-item-action" href="@TariffServices.BookingReference.Href(stay.Id)">
                                            <div class="fw-semibold">@StayLabel(stay)</div>
                                            <div class="small text-muted">@StayNights(stay)</div>
                                        </a>
                                    </div>
                                }
                                else if (closure is null && !CanRemoveRoom())
                                {
                                    <p class="text-muted small mt-4 mb-0">@L["rooms.cannotRemove", "This room still has a booking, so it cannot be removed."]</p>
                                }

                                @if (closure is not null)
                                {
                                    <div class="room-stay mt-3">
                                        <div class="text-muted small mb-1">@L["rooms.closedForMaintenance", "Closed for maintenance"]</div>
                                        <a class="list-group-item list-group-item-action" href="@TariffServices.BookingReference.Href(closure.Id)">
                                            <div class="fw-semibold">@StayLabel(closure)</div>
                                            <div class="small text-muted">@StayNights(closure)</div>
                                        </a>
                                    </div>
                                }
                                else if (closed)
                                {
                                    <div class="alert alert-warning mt-3 mb-0">@L["rooms.closedForMaintenance", "Closed for maintenance"]</div>
                                    <button type="button" class="btn btn-outline-secondary btn-sm mt-2" @onclick="ReopenRoom" disabled="@isSaving">
                                        @L["rooms.reopenRoom", "Reopen the room"]
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm mt-3" @onclick="CloseForMaintenance" disabled="@isSaving">
                                        @L["rooms.closeForMaintenance", "Close for maintenance"]
                                    </button>
                                }
                            }
                        </form>
                    </div>

                    <div class="panel-footer">
                        <div class="btn-group w-100" role="group">
                            <button type="button" class="btn btn-primary flex-grow-1" @onclick="SaveRoom" disabled="@isSaving">
                                <span class="bi bi-download"></span> @L["common.save", "Save"]
                            </button>
                            @if (editModel.Id is not null)
                            {
                                <button type="button" class="btn btn-info flex-grow-1" @onclick="DuplicateRoom">
                                    <span class="bi bi-files"></span> @L["rooms.duplicate", "Duplicate"]
                                </button>
                                @if (CanRemoveRoom())
                                {
                                    <button type="button" class="btn btn-danger flex-grow-1" @onclick="DeleteRoom">
                                        <span class="bi bi-trash"></span> @L["common.delete", "Delete"]
                                    </button>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="panel panel-default h-100 d-flex align-items-center justify-content-center">
                    <div class="panel-body text-center text-muted">
                        <p class="mb-2"><span class="bi bi-arrow-left" style="font-size: 2rem;"></span></p>
                        <p>@L["rooms.selectPrompt", "Select a room from the list or add a new one"]</p>
                    </div>
                </div>
            }
        </div>

        <!-- RIGHT PANEL: Neighboring Rooms Matrix -->
        <div class="col-md-4">
            <div class="panel panel-default h-100 d-flex flex-column">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        <span class="bi bi-diagram-2"></span> @L["rooms.neighboringRooms", "Neighboring Rooms"]
                    </h3>
                </div>
                <div class="panel-body flex-grow-1 overflow-auto">
                    @if (rooms is null || rooms.Count == 0)
                    {
                        <div class="alert alert-info">@L["rooms.emptyList", "No rooms available"]</div>
                    }
                    else if (selectedRoom is null || string.IsNullOrWhiteSpace(selectedRoom.Name))
                    {
                        <div class="alert alert-info">@L["rooms.selectForNeighbors"]</div>
                    }
                    else
                    {
                        var current = selectedRoom;
                        var houses = NeighborHouses(current);
                        var showHouses = ShowsHouseHeadings();
                        <div class="neighbor-board">
                            <div>
                                <div class="fw-semibold">@current.Name</div>
                                <div class="text-muted small">@L["rooms.neighborHint"]</div>
                            </div>
                            @foreach (var house in houses)
                            {
                                <div class="neighbor-house">
                                    @if (showHouses && !string.IsNullOrWhiteSpace(house.House))
                                    {
                                        <div class="neighbor-house-label">@L["rooms.house"] @house.House</div>
                                    }
                                    @foreach (var floor in house.Floors)
                                    {
                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(floor.Floor))
                                            {
                                                <div class="neighbor-floor-label">@L["rooms.floor"] @floor.Floor</div>
                                            }
                                            <div class="neighbor-chips">
                                                @foreach (var other in floor.Rooms)
                                                {
                                                    var linked = AreNeighbors(current, other);
                                                    <button type="button"
                                                        class="neighbor-chip @(linked ? "is-linked" : null)"
                                                        aria-pressed="@(linked ? "true" : "false")"
                                                        @onclick="() => UpdateNeighborPair(current, other, !linked)">
                                                        @other.Name
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.rooms-manager {
    height: 100%;
    min-height: 0;
}

.panel {
    border: 1px solid #ddd;
    border-radius: 4px;
    box-shadow: 0 1px 1px rgba(0,0,0,.05);
}

.panel-heading {
    background-color: #f5f5f5;
    border-bottom: 1px solid #ddd;
    padding: 10px 15px;
}

.panel-body {
    padding: 15px;
}

.panel-footer {
    background-color: #f5f5f5;
    border-top: 1px solid #ddd;
    padding: 10px 15px;
}

.status-badge {
    display: flex;
    gap: 5px;
}

.alert-sm {
    padding: 8px 12px;
    margin-bottom: 0;
    font-size: 0.875rem;
}

.neighbor-board {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
}

.neighbor-house {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
}

.neighbor-house-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.15rem;
}

.neighbor-floor-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #6c757d;
    margin-bottom: 0.35rem;
}

.neighbor-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
}

.neighbor-chip {
    border: 1px solid #ced4da;
    background: #fff;
    color: #212529;
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
    min-height: 2rem;
    font-size: 0.875rem;
    line-height: 1.4;
}

.neighbor-chip.is-linked {
    background: #0d6efd;
    border-color: #0d6efd;
    color: #fff;
}

.list-group-item {
    cursor: pointer;
}

.room-tariff-section {
    border-top: 1px solid #ddd;
}

.room-tariff-row.active .room-tariff-window {
    color: inherit;
    opacity: 0.85;
}

.room-tariff-range {
    border-top: 1px solid #ddd;
    margin-top: 1rem;
    padding-top: 1rem;
}

.btn-group > .btn {
    border-radius: 0;
}

.btn-group > .btn:first-child {
    border-radius: 4px 0 0 4px;
}

.btn-group > .btn:last-child {
    border-radius: 0 4px 4px 0;
}
</style>

@code {
    [SupplyParameterFromQuery(Name = "selectedId")]
    public string? SelectedId { get; set; }

    private List<RoomDto>? rooms;
    private List<BookingDto> bookings = new();
    private RoomDto? selectedRoom;
    private RoomEditModel? editModel;
    private bool isSaving = false;
    private bool isSaved = true;
    private string? lastError;
    private string? lastWarning;
    private string statusMessage = string.Empty;
    private System.Timers.Timer? autoSaveTimer;
    private bool hasUnsavedChanges = false;

    // Mutable model for editing room properties
    private class RoomEditModel
    {
        public string? Id { get; set; }
        public string Name { get; set; } = "";
        public int Capacity { get; set; } = 1;
        public string? FloorNumber { get; set; }
        public string? HouseNumber { get; set; }
        public int? Priority { get; set; }
        public int? SecondaryPriority { get; set; }
        public string? HasBeds { get; set; }
        public string? NeighboringRooms { get; set; }
        public string? Comments { get; set; }
        public string? Condition { get; set; }

        public RoomDto ToDto()
        {
            return new RoomDto(Id, Name, Capacity, FloorNumber, HouseNumber, 
                Priority, SecondaryPriority, HasBeds, NeighboringRooms, Comments,
                string.IsNullOrWhiteSpace(Condition) ? null : Condition);
        }

        public static RoomEditModel FromDto(RoomDto dto)
        {
            return new RoomEditModel
            {
                Id = dto.Id,
                Name = dto.Name ?? "",
                Capacity = dto.Capacity,
                FloorNumber = dto.FloorNumber,
                HouseNumber = dto.HouseNumber,
                Priority = dto.Priority,
                SecondaryPriority = dto.SecondaryPriority,
                HasBeds = dto.HasBeds,
                NeighboringRooms = dto.NeighboringRooms,
                Comments = dto.Comments,
                Condition = dto.Condition
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        statusMessage = L["common.noChanges", "No changes"];
        await LoadRooms();
        await LoadBookings();
        await LoadAllTariffs();
        ApplySelectedRoomFromQuery();
        initAutoSaveTimer();
    }

    protected override Task OnParametersSetAsync()
    {
        ApplySelectedRoomFromQuery();
        return Task.CompletedTask;
    }

    private void initAutoSaveTimer()
    {
        autoSaveTimer = new System.Timers.Timer(1500);
        autoSaveTimer.Elapsed += async (s, e) =>
        {
            if (hasUnsavedChanges && selectedRoom != null && !isSaving)
            {
                await SaveRoom();
            }
        };
        autoSaveTimer.AutoReset = false;
    }

    private async Task LoadRooms()
    {
        try
        {
            rooms = (await Http.GetFromJsonAsync<List<RoomDto>>("/api/rooms") ?? new())
                .OrderBy(room => room.Name, NaturalRoomNameComparer.Instance)
                .ThenBy(room => room.Id, StringComparer.OrdinalIgnoreCase)
                .ToList();
            ApplySelectedRoomFromQuery();
        }
        catch (Exception ex)
        {
            lastError = string.Format(L["rooms.loadFailed", "Failed to load rooms: {0}"], ex.Message);
        }
    }

    private async Task LoadBookings()
    {
        bookings = await BookingApi.ListAsync(includeDeleted: true) ?? new List<BookingDto>();
    }

    private static bool IsClosedForMaintenance(string? condition)
        => string.Equals(condition?.Trim(), "maintenance", StringComparison.OrdinalIgnoreCase);

    private bool RoomHasBooking(BookingDto booking)
        => RoomMatches(booking, editModel?.Id, editModel?.Name);

    private static bool RoomMatches(BookingDto booking, string? roomId, string? roomName)
        => (!string.IsNullOrWhiteSpace(roomId) && string.Equals(booking.RoomId, roomId, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrWhiteSpace(roomName) && string.Equals(booking.RoomId, roomName, StringComparison.OrdinalIgnoreCase));

    private bool StillUsesRoom(BookingDto booking)
    {
        var today = HotelDruid.Client.Services.HotelClock.BusinessToday;
        return RoomHasBooking(booking) && (booking.DepartureDate is null || booking.DepartureDate.Value >= today);
    }

    private bool CanRemoveRoom()
        => editModel?.Id is not null && !bookings.Any(StillUsesRoom);

    private BookingDto? OccupyingBooking()
        => CoveringTonight(editModel?.Id, editModel?.Name, maintenance: false);

    private BookingDto? MaintenanceTonight(string? roomId, string? roomName)
        => CoveringTonight(roomId, roomName, maintenance: true);

    private BookingDto? CoveringTonight(string? roomId, string? roomName, bool maintenance)
    {
        var today = HotelDruid.Client.Services.HotelClock.BusinessToday;
        return bookings
            .Where(booking => RoomMatches(booking, roomId, roomName) && CoversTonight(booking, today) && (maintenance ? IsMaintenanceStay(booking) : IsGuestStay(booking)))
            .OrderByDescending(booking => string.Equals(booking.Status, "CheckedIn", StringComparison.OrdinalIgnoreCase))
            .ThenBy(booking => booking.ArrivalDate ?? DateOnly.MaxValue)
            .FirstOrDefault();
    }

    private static bool CoversTonight(BookingDto booking, DateOnly today)
        => booking.ArrivalDate is not null
            && booking.DepartureDate is not null
            && booking.ArrivalDate.Value <= today
            && booking.DepartureDate.Value > today
            && (booking.ActualDepartureDate is null || booking.ActualDepartureDate.Value > today);

    private static bool IsGuestStay(BookingDto booking)
        => IsOpenStay(booking) && !IsMaintenanceStay(booking);

    private static bool IsMaintenanceStay(BookingDto booking)
        => IsOpenStay(booking) && string.Equals(booking.Status?.Trim(), "Maintenance", StringComparison.OrdinalIgnoreCase);

    private static bool IsOpenStay(BookingDto booking)
    {
        if (booking.DeletedAt is not null)
        {
            return false;
        }

        var status = booking.Status?.Trim();
        return status is not null
            && !status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)
            && !status.Equals("Void", StringComparison.OrdinalIgnoreCase)
            && !status.Equals("Deleted", StringComparison.OrdinalIgnoreCase)
            && !status.Equals("NoShow", StringComparison.OrdinalIgnoreCase)
            && !status.Equals("CheckedOut", StringComparison.OrdinalIgnoreCase);
    }

    private string StayLabel(BookingDto booking)
    {
        var label = TariffServices.BookingReference.Label(booking.ArrivalDate, editModel?.Name);
        return string.IsNullOrWhiteSpace(label) ? L["clients.reservationEntry", "Reservation entry"] : label;
    }

    private string StayNights(BookingDto booking)
    {
        if (booking.ArrivalDate is null || booking.DepartureDate is null)
        {
            return string.Empty;
        }

        var nights = booking.DepartureDate.Value.DayNumber - booking.ArrivalDate.Value.DayNumber;
        if (nights <= 0)
        {
            return string.Empty;
        }

        return nights == 1
            ? L["clients.reservationDay", nights]
            : L["clients.reservationNights", nights];
    }

