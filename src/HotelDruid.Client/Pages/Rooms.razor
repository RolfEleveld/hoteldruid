    private static bool TariffUsesCalendar(TariffServices.TariffDto tariff)
        => tariff.ApplicabilityMode is "AnyDay" or "Weekdays";

    private bool IsSelectedTariffDay(DateOnly day)
    {
        var tariff = SelectedTariff;
        if (tariff is null || !tariff.IsActive)
        {
            return false;
        }

        if (tariff.ApplicabilityMode == "AnyDay")
        {
            return true;
        }

        if (tariff.ApplicabilityMode != "Weekdays")
        {
            return false;
        }

        var bit = day.DayOfWeek switch
        {
            DayOfWeek.Monday => 1,
            DayOfWeek.Tuesday => 2,
            DayOfWeek.Wednesday => 4,
            DayOfWeek.Thursday => 8,
            DayOfWeek.Friday => 16,
            DayOfWeek.Saturday => 32,
            DayOfWeek.Sunday => 64,
            _ => 0
        };
        return ((tariff.WeekdaysMask ?? 0) & bit) != 0;
    }

    private static readonly (DayOfWeek Day, int Bit)[] WeekdayBits =
    [
        (DayOfWeek.Monday, 1),
        (DayOfWeek.Tuesday, 2),
        (DayOfWeek.Wednesday, 4),
        (DayOfWeek.Thursday, 8),
        (DayOfWeek.Friday, 16),
        (DayOfWeek.Saturday, 32),
        (DayOfWeek.Sunday, 64)
    ];

    private string DescribeTariffWindow(TariffServices.TariffDto tariff)
    {
        if (!tariff.IsActive)
        {
            return L["tariffs.windowInactive", "Inactive"];
        }

        return tariff.ApplicabilityMode switch
        {
            "Weekdays" => L["tariffs.windowWeekdays", FormatWeekdays(tariff.WeekdaysMask ?? 0)],
            "MinStay" => L["tariffs.windowMinStay", tariff.MinNights ?? 0],
            "MinGuests" => L["tariffs.windowMinGuests", tariff.MinGuestCount ?? 0],
            _ => L["tariffs.windowAnyDay", "Every day"]
        };
    }

    private static string FormatWeekdays(int mask)
    {
        var names = WeekdayBits
            .Where(day => (mask & day.Bit) != 0)
            .Select(day => CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedDayName(day.Day));
        return string.Join(", ", names);
    }

